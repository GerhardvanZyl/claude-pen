{"nodes": [{"id": "user__claude_agents_sidekick_heavy_sidekick_heavy", "label": "sidekick-heavy implementation worker", "file_type": "document", "source_file": "user/.claude/agents/sidekick-heavy.md", "source_location": "frontmatter name: sidekick-heavy (model opus, effort xhigh, maxTurns 80, memory project)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user__claude_agents_sidekick_heavy_verify_the_driving_constraint", "label": "Verify the constraint that drove the escalation", "file_type": "rationale", "source_file": "user/.claude/agents/sidekick-heavy.md", "source_location": "lines 30-37, 48-55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The escalation buys reasoning for one specific constraint, so that constraint must be identified and verified deliberately \u2014 by test, argument, or measurement, with the method named \u2014 rather than assumed satisfied. On a retry the previous attempt's diff is read first to understand why it failed. Depth goes into the code and the verification, not the write-up."}, {"id": "user__claude_agents_sidekick_heavy_push_back_but_do_not_expand_scope", "label": "Push back on the brief, but do not expand scope", "file_type": "rationale", "source_file": "user/.claude/agents/sidekick-heavy.md", "source_location": "lines 39-46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If a constraint is unsatisfiable, two constraints conflict, or the brief's implied approach is the reason it is hard, stopping with the specific argument is worth more than a compliant implementation that quietly violates something. Pushing back is explicitly not the same as redesigning unprompted."}], "edges": [{"source": "user__claude_agents_sidekick_heavy_sidekick_heavy", "target": "user__claude_skills_solution_architecture_skill_solution_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0