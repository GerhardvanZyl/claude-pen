{"nodes": [{"id": "user__claude_agents_reviewer_ultra_defence_reviewer_ultra_defence", "label": "reviewer-ultra-defence", "file_type": "document", "source_file": "user/.claude/agents/reviewer-ultra-defence.md", "source_location": "frontmatter name: reviewer-ultra-defence (model sonnet, effort high)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user__claude_agents_reviewer_ultra_defence_precision_optimised_review", "label": "Precision-optimised review posture", "file_type": "concept", "source_file": "user/.claude/agents/reviewer-ultra-defence.md", "source_location": "lines 45-75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assume the change is correct and the author knew what they were doing; raise only what can be demonstrated by pointing at the line and stating the trigger. Try to explain the code before condemning it \u2014 look for the caller that already validates or the invariant held elsewhere \u2014 and prefer the narrower claim. The counterpart already covers recall, and duplicating that leaves nobody covering precision, collapsing the pair into two reviewers with the same blind spots. The trap: precision is not agreeableness \u2014 waving everything through fails more dangerously than flagging everything, because the adjudicator reads silence as evidence of correctness."}, {"id": "user__claude_agents_reviewer_ultra_defence_log_over_findings", "label": "The defence log matters more than its findings", "file_type": "rationale", "source_file": "user/.claude/agents/reviewer-ultra-defence.md", "source_location": "lines 91-97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The log must record what was examined and concluded fine and the reason it is correct, not merely that it was looked at. When the adjudicator sees a prosecution finding defence did not raise, the log is the only thing distinguishing 'considered and dismissed' from 'never reached' \u2014 and those lead to opposite adjudications. An empty findings array is normal for defence; a sparse log is not."}, {"id": "user__claude_agents_reviewer_ultra_defence_never_remove_invariant_guards", "label": "Never recommend removing a security control or invariant guard unattributed", "file_type": "rationale", "source_file": "user/.claude/agents/reviewer-ultra-defence.md", "source_location": "lines 82-83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A reviewer may not recommend removing a permission check, security control, idempotency guard, or lock ordering without stating what else establishes that invariant \u2014 the burden is on the remover to name the replacement."}, {"id": "user__claude_skills_dev_loop_ultra_opus_skill_dev_loop_ultra_opus", "label": "dev-loop-ultra-opus skill", "file_type": "document", "source_file": "user/.claude/agents/reviewer-ultra-defence.md", "source_location": "referenced as an alternate spawner with the model passed per invocation", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "user__claude_agents_reviewer_ultra_defence_reviewer_ultra_defence", "target": "user__claude_skills_dev_loop_ultra_skill_dev_loop_ultra", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user/.claude/agents/reviewer-ultra-defence.md", "source_location": "description lines 3-8", "weight": 1.0}, {"source": "user__claude_agents_reviewer_ultra_defence_reviewer_ultra_defence", "target": "user__claude_skills_dev_loop_ultra_opus_skill_dev_loop_ultra_opus", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user/.claude/agents/reviewer-ultra-defence.md", "source_location": "description lines 7-8", "weight": 1.0}, {"source": "user__claude_agents_reviewer_ultra_defence_reviewer_ultra_defence", "target": "user__claude_skills_solution_architecture_skill_solu