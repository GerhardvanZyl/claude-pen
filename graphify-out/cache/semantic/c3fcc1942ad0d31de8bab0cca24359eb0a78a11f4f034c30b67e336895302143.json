{"nodes": [{"id": "user__claude_agents_reviewer_architecture_reviewer_architecture", "label": "reviewer-architecture lane", "file_type": "document", "source_file": "user/.claude/agents/reviewer-architecture.md", "source_location": "frontmatter name: reviewer-architecture (model opus, effort xhigh)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user__claude_agents_reviewer_architecture_lane_ownership_boundary", "label": "One owner per concern (lane ownership boundary)", "file_type": "rationale", "source_file": "user/.claude/agents/reviewer-architecture.md", "source_location": "lines 55-57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lane raises only what its own card owns and stays silent on things it notices that belong to other lanes, because duplicate findings cost the lead triage time and dilute the single-owner guarantee that makes the lane set coverable."}, {"id": "user__claude_agents_reviewer_architecture_empty_findings_is_valid", "label": "An empty findings array is a correct result", "file_type": "rationale", "source_file": "user/.claude/agents/reviewer-architecture.md", "source_location": "lines 63-64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Padding is forbidden because a lane that always finds something gets ignored, and a permanently ignored lane is worse than one that occasionally misses a finding."}, {"id": "user__claude_agents_reviewer_architecture_evidence_and_cause_honesty", "label": "Evidence and cause honesty", "file_type": "rationale", "source_file": "user/.claude/agents/reviewer-architecture.md", "source_location": "lines 50-62", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`evidence` records what was actually seen and `cause` records whether the diff introduced it; `direct` is never marked for something reasoned to but not pointed at, inferred evidence alone can never block, and `stale` findings are recorded rather than fixed. Triage weights these fields and cannot re-derive them."}, {"id": "user__claude_agents_reviewer_architecture_architecture_in_force", "label": "Establish the architecture in force before judging", "file_type": "rationale", "source_file": "user/.claude/agents/reviewer-architecture.md", "source_location": "lines 42-50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run the tier procedure \u2014 discovered documents, then the project reference graph, then convention inferred from three or more existing examples \u2014 and set `evidence` from the tier reached, so that a convention merely inferred can never block. Then ask, per changed type, what single kind of work it owns and whether the diff gave it a second one."}, {"id": "user__claude_agents_reviewer_architecture_conventions_ledger", "label": ".claude/review/conventions.md accepted-deviation ledger", "file_type": "concept", "source_file": "user/.claude/agents/reviewer-architecture.md", "source_location": "lines 46-48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deviations already examined and deliberately accepted are recorded here; anything in it is an accepted decision and never a finding, so reviewers read it before judging placement."}, {"id": "user__claude_agents_reviewer_architecture_read_only_enforcement", "label": "Read-only reviewer enforcement via disallowedTools", "file_type": "concept", "source_file": "user/.claude/agents/reviewer-architecture.md", "source_location": "frontmatter disallowedTools block, lines 11-31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every review lane denies Edit, NotebookEdit, and the mutating shell and git commands (rm, mv, cp, sed, tee, truncate, git add/commit/push/checkout/restore/reset/revert/clean/stash/rebase/merge/worktree), so a reviewer can write only its findings and log files."}, {"id": "user__claude_skills_dev_loop_skill_dev_loop", "label": "dev-loop skill", "file_type": "document", "source_file": "user/.claude/agents/reviewer-architecture.md", "source_location": "referenced as the spawning skill and the owner of the findings/log formats", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user__claude_skills_dev_loop_references_review_lanes_review_lanes", "label": "review-lanes.md lane cards", "file_type": "document", "source_file": "user/.claude/agents/reviewer-architecture.md", "source_location": "referenced as references/review-lanes.md; each lane reads only its own ## section", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "user__claude_skills_solution_architecture_skill_solution_architecture", "label": "solution-architecture skill", "file_type": "document", "source_file": "user/.claude/agents/reviewer-architecture.md", "source_location": "frontmatter skills: solution-architecture; the tier procedure it defines", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "user__claude_agents_reviewer_architecture_reviewer_architecture", "target": "user__claude_skills_dev_loop_references_review_lanes_review_lanes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user/.claude/agents/reviewer-architecture.md", "source_location": "line 38", "weight": 1.0}, {"source": "user__claude_agents_reviewer_architecture_reviewer_architecture", "target": "user__claude_skills_dev_loop_skill_dev_loop", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "user/.claude/agents/reviewer-architecture.md", "source_location": "description; lines 51-52", "weight": 1.0}, {"source": "user__claude_agents_reviewer_architecture_reviewer_architecture", "target": "user__claude_skills_solution_architecture_skill_solution_architecture", "relati