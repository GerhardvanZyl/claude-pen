<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dev-loop-ultra-opus">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="1978" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" value="dev-loop-ultra-opus &#8212; adversarial, every subagent on Opus" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Structurally identical to dev-loop-ultra. It changes exactly two things: the model on every agent, and the concurrency. Roughly 4&#215; the review cost of a full run, and 2.7&#215; the run as a whole &#8212; the most expensive loop available." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="44" as="geometry" /></mxCell>
        <mxCell id="entry" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;/dev-loop-ultra-opus&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="base" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Follow the dev-loop-ultra skill in full.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Every phase, bound, format and rule is the same &#8212; Phase 0's&lt;br&gt;implementation-notes and Phase 8b's walkthrough included.&lt;br&gt;&lt;b&gt;Read dev-loop-ultra/SKILL.md and work from it.&lt;/b&gt;&lt;br&gt;&lt;b&gt;Do not reimplement its phases from this file.&lt;/b&gt;&lt;br&gt;Frame &#8594; implement &#8594; test &#8594; plan + snapshot &#8594; nine lanes, each as&lt;br&gt;prosecution &#124; defence &#8594; adjudicator &#8594; triage &#8594; fix &#8594; loop (3 rounds)&lt;br&gt;&#8594; verify &#8594; walkthrough &#8594; commit, push, PR&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="185" as="geometry" /></mxCell>
        <mxCell id="baseN" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;This file changes two things and nothing else.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Everything below is a delta on the ultra loop, not&lt;br&gt;a loop in its own right. If you find yourself&lt;br&gt;restating an ultra phase here, stop and go read it.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="313" width="380" height="90" as="geometry" /></mxCell>
        <mxCell id="c1" value="Change 1 &#8212; every subagent runs on Opus, review lanes and implementation alike" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="513" width="1500" height="438" as="geometry" /></mxCell>
        <mxCell id="c1h0" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Agent&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;align=center;" vertex="1" parent="c1"><mxGeometry x="20" y="44" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1h1" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Model&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;align=center;" vertex="1" parent="c1"><mxGeometry x="504" y="44" width="320" height="30" as="geometry" /></mxCell>
        <mxCell id="c1h2" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Effort &#8212; and where it comes from&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;align=center;" vertex="1" parent="c1"><mxGeometry x="848" y="44" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1a0" value="&lt;div style=&quot;font-size:11px;text-align:left;padding-left:8px&quot;&gt;reviewer-ultra-prosecution&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="20" y="74" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1m0" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;opus &#8212; &lt;b&gt;passed&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="504" y="74" width="320" height="30" as="geometry" /></mxCell>
        <mxCell id="c1e0" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;high &#8212; declared in the agent file&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="848" y="74" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1a1" value="&lt;div style=&quot;font-size:11px;text-align:left;padding-left:8px&quot;&gt;reviewer-ultra-defence&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="20" y="104" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1m1" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;opus &#8212; &lt;b&gt;passed&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="504" y="104" width="320" height="30" as="geometry" /></mxCell>
        <mxCell id="c1e1" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;high &#8212; declared in the agent file&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="848" y="104" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1a2" value="&lt;div style=&quot;font-size:11px;text-align:left;padding-left:8px&quot;&gt;reviewer-ultra-adjudicator&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="20" y="134" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1m2" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;opus &#8212; &lt;b&gt;passed&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="504" y="134" width="320" height="30" as="geometry" /></mxCell>
        <mxCell id="c1e2" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;high &#8212; declared in the agent file&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="848" y="134" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1a3" value="&lt;div style=&quot;font-size:11px;text-align:left;padding-left:8px&quot;&gt;reviewer-verify&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="20" y="164" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1m3" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;opus &#8212; its own default&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="504" y="164" width="320" height="30" as="geometry" /></mxCell>
        <mxCell id="c1e3" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;high &#8212; declared in the agent file&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="848" y="164" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1a4" value="&lt;div style=&quot;font-size:11px;text-align:left;padding-left:8px&quot;&gt;Implementation sidekick&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="20" y="194" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1m4" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;&lt;b&gt;sidekick-heavy&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="504" y="194" width="320" height="30" as="geometry" /></mxCell>
        <mxCell id="c1e4" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;&lt;b&gt;xhigh&lt;/b&gt; &#8212; declared in that agent file&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="848" y="194" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1a5" value="&lt;div style=&quot;font-size:11px;text-align:left;padding-left:8px&quot;&gt;Test-writing sidekick&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="20" y="224" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1m5" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;&lt;b&gt;sidekick-heavy&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="504" y="224" width="320" height="30" as="geometry" /></mxCell>
        <mxCell id="c1e5" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;&lt;b&gt;xhigh&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="848" y="224" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1a6" value="&lt;div style=&quot;font-size:11px;text-align:left;padding-left:8px&quot;&gt;Fix sidekick&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="20" y="254" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1m6" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;&lt;b&gt;sidekick-heavy&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="504" y="254" width="320" height="30" as="geometry" /></mxCell>
        <mxCell id="c1e6" value="&lt;div style=&quot;font-size:11px;text-align:center&quot;&gt;&lt;b&gt;xhigh&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="848" y="254" width="460" height="30" as="geometry" /></mxCell>
        <mxCell id="c1n" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;The lane table in dev-loop-ultra is superseded&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;in one respect only: no lane drops to Sonnet.&lt;/b&gt; Every reviewer runs on Opus.&lt;br&gt;&lt;b&gt;Implementation is on Opus here too&lt;/b&gt;, unlike every other loop &#8212; if you are paying for adversarial review at this tier, having the code written a tier below the reviewers is a false economy.&lt;br&gt;&lt;b&gt;If you cannot pass a model per invocation, stop and say so.&lt;/b&gt; Running silently at default tiers gives the user the cost profile they did not ask for and the scrutiny they did.&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c1"><mxGeometry x="20" y="288" width="1460" height="130" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="base"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="base" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="effort" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Effort is NOT raised, because it cannot be passed.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;The Agent tool has a &lt;b&gt;model&lt;/b&gt; parameter and no &lt;b&gt;effort&lt;/b&gt; parameter, so a lane's&lt;br&gt;effort is whatever its agent file declares &#8212; &lt;b&gt;high&lt;/b&gt; for all three ultra reviewers.&lt;br&gt;&lt;b&gt;This loop buys a uniformly higher model tier, not a higher effort tier.&lt;/b&gt;&lt;br&gt;Say that in run.md rather than reporting xhigh lanes the run did not have.&lt;br&gt;The sidekicks are the exception, and not by accident: &lt;b&gt;sidekick-heavy is a distinct&lt;/b&gt;&lt;br&gt;&lt;b&gt;agent file that declares effort: xhigh itself&lt;/b&gt;, so routing to it gets you both.&lt;br&gt;That is the pattern to follow if xhigh reviewers are ever wanted &#8212; dedicated&lt;br&gt;agent files, not a parameter that does not exist.&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="1001" width="900" height="175" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="effort"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c2" value="Change 2 &#8212; concurrency drops to one lane at a time" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1226" width="1500" height="154" as="geometry" /></mxCell>
        <mxCell id="c2u" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;dev-loop-ultra&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;two lanes at a time&lt;br&gt;four reviewers in flight&lt;br&gt;then the two adjudicators&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c2"><mxGeometry x="40" y="50" width="440" height="90" as="geometry" /></mxCell>
        <mxCell id="c2o" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;dev-loop-ultra-opus&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;ONE lane at a time&lt;/b&gt;&lt;br&gt;prosecution and defence in parallel,&lt;br&gt;then that lane's adjudicator,&lt;br&gt;then the next lane&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c2"><mxGeometry x="520" y="50" width="440" height="90" as="geometry" /></mxCell>
        <mxCell id="c2n" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Two Opus reviewers plus an adjudicator is already a heavy concurrent load.&lt;br&gt;&lt;b&gt;This makes ultra-opus considerably slower in wall-clock than dev-loop-ultra.&lt;/b&gt;&lt;br&gt;&lt;b&gt;That is the trade being made; do not widen the concurrency to recover it.&lt;/b&gt;&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="c2"><mxGeometry x="1000" y="50" width="460" height="90" as="geometry" /></mxCell>
        <mxCell id="e6" value="becomes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="c2" source="c2u" target="c2o"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="effort" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="just" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;When this loop is justified&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;dev-loop-ultra already covers changes where a missed defect is expensive.&lt;br&gt;Reach past it to this one &lt;b&gt;only when the cost of being wrong is severe and&lt;/b&gt;&lt;br&gt;&lt;b&gt;largely irreversible&lt;/b&gt;:&lt;br&gt;&#8226; a migration that alters or destroys production data&lt;br&gt;&#8226; auth or tenant-isolation logic where a defect exposes other people's data&lt;br&gt;&#8226; money movement, settlement, or anything with a regulatory consequence&lt;br&gt;&#8226; a contract other organisations build against and cannot easily be asked to change&lt;br&gt;&#8226; code being handed to someone who will not be able to fix it&lt;br&gt;&lt;b&gt;For anything less, dev-loop-ultra is the honest choice, and dev-loop is the&lt;/b&gt;&lt;br&gt;&lt;b&gt;honest default. Escalating past the point where the loop changes the&lt;/b&gt;&lt;br&gt;&lt;b&gt;outcome is spending, not diligence.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="1440" width="900" height="220" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="just"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="idx" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Index line: loop:&quot;ultra-opus&quot;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Keep the same per-lane &lt;b&gt;raised_p / raised_d / kept&lt;/b&gt; counts and the same&lt;br&gt;&lt;b&gt;walkthrough&lt;/b&gt; field as every other loop.&lt;br&gt;Comparing those against ultra runs is how you find out whether the Opus&lt;br&gt;lanes actually change the findings &lt;b&gt;or only the bill&lt;/b&gt;.&lt;br&gt;That is worth knowing, and nobody can tell you without the data.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="1715" width="900" height="130" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="just" target="idx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="done" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="750" y="1900" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="idx" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
