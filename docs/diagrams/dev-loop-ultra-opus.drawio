<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dev-loop-ultra-opus">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="/dev-loop-ultra-opus" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="base" value="&lt;b&gt;Follow the dev-loop-ultra skill in full.&lt;/b&gt;&#xa;Every phase, bound, format and rule is the same &#8212; Phase 0's&#xa;implementation-notes and Phase 8b's walkthrough included.&#xa;&lt;b&gt;Read dev-loop-ultra/SKILL.md and work from it.&lt;/b&gt;&#xa;&lt;b&gt;Do not reimplement its phases from this file.&lt;/b&gt;&#xa;&#xa;Frame &#8594; implement &#8594; test &#8594; plan + snapshot &#8594; nine lanes, each as&#xa;prosecution &#124; defence &#8594; adjudicator &#8594; triage &#8594; fix &#8594; loop (3 rounds)&#xa;&#8594; verify &#8594; walkthrough &#8594; commit, push, PR" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="185" as="geometry" /></mxCell>
        <mxCell id="baseN" value="&lt;b&gt;This file changes two things and nothing else.&lt;/b&gt;&#xa;Everything below is a delta on the ultra loop, not&#xa;a loop in its own right. If you find yourself&#xa;restating an ultra phase here, stop and go read it." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="315" width="440" height="90" as="geometry" /></mxCell>
        <mxCell id="effort" value="&lt;b&gt;Effort is NOT raised, because it cannot be passed.&lt;/b&gt;&#xa;The Agent tool has a &lt;b&gt;model&lt;/b&gt; parameter and no &lt;b&gt;effort&lt;/b&gt; parameter, so a lane's&#xa;effort is whatever its agent file declares &#8212; &lt;b&gt;high&lt;/b&gt; for all three ultra reviewers.&#xa;&lt;b&gt;This loop buys a uniformly higher model tier, not a higher effort tier.&lt;/b&gt;&#xa;Say that in run.md rather than reporting xhigh lanes the run did not have.&#xa;The sidekicks are the exception, and not by accident: &lt;b&gt;sidekick-heavy is a distinct&lt;/b&gt;&#xa;&lt;b&gt;agent file that declares effort: xhigh itself&lt;/b&gt;, so routing to it gets you both.&#xa;That is the pattern to follow if xhigh reviewers are ever wanted &#8212; dedicated&#xa;agent files, not a parameter that does not exist." style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="893" width="700" height="170" as="geometry" /></mxCell>
        <mxCell id="just" value="&lt;b&gt;When this loop is justified&lt;/b&gt;&#xa;dev-loop-ultra already covers changes where a missed defect is expensive.&#xa;Reach past it to this one &lt;b&gt;only when the cost of being wrong is severe and&lt;/b&gt;&#xa;&lt;b&gt;largely irreversible&lt;/b&gt;:&#xa;&#8226; a migration that alters or destroys production data&#xa;&#8226; auth or tenant-isolation logic where a defect exposes other people's data&#xa;&#8226; money movement, settlement, or anything with a regulatory consequence&#xa;&#8226; a contract other organisations build against and cannot easily be asked to change&#xa;&#8226; code being handed to someone who will not be able to fix it&#xa;&#xa;&lt;b&gt;For anything less, dev-loop-ultra is the honest choice, and dev-loop is the&lt;/b&gt;&#xa;&lt;b&gt;honest default. Escalating past the point where the loop changes the&lt;/b&gt;&#xa;&lt;b&gt;outcome is spending, not diligence.&lt;/b&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="1373" width="760" height="210" as="geometry" /></mxCell>
        <mxCell id="idx" value="&lt;b&gt;Index line: loop:&quot;ultra-opus&quot;&lt;/b&gt;&#xa;Keep the same per-lane &lt;b&gt;raised_p / raised_d / kept&lt;/b&gt; counts and the same&#xa;&lt;b&gt;walkthrough&lt;/b&gt; field as every other loop.&#xa;Comparing those against ultra runs is how you find out whether the Opus&#xa;lanes actually change the findings &lt;b&gt;or only the bill&lt;/b&gt;.&#xa;That is worth knowing, and nobody can tell you without the data." style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="1643" width="700" height="130" as="geometry" /></mxCell>
        <mxCell id="done" value="done" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="1833" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="c1" value="Change 1 &#8212; every subagent runs on Opus, review lanes and implementation alike" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="513" width="1500" height="320" as="geometry" /></mxCell>
        <mxCell id="c2" value="Change 2 &#8212; concurrency drops to one lane at a time" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1123" width="1500" height="190" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-ultra-opus &#8212; adversarial, every subagent on Opus" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Structurally identical to dev-loop-ultra. It changes exactly two things: the model on every agent, and the concurrency. Roughly 8&#215; a full run &#8212; the most expensive loop available." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="c1h0" value="Agent" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=10;fillColor=#0f3355;fontColor=#ffffff;" vertex="1" parent="c1"><mxGeometry x="20" y="42" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1h1" value="Model" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=10;fillColor=#0f3355;fontColor=#ffffff;" vertex="1" parent="c1"><mxGeometry x="444" y="42" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1h2" value="Effort &#8212; and where it comes from" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=10;fillColor=#0f3355;fontColor=#ffffff;" vertex="1" parent="c1"><mxGeometry x="748" y="42" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a0" value="reviewer-ultra-prosecution" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="20" y="72" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m0" value="opus &#8212; &lt;b&gt;passed&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="444" y="72" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e0" value="high &#8212; declared in the agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="748" y="72" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a1" value="reviewer-ultra-defence" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="20" y="102" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m1" value="opus &#8212; &lt;b&gt;passed&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="444" y="102" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e1" value="high &#8212; declared in the agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="748" y="102" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a2" value="reviewer-ultra-adjudicator" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="20" y="132" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m2" value="opus &#8212; &lt;b&gt;passed&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="444" y="132" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e2" value="high &#8212; declared in the agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="748" y="132" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a3" value="reviewer-verify" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#dcefe3;" vertex="1" parent="c1"><mxGeometry x="20" y="162" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m3" value="opus &#8212; its own default" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#dcefe3;" vertex="1" parent="c1"><mxGeometry x="444" y="162" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e3" value="high &#8212; declared in the agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#dcefe3;" vertex="1" parent="c1"><mxGeometry x="748" y="162" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a4" value="Implementation sidekick" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="20" y="192" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m4" value="&lt;b&gt;sidekick-heavy&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="444" y="192" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e4" value="&lt;b&gt;xhigh&lt;/b&gt; &#8212; declared in that agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="748" y="192" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a5" value="Test-writing sidekick" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="20" y="222" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m5" value="&lt;b&gt;sidekick-heavy&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="444" y="222" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e5" value="&lt;b&gt;xhigh&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="748" y="222" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a6" value="Fix sidekick" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="20" y="252" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m6" value="&lt;b&gt;sidekick-heavy&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="444" y="252" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e6" value="&lt;b&gt;xhigh&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="748" y="252" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1n" value="&lt;b&gt;The lane table in dev-loop-ultra is superseded&lt;/b&gt;&#xa;&lt;b&gt;in one respect only: no lane drops to Sonnet.&lt;/b&gt;&#xa;Every reviewer runs on Opus.&#xa;&#xa;&lt;b&gt;Implementation is on Opus here too&lt;/b&gt;, unlike every&#xa;other loop. If you are paying for adversarial review&#xa;at this tier, having the code written a tier below&#xa;the reviewers is a false economy.&#xa;&#xa;&lt;b&gt;If you cannot pass a model per invocation, stop&lt;/b&gt;&#xa;&lt;b&gt;and say so.&lt;/b&gt; Running silently at default tiers gives&#xa;the user the cost profile they did not ask for and&#xa;the scrutiny they did." style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="c1"><mxGeometry x="1180" y="42" width="300" height="240" as="geometry" /></mxCell>
        <mxCell id="c2u" value="&lt;b&gt;dev-loop-ultra&lt;/b&gt;&#xa;two lanes at a time&#xa;four reviewers in flight&#xa;then the two adjudicators" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;" vertex="1" parent="c2"><mxGeometry x="40" y="50" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="c2o" value="&lt;b&gt;dev-loop-ultra-opus&lt;/b&gt;&#xa;&lt;b&gt;ONE lane at a time&lt;/b&gt;&#xa;prosecution and defence in parallel,&#xa;then that lane's adjudicator,&#xa;then the next lane" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;" vertex="1" parent="c2"><mxGeometry x="520" y="50" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="c2n" value="Two Opus reviewers plus an adjudicator is&#xa;already a heavy concurrent load.&#xa;&lt;b&gt;This makes ultra-opus considerably slower in&lt;/b&gt;&#xa;&lt;b&gt;wall-clock than dev-loop-ultra. That is the trade&lt;/b&gt;&#xa;&lt;b&gt;being made; do not widen the concurrency to&lt;/b&gt;&#xa;&lt;b&gt;recover it.&lt;/b&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="c2"><mxGeometry x="1000" y="50" width="460" height="90" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="base"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="c2" target="just"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="just" target="idx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="idx" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="base" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="effort"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="effort" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="becomes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2u" target="c2o"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
