      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;/dev-loop-ultra&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="why" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Why three agents per lane&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;A single reviewer has &lt;b&gt;one error profile&lt;/b&gt;: whatever it is disposed&lt;br&gt;to miss, it misses consistently, and running it again changes nothing.&lt;br&gt;Two reviewers on &lt;b&gt;opposed assumptions&lt;/b&gt; have different profiles.&lt;br&gt;&lt;b&gt;Their disagreements are where the information is&lt;/b&gt; &#8212; and extracting&lt;br&gt;it, by checking the code itself, is the adjudicator's whole job.&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="278" width="420" height="140" as="geometry" /></mxCell>
        <mxCell id="whenL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Use ultra when a missed defect is expensive&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;rather than merely annoying:&lt;/b&gt;&lt;br&gt;&#8226; payment, billing, anything moving money or goods&lt;br&gt;&#8226; auth, permissions, tenant or user data isolation&lt;br&gt;&#8226; migrations that alter or destroy existing data&lt;br&gt;&#8226; integration contracts other systems depend on&lt;br&gt;&#8226; anything where rollback is slow or costly&lt;br&gt;&#8226; code you are handing over and will not maintain&lt;br&gt;&lt;b&gt;Ultra applied everywhere is not thoroughness, it is expense.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="268" width="440" height="160" as="geometry" /></mxCell>
        <mxCell id="p02" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phases 0&#8211;2 &#8212; Frame, implement, test&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; identical to dev-loop&lt;br&gt;frame the slice, record the source branch, write brief.md,&lt;br&gt;invoke implementation-notes &#8594; notes.md, then implement and&lt;br&gt;test in &lt;b&gt;two handoffs at the normal sidekick tiers&lt;/b&gt;&lt;br&gt;both briefs ask the decisions and rejected alternatives back&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="488" width="420" height="125" as="geometry" /></mxCell>
        <mxCell id="p02N" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Implementation is not changed by this loop.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Ultra buys scrutiny of the code, not better code.&lt;br&gt;If you want the implementation raised too, that is&lt;br&gt;what dev-loop-ultra-opus is for.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="510" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 3 &#8212; Plan the round&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; ROUND = N&lt;br&gt;same applicability table as dev-loop &#8594; round-N/plan.md&lt;br&gt;snapshot the tree &#8594; plan.md  tree: &amp;lt;sha&amp;gt;&lt;br&gt;scratch worktree at round-N/scratch for the Tests pair&lt;br&gt;&lt;b&gt;retake and compare after each PAIR of lanes drains,&lt;/b&gt;&lt;br&gt;&lt;b&gt;not only at the end of the round&lt;/b&gt; &#8212; with eighteen-plus&lt;br&gt;agent runs against one tree, finding out at the end that it&lt;br&gt;moved means rerunning far more than one lane&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="673" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 4 &#8212; Adversarial review&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;for each applicable lane, three agents in sequence&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="893" width="420" height="70" as="geometry" /></mxCell>
        <mxCell id="conc" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Concurrency: two lanes at a time, four reviewers in flight&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;both reviewers for two lanes &#8594; drain &#8594; those two adjudicators&lt;br&gt;&#8594; the next pair. Nine lanes at once would put eighteen agents&lt;br&gt;in flight and hit concurrency limits long before it saved wall-clock.&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="1678" width="560" height="100" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 5 &#8212; Triage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; identical to dev-loop&lt;br&gt;cluster by locator, gate on evidence and cause, separate&lt;br&gt;defect from remedy, check wontfix.json, record durable&lt;br&gt;decisions in conventions.md, write round-N/triage.md&lt;br&gt;&lt;b&gt;One addition: read each lane's coverage line.&lt;/b&gt;&lt;br&gt;A lane reported &lt;b&gt;both thin&lt;/b&gt; was not really reviewed,&lt;br&gt;whatever its findings file says &#8212; rerun it before&lt;br&gt;trusting the round.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1838" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="p5N" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Ultra has a source the single-pass loops do not:&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;the adjudication logs.&lt;/b&gt; A finding prosecution raised&lt;br&gt;and the adjudicator dropped, &lt;b&gt;with its reason&lt;/b&gt;, is exactly&lt;br&gt;the near-miss worth telling a reviewer about &#8212; append it&lt;br&gt;to the Interesting finds in notes.md.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="1868" width="440" height="100" as="geometry" /></mxCell>
        <mxCell id="escR" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;&#8594; escalate to dev-loop-ultra-opus&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;when an adjudicator reports &lt;b&gt;coverage: both thin&lt;/b&gt;&lt;br&gt;on a lane owning a Critical, &lt;b&gt;twice&lt;/b&gt;.&lt;br&gt;Rarer than escalating into this loop, and stated&lt;br&gt;to the user with the cost rather than taken silently.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="1863" width="440" height="110" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 6 &#8212; Fix&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; identical to dev-loop&lt;br&gt;accepted findings to a sidekick; for each one with&lt;br&gt;would_have_been_bug, the regression test is written and&lt;br&gt;&lt;b&gt;confirmed failing before the fix&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2058" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="p7" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 7 &#8212; loop or exit&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;identical bounds to dev-loop &#8212; &lt;b&gt;3 rounds maximum&lt;/b&gt;, stop on a&lt;br&gt;concern raised and fixed twice, on no material progress, or when&lt;br&gt;completion needs clarification or redesign&lt;br&gt;in round 2+, rerun only the lanes that owned accepted findings&lt;br&gt;plus any the fixes newly made applicable &#8212; &lt;b&gt;as full triples&lt;/b&gt;,&lt;br&gt;&lt;b&gt;not single passes&lt;/b&gt;: a lane worth rerunning is worth rerunning properly&lt;br&gt;&lt;b&gt;Technical still always reruns after a behaviour-changing fix&lt;/b&gt; &#8212; a fix&lt;br&gt;can break something no lane raised, and the pair does not make that&lt;br&gt;less likely&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2218" width="420" height="185" as="geometry" /></mxCell>
        <mxCell id="p8" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8 &#8212; Verification&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; reviewer-verify, opus&lt;br&gt;&lt;b&gt;Adversarial review does not replace it.&lt;/b&gt; The pair checks&lt;br&gt;the code; verification checks that the accumulated fixes&lt;br&gt;still do what was asked.&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2463" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="p8b" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8b &#8212; Walkthrough&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; as dev-loop, in full&lt;br&gt;author from notes.md, review with pr-walkthrough-review,&lt;br&gt;then retake the snapshot as the Phase 9 baseline&lt;br&gt;&lt;b&gt;One addition: the per-lane raised_p / raised_d / kept counts&lt;/b&gt;&lt;br&gt;go into the notes' Reviewers section&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2623" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p9" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 9 &#8212; Commit, push, pull request&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; as dev-loop, in full&lt;br&gt;&lt;b&gt;including the staging and commit-verification steps&lt;/b&gt;&lt;br&gt;stage untracked files explicitly, confirm the committed diff&lt;br&gt;matches the reviewed file list &lt;b&gt;and the tree digest&lt;/b&gt;, push,&lt;br&gt;and confirm the PR's file list matches&lt;br&gt;&lt;b&gt;Three agents per lane approved a working tree.&lt;/b&gt;&lt;br&gt;&lt;b&gt;None of them approved a commit.&lt;/b&gt;&lt;br&gt;index line: loop:&quot;ultra&quot;, plus raised_p / raised_d / kept per lane;&lt;br&gt;the PR description states that this was an adversarial run&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2798" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="done" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3218" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="triple" value="One lane, three agents &#8212; repeated for every applicable lane" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1023" width="1500" height="330" as="geometry" /></mxCell>
        <mxCell id="tiers" value="Model per lane &#8212; passed on every invocation, never left to the agent file's default" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1413" width="1500" height="205" as="geometry" /></mxCell>
        <mxCell id="health" value="Reading the ratio &#8212; the health signal this loop exists to produce" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="3028" width="1500" height="130" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-ultra &#8212; the adversarial loop" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="The same nine lanes as dev-loop, but each is reviewed twice on opposed assumptions and reconciled by a third agent. Roughly 3&#215; the review cost. Implementation is unchanged &#8212; ultra buys scrutiny, not code." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="tp" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;reviewer-ultra-prosecution&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;assumes the code is broken&lt;/b&gt; and something is&lt;br&gt;there to find &#8212; optimised for &lt;b&gt;recall&lt;/b&gt;&lt;br&gt;writes &amp;lt;lane&amp;gt;.prosecution.json + .log.md&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="triple"><mxGeometry x="40" y="50" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="tdf" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;reviewer-ultra-defence&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;assumes the code is correct&lt;/b&gt;, raising only what&lt;br&gt;it can demonstrate &#8212; optimised for &lt;b&gt;precision&lt;/b&gt;&lt;br&gt;writes &amp;lt;lane&amp;gt;.defence.json + .log.md&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="triple"><mxGeometry x="40" y="170" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="tblind" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;The pair runs in parallel and blind to each other.&lt;/b&gt; Neither output is ever used directly &#8212; not by the other reviewer, and not by the lead.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;" vertex="1" parent="triple"><mxGeometry x="40" y="282" width="620" height="34" as="geometry" /></mxCell>
        <mxCell id="tadj" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;reviewer-ultra-adjudicator&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;runs once both have returned. Reads both findings files,&lt;br&gt;both logs, and &lt;b&gt;the code itself&lt;/b&gt;, and produces the lane's&lt;br&gt;single authoritative set: &amp;lt;lane&amp;gt;.json + &amp;lt;lane&amp;gt;.adjudication.log.md&lt;br&gt;&#8212; including the &lt;b&gt;coverage&lt;/b&gt; line&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="triple"><mxGeometry x="670" y="110" width="440" height="100" as="geometry" /></mxCell>
        <mxCell id="tread" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;What the lead reads:&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;only &amp;lt;lane&amp;gt;.json&lt;/b&gt;&lt;br&gt;and the coverage line.&lt;br&gt;Never prosecution or&lt;br&gt;defence &#8212; they are inputs&lt;br&gt;to adjudication, not to you.&lt;br&gt;Reading them puts back&lt;br&gt;exactly the noise the&lt;br&gt;adjudicator was paid&lt;br&gt;to remove.&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="triple"><mxGeometry x="1140" y="50" width="330" height="220" as="geometry" /></mxCell>
        <mxCell id="ti0" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;requirements&lt;br&gt;opus&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="tiers"><mxGeometry x="20" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti1" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;technical&lt;br&gt;opus&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="tiers"><mxGeometry x="312" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti2" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;architecture&lt;br&gt;opus&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="tiers"><mxGeometry x="604" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti3" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;security&lt;br&gt;opus&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="tiers"><mxGeometry x="896" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti4" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;standards&lt;br&gt;sonnet&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="1188" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti5" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;tests&lt;br&gt;sonnet&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="20" y="96" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti6" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;deadcode&lt;br&gt;sonnet&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="312" y="96" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti7" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;minimalism&lt;br&gt;sonnet&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="604" y="96" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti8" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;artifacts&lt;br&gt;sonnet&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="896" y="96" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="tiersN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;All three agents in a lane use the same tier, and the tier is the one dev-loop gives that lane.&lt;/b&gt; If you cannot pass model per invocation &#8212; the tool is unavailable, the parameter is rejected &#8212; &lt;b&gt;stop and say so&lt;/b&gt;: a technical lane silently reviewed at Sonnet is not the loop the user asked for.&lt;br&gt;&lt;b&gt;Effort is NOT passable.&lt;/b&gt; The Agent tool has a model parameter and no effort parameter, so effort is whatever the agent file declares &#8212; &lt;b&gt;high&lt;/b&gt; for all three ultra reviewers. The four Opus lanes therefore run at Opus &lt;b&gt;high&lt;/b&gt;, not xhigh. Say that in run.md rather than reporting a tier the run did not have. Never edit the agent files mid-run to work around it.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="tiers"><mxGeometry x="20" y="148" width="1460" height="48" as="geometry" /></mxCell>
        <mxCell id="hs0" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Prosecution raises many, few survive&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="health"><mxGeometry x="20" y="44" width="476" height="34" as="geometry" /></mxCell>
        <mxCell id="hm0" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;it is running hot &#8212; or defence's dismissals are being accepted too readily&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;dashed=0;fillColor=#ffffff;" vertex="1" parent="health"><mxGeometry x="20" y="78" width="476" height="42" as="geometry" /></mxCell>
        <mxCell id="hs1" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Defence raises almost nothing, across several runs&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="health"><mxGeometry x="512" y="44" width="476" height="34" as="geometry" /></mxCell>
        <mxCell id="hm1" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;it has drifted into agreeableness.&lt;/b&gt; The pair's most common failure and the hardest to see, because it looks like clean code&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;dashed=0;fillColor=#ffffff;" vertex="1" parent="health"><mxGeometry x="512" y="78" width="476" height="42" as="geometry" /></mxCell>
        <mxCell id="hs2" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Both agree on nearly everything&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="health"><mxGeometry x="1004" y="44" width="476" height="34" as="geometry" /></mxCell>
        <mxCell id="hm2" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;the stances are not actually opposed, and you are paying three times for one reviewer's opinion&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;dashed=0;fillColor=#ffffff;" vertex="1" parent="health"><mxGeometry x="1004" y="78" width="476" height="42" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;entryX=0;entryY=0.35;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tp" target="tadj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;entryX=0;entryY=0.65;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tdf" target="tadj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tadj" target="tread"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="why"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="why" target="p02"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p02" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="conc" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8" target="p8b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8b" target="p9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p9" target="health"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="health" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="triple"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="triple" target="tiers"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tiers" target="conc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" value="twice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5" target="escR"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="ROUND + 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#b07a00;" edge="1" parent="1" source="p7" target="p3"><mxGeometry x="-0.88" relative="1" as="geometry"><mxPoint as="offset" /><Array as="points"><mxPoint x="1580" y="2311" /><mxPoint x="1580" y="753" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="dev-loop-ultra-opus">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;/dev-loop-ultra-opus&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="base" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Follow the dev-loop-ultra skill in full.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Every phase, bound, format and rule is the same &#8212; Phase 0's&lt;br&gt;implementation-notes and Phase 8b's walkthrough included.&lt;br&gt;&lt;b&gt;Read dev-loop-ultra/SKILL.md and work from it.&lt;/b&gt;&lt;br&gt;&lt;b&gt;Do not reimplement its phases from this file.&lt;/b&gt;&lt;br&gt;Frame &#8594; implement &#8594; test &#8594; plan + snapshot &#8594; nine lanes, each as&lt;br&gt;prosecution &#124; defence &#8594; adjudicator &#8594; triage &#8594; fix &#8594; loop (3 rounds)&lt;br&gt;&#8594; verify &#8594; walkthrough &#8594; commit, push, PR&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="185" as="geometry" /></mxCell>
        <mxCell id="baseN" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;This file changes two things and nothing else.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Everything below is a delta on the ultra loop, not&lt;br&gt;a loop in its own right. If you find yourself&lt;br&gt;restating an ultra phase here, stop and go read it.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="315" width="440" height="90" as="geometry" /></mxCell>
        <mxCell id="effort" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Effort is NOT raised, because it cannot be passed.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;The Agent tool has a &lt;b&gt;model&lt;/b&gt; parameter and no &lt;b&gt;effort&lt;/b&gt; parameter, so a lane's&lt;br&gt;effort is whatever its agent file declares &#8212; &lt;b&gt;high&lt;/b&gt; for all three ultra reviewers.&lt;br&gt;&lt;b&gt;This loop buys a uniformly higher model tier, not a higher effort tier.&lt;/b&gt;&lt;br&gt;Say that in run.md rather than reporting xhigh lanes the run did not have.&lt;br&gt;The sidekicks are the exception, and not by accident: &lt;b&gt;sidekick-heavy is a distinct&lt;/b&gt;&lt;br&gt;&lt;b&gt;agent file that declares effort: xhigh itself&lt;/b&gt;, so routing to it gets you both.&lt;br&gt;That is the pattern to follow if xhigh reviewers are ever wanted &#8212; dedicated&lt;br&gt;agent files, not a parameter that does not exist.&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="893" width="700" height="170" as="geometry" /></mxCell>
        <mxCell id="just" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;When this loop is justified&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;dev-loop-ultra already covers changes where a missed defect is expensive.&lt;br&gt;Reach past it to this one &lt;b&gt;only when the cost of being wrong is severe and&lt;/b&gt;&lt;br&gt;&lt;b&gt;largely irreversible&lt;/b&gt;:&lt;br&gt;&#8226; a migration that alters or destroys production data&lt;br&gt;&#8226; auth or tenant-isolation logic where a defect exposes other people's data&lt;br&gt;&#8226; money movement, settlement, or anything with a regulatory consequence&lt;br&gt;&#8226; a contract other organisations build against and cannot easily be asked to change&lt;br&gt;&#8226; code being handed to someone who will not be able to fix it&lt;br&gt;&lt;b&gt;For anything less, dev-loop-ultra is the honest choice, and dev-loop is the&lt;/b&gt;&lt;br&gt;&lt;b&gt;honest default. Escalating past the point where the loop changes the&lt;/b&gt;&lt;br&gt;&lt;b&gt;outcome is spending, not diligence.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="1373" width="760" height="210" as="geometry" /></mxCell>
        <mxCell id="idx" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Index line: loop:&quot;ultra-opus&quot;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Keep the same per-lane &lt;b&gt;raised_p / raised_d / kept&lt;/b&gt; counts and the same&lt;br&gt;&lt;b&gt;walkthrough&lt;/b&gt; field as every other loop.&lt;br&gt;Comparing those against ultra runs is how you find out whether the Opus&lt;br&gt;lanes actually change the findings &lt;b&gt;or only the bill&lt;/b&gt;.&lt;br&gt;That is worth knowing, and nobody can tell you without the data.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="1643" width="700" height="130" as="geometry" /></mxCell>
        <mxCell id="done" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="1833" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="c1" value="Change 1 &#8212; every subagent runs on Opus, review lanes and implementation alike" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="513" width="1500" height="320" as="geometry" /></mxCell>
        <mxCell id="c2" value="Change 2 &#8212; concurrency drops to one lane at a time" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1123" width="1500" height="190" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-ultra-opus &#8212; adversarial, every subagent on Opus" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Structurally identical to dev-loop-ultra. It changes exactly two things: the model on every agent, and the concurrency. Roughly 4&#215; the review cost of a full run, and 2.7&#215; the run as a whole &#8212; the most expensive loop available." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="c1h0" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Agent&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fontSize=10;fillColor=#0f3355;fontColor=#ffffff;" vertex="1" parent="c1"><mxGeometry x="20" y="42" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1h1" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Model&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fontSize=10;fillColor=#0f3355;fontColor=#ffffff;" vertex="1" parent="c1"><mxGeometry x="444" y="42" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1h2" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Effort &#8212; and where it comes from&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fontSize=10;fillColor=#0f3355;fontColor=#ffffff;" vertex="1" parent="c1"><mxGeometry x="748" y="42" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a0" value="reviewer-ultra-prosecution" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="20" y="72" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m0" value="opus &#8212; &lt;b&gt;passed&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="444" y="72" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e0" value="high &#8212; declared in the agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="748" y="72" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a1" value="reviewer-ultra-defence" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="20" y="102" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m1" value="opus &#8212; &lt;b&gt;passed&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="444" y="102" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e1" value="high &#8212; declared in the agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="748" y="102" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a2" value="reviewer-ultra-adjudicator" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="20" y="132" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m2" value="opus &#8212; &lt;b&gt;passed&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="444" y="132" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e2" value="high &#8212; declared in the agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="748" y="132" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a3" value="reviewer-verify" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#dcefe3;" vertex="1" parent="c1"><mxGeometry x="20" y="162" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m3" value="opus &#8212; its own default" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#dcefe3;" vertex="1" parent="c1"><mxGeometry x="444" y="162" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e3" value="high &#8212; declared in the agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#dcefe3;" vertex="1" parent="c1"><mxGeometry x="748" y="162" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a4" value="Implementation sidekick" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="20" y="192" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m4" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;sidekick-heavy&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="444" y="192" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e4" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;xhigh&lt;/b&gt; &#8212; declared in that agent file&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="748" y="192" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a5" value="Test-writing sidekick" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="20" y="222" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m5" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;sidekick-heavy&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="444" y="222" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e5" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;xhigh&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="748" y="222" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a6" value="Fix sidekick" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="20" y="252" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m6" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;sidekick-heavy&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="444" y="252" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e6" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;xhigh&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="748" y="252" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1n" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;The lane table in dev-loop-ultra is superseded&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;in one respect only: no lane drops to Sonnet.&lt;/b&gt;&lt;br&gt;Every reviewer runs on Opus.&lt;br&gt;&lt;b&gt;Implementation is on Opus here too&lt;/b&gt;, unlike every&lt;br&gt;other loop. If you are paying for adversarial review&lt;br&gt;at this tier, having the code written a tier below&lt;br&gt;the reviewers is a false economy.&lt;br&gt;&lt;b&gt;If you cannot pass a model per invocation, stop&lt;/b&gt;&lt;br&gt;&lt;b&gt;and say so.&lt;/b&gt; Running silently at default tiers gives&lt;br&gt;the user the cost profile they did not ask for and&lt;br&gt;the scrutiny they did.&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="c1"><mxGeometry x="1180" y="42" width="300" height="240" as="geometry" /></mxCell>
        <mxCell id="c2u" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;dev-loop-ultra&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;two lanes at a time&lt;br&gt;four reviewers in flight&lt;br&gt;then the two adjudicators&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;" vertex="1" parent="c2"><mxGeometry x="40" y="50" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="c2o" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;dev-loop-ultra-opus&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;ONE lane at a time&lt;/b&gt;&lt;br&gt;prosecution and defence in parallel,&lt;br&gt;then that lane's adjudicator,&lt;br&gt;then the next lane&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;" vertex="1" parent="c2"><mxGeometry x="520" y="50" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="c2n" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Two Opus reviewers plus an adjudicator is&lt;br&gt;already a heavy concurrent load.&lt;br&gt;&lt;b&gt;This makes ultra-opus considerably slower in&lt;/b&gt;&lt;br&gt;&lt;b&gt;wall-clock than dev-loop-ultra. That is the trade&lt;/b&gt;&lt;br&gt;&lt;b&gt;being made; do not widen the concurrency to&lt;/b&gt;&lt;br&gt;&lt;b&gt;recover it.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="c2"><mxGeometry x="1000" y="50" width="460" height="90" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="base"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="c2" target="just"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="just" target="idx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="idx" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="base" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="effort"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="effort" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="becomes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2u" target="c2o"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="dev-loop-lite">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;/dev-loop-lite&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="wrong" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Is this the wrong loop?&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Stop and use the full dev-loop if &lt;b&gt;any&lt;/b&gt; holds:&lt;br&gt;&#8226; the diff touches authn/authz, secrets or untrusted input&lt;br&gt;&#8226; a migration, schema or public API contract changes&lt;br&gt;&#8226; more than one project in the solution is modified&lt;br&gt;&#8226; it ships on a path you cannot easily roll back&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="wrongL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;&#8594; dev-loop (full)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;If you are unsure, use the full loop.&lt;br&gt;The savings are not worth a missed Critical.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="293" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="p0" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 0 &#8212; Frame the slice&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;requirement, non-goals, constraints, entry points,&lt;br&gt;definition of done, &lt;b&gt;and the source branch the PR targets&lt;/b&gt;&lt;br&gt;create the run directory + brief.md &#8212; reviewers read it&lt;br&gt;invoke implementation-notes &#8594; notes.md&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="458" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 1 &#8212; Implement&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;implementation is NOT downgraded in this loop&lt;/b&gt;&lt;br&gt;sidekick by default &#8226; sidekick-lite only if mechanical&lt;br&gt;sidekick-heavy when a constraint needs real reasoning&lt;br&gt;the brief asks the reasoning back &#8594; notes.md&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="633" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1N" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Cheaper scrutiny of carefully written code is a&lt;br&gt;reasonable trade. &lt;b&gt;Cheap code reviewed cheaply is not.&lt;/b&gt;&lt;br&gt;Reaching for sidekick-heavy is a soft signal to&lt;br&gt;re-read the loop-selection criteria.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="650" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="p2" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 2 &#8212; Tests&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; a second handoff&lt;br&gt;unit tests for logic and boundaries, integration tests for&lt;br&gt;anything crossing a process or service edge, UI tests for&lt;br&gt;visible behaviour &#8212; each must fail if behaviour regresses&lt;br&gt;decisions and rejected alternatives &#8594; notes.md&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="808" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 3 &#8212; Plan the round&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; ROUND = N&lt;br&gt;classify every lane &lt;b&gt;applicable or skipped with a&lt;/b&gt;&lt;br&gt;&lt;b&gt;diff-based reason&lt;/b&gt;, into round-N/plan.md, before&lt;br&gt;spawning anything &#8212; &quot;the code looks fine&quot; is never a skip&lt;br&gt;then snapshot the tree &#8594; plan.md  tree: &amp;lt;sha&amp;gt;&lt;br&gt;and create round-N/scratch for the Tests lane&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="983" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p3N" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;The snapshot and the scratch worktree are the&lt;br&gt;&lt;b&gt;lead's&lt;/b&gt; job, not a reviewer's. A lane that made its&lt;br&gt;own scratch space would be making it from a tree&lt;br&gt;it has just been told not to touch.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1008" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 4 &#8212; Delegate&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;spawn the applicable lanes &lt;b&gt;in parallel, in one turn&lt;/b&gt;&lt;br&gt;&#8212; four fit in a single batch, no waves needed&lt;br&gt;each gets: card name and path, run dir and round, diff base,&lt;br&gt;changed files, brief path, validation commands&lt;br&gt;the Tests lane also gets the scratch worktree path&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1173" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="integ" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;all four drained &#8212; retake the&lt;br&gt;snapshot: did the tree move?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="1673" width="340" height="130" as="geometry" /></mxCell>
        <mxCell id="integL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;a reviewer wrote to the tree under review&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;stop, restore, rerun that lane. Four lanes reading&lt;br&gt;one tree concurrently is exactly the situation&lt;br&gt;this check exists for &#8212; do not assess whether&lt;br&gt;the mutation looked harmless.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1688" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 5 &#8212; Triage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;1 &#8212; cluster by locator and cause; one owning lane each&lt;br&gt;2 &#8212; evidence gate: inferred alone never blocks&lt;br&gt;3 &#8212; cause gate: introduced / worsened /&lt;br&gt;missing-required fixed; stale recorded&lt;br&gt;4 &#8212; defect &#8800; remedy: smallest fix, intent preserved&lt;br&gt;5 &#8212; wontfix.json  6 &#8212; conventions.md&lt;br&gt;write round-N/triage.md, classify every rejection&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1863" width="420" height="155" as="geometry" /></mxCell>
        <mxCell id="p5N" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Consolidation makes the rejection split matter more,&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;not less&lt;/b&gt; &#8212; a merged lane's total rejection rate blends&lt;br&gt;four concerns and tells you nothing on its own.&lt;br&gt;Correctness owns the brief here, so &lt;b&gt;its&lt;/b&gt; findings go to&lt;br&gt;notes.md whether accepted or rejected.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="1890" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="esc" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;any Critical&lt;br&gt;in round 1?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="2078" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="escL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;abandon this loop &#8212; restart under dev-loop (full)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Not a coverage argument: these four lanes &lt;b&gt;do&lt;/b&gt; cover all&lt;br&gt;nine concerns. What they lack is &lt;b&gt;depth and tiering&lt;/b&gt; &#8212;&lt;br&gt;Sonnet and Haiku not four Opus lanes, two rounds not three,&lt;br&gt;verification usually skipped. Do not fix it here and carry on.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2078" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 6 &#8212; Fix&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;one brief to sidekick, or sidekick-heavy if it needs judgment&lt;br&gt;&lt;b&gt;fixes are not downgraded either&lt;/b&gt;&lt;br&gt;would_have_been_bug &#8594; failing test FIRST, confirm it fails,&lt;br&gt;apply the fix, confirm it passes &#8212; that order, stated in the brief&lt;br&gt;then the smallest relevant validation, not the whole suite&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2248" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p7" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 7 &#8212; loop or exit&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;remove the scratch worktree,&lt;br&gt;retake the snapshot&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="2438" width="360" height="140" as="geometry" /></mxCell>
        <mxCell id="p7L" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;BLOCKED &#8212; stop and report&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;ROUND would exceed &lt;b&gt;2&lt;/b&gt; &#8226; the same concern raised&lt;br&gt;and fixed twice &#8226; a round with no material progress&lt;br&gt;&#8226; completion needs clarification or redesign&lt;br&gt;&lt;b&gt;A lite change that cannot converge in two rounds&lt;/b&gt;&lt;br&gt;&lt;b&gt;is not a lite change.&lt;/b&gt; Switch loops, do not add a round.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2448" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p7R" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;ROUND + 1 &#8594; back to Phase 3&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;rerun only the lanes that owned accepted findings,&lt;br&gt;plus Correctness after any behaviour-changing fix&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="2468" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="p8" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8 &#8212; Verification&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;a Critical, or a Major with&lt;br&gt;would_have_been_bug, fixed?&lt;br&gt;or did artifacts change?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="2638" width="380" height="150" as="geometry" /></mxCell>
        <mxCell id="p8R" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;no &#8212; skip it, and say so in run.md&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;A skipped phase that is not recorded&lt;br&gt;reads as a phase that was forgotten.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="2678" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="v" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;reviewer-verify&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; opus, high&lt;br&gt;&lt;b&gt;stays on Opus deliberately: the last gate before a human&lt;/b&gt;&lt;br&gt;does the final diff preserve intent? does validation match&lt;br&gt;the touched behaviour? did required checks run?&lt;br&gt;do the deferrals have concrete reasons?&lt;br&gt;&lt;b&gt;NOT a re-review of the diff&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2648" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p8b" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8b &#8212; Walkthrough&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;1 &#8212; author: sidekick drafts from &lt;b&gt;notes.md, not the diff&lt;/b&gt;&lt;br&gt;2 &#8212; review: a second sidekick applies pr-walkthrough-review,&lt;br&gt;write-capable on the walkthrough file alone&lt;br&gt;3 &#8212; retake the snapshot &#8212; &lt;b&gt;this is the Phase 9 baseline&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2848" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p8bN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Step 3 is &lt;b&gt;not&lt;/b&gt; bookkeeping. The walkthrough is a new file&lt;br&gt;under docs/, which is not gitignored, so it changes the digest&lt;br&gt;&#8212; and Phase 9 stops the run when the digest differs from the&lt;br&gt;baseline. Without it, &lt;b&gt;every run halts there.&lt;/b&gt;&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="2868" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="p9" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 9 &#8212; Commit, push, pull request&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;0 &#8212; remove every scratch worktree from this run&lt;br&gt;1 &#8212; full build and test suite green&lt;br&gt;2 &#8212; stage everything: ?? files are missed by a path-pattern add&lt;br&gt;exclude runs/, commit conventions.md and the walkthrough&lt;br&gt;3 &#8212; commit   4 &#8212; verify &lt;b&gt;--stat AND the tree digest&lt;/b&gt;&lt;br&gt;5 &#8212; push   6 &#8212; PR targets the Phase 0 source branch&lt;br&gt;7 &#8212; confirm the PR file list matches step 4&lt;br&gt;8 &#8212; description says &lt;b&gt;this was a lite run&lt;/b&gt; + links the walkthrough&lt;br&gt;9 &#8212; run.md + index.jsonl with loop:&quot;lite&quot;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3028" width="420" height="185" as="geometry" /></mxCell>
        <mxCell id="p9N" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Same files with different contents produce an&lt;br&gt;&lt;b&gt;identical --stat&lt;/b&gt;. Only the tree digest catches&lt;br&gt;content that moved between the last review&lt;br&gt;and the commit.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="3080" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="done" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3273" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="lanes" value="The four consolidated lanes &#8212; nine concerns compressed into four contexts" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1363" width="1500" height="250" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-lite" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Four consolidated lanes, two rounds, verification only when it is earned. Review cost ≈ 0.3&#215; a full run. The lite loop economises on review, never on the code." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="ln0" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Correctness &#8212; sonnet, high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fillColor=#e7eef5;" vertex="1" parent="lanes"><mxGeometry x="14" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb0" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;always applicable&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;requirements conformance to the brief,&lt;br&gt;technical defects, &lt;b&gt;and artifacts&lt;/b&gt;&lt;br&gt;(migrations, lockfiles, generated code)&lt;br&gt;&#8212; three full-loop lanes in one pass&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="ln1" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Structure &#8212; sonnet, high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fillColor=#e7eef5;" vertex="1" parent="lanes"><mxGeometry x="386" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb1" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;always applicable&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;separation of concerns FIRST&lt;/b&gt;, then&lt;br&gt;architecture in force, coding-standards&lt;br&gt;+ .claude/standards.md, surplus additions&lt;br&gt;and dead code &#8212; four lanes in one pass&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="386" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="ln2" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Tests &#8212; &lt;b&gt;haiku&lt;/b&gt;, high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fillColor=#e7eef5;" vertex="1" parent="lanes"><mxGeometry x="758" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb2" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;always applicable&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;would the tests fail if the code were&lt;br&gt;wrong? assertion quality, error paths,&lt;br&gt;over-mocking, missing negatives&lt;br&gt;mutation testing in the scratch worktree only&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="758" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="ln3" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Security &#8212; sonnet, high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fillColor=#fbf0d5;" vertex="1" parent="lanes"><mxGeometry x="1130" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb3" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;gated&lt;/b&gt;: input handling, queries,&lt;br&gt;serialization, file or network I/O,&lt;br&gt;or dependencies&lt;br&gt;&lt;b&gt;if it touches authn/authz or secrets&lt;/b&gt;&lt;br&gt;&lt;b&gt;you are in the wrong loop&lt;/b&gt;&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1130" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="lanesN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Each lane reads &lt;b&gt;only its own card&lt;/b&gt; and stays silent on anything another lane owns. Each writes round-N/&amp;lt;lane&amp;gt;.json and round-N/&amp;lt;lane&amp;gt;.log.md,&lt;br&gt;and returns &lt;b&gt;one line&lt;/b&gt; to the lead: path written and counts by severity. Reviewers are read-only &#8212; they never call Edit and never fix.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="14" y="190" width="1470" height="48" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="wrong"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="wrong" target="p0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="integ" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5" target="esc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="esc" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8b" target="p9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p9" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="lanes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lanes" target="integ"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="any holds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="wrong" target="wrongL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="integ" target="integL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="esc" target="escL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p7" target="p7L"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" value="round 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p7" target="p7R"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="next round" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#b07a00;" edge="1" parent="1" source="p7R" target="p3"><mxGeometry x="-0.9" relative="1" as="geometry"><mxPoint as="offset" /><Array as="points"><mxPoint x="1560" y="2508" /><mxPoint x="1560" y="1048" /></Array></mxGeometry></mxCell>
        <mxCell id="e20" value="pass: no Critical or Major survived&amp;#xa;and targeted validation is green" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8" target="v"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8" target="p8b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="v" target="p8b"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="dev-loop-ultralight">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;/dev-loop-ultralight&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="elig" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Eligibility &#8212; checked before anything else&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;ALL of these must hold:&lt;br&gt;&#8226; one project, roughly five files or fewer&lt;br&gt;&#8226; no authn/authz, secrets, or untrusted input&lt;br&gt;&#8226; no migration, schema, generated artifact or public contract&lt;br&gt;&#8226; no concurrency, async ordering or transaction boundary&lt;br&gt;&#8226; no new dependency&lt;br&gt;&#8226; easy to roll back&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="eligL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;any ONE fails&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&#8594; dev-loop-lite&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="313" width="420" height="70" as="geometry" /></mxCell>
        <mxCell id="eligR" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;several fail, or you are unsure&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&#8594; dev-loop (full)&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="313" width="420" height="70" as="geometry" /></mxCell>
        <mxCell id="eligN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;The eligibility list is the &lt;b&gt;entire&lt;/b&gt; safety&lt;br&gt;mechanism of this loop. Nothing downstream will&lt;br&gt;catch a change that should not have been here.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="p0" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 0 &#8212; Frame&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;one short paragraph: what changes, what must not,&lt;br&gt;which files, definition of done, &lt;b&gt;SOURCE BRANCH&lt;/b&gt;&lt;br&gt;create .claude/review/runs/&amp;lt;run-id&amp;gt;/ + brief.md&lt;br&gt;invoke implementation-notes &#8594; notes.md&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="488" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 1 &#8212; Implement AND test&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;ONE handoff, not two&lt;/b&gt; &#8212; unlike every other loop&lt;br&gt;sidekick by default; sidekick-lite only if mechanical&lt;br&gt;tests still required: each must fail if behaviour regresses&lt;br&gt;the brief asks the reasoning back &#8594; notes.md&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="663" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1N" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Reaching for &lt;b&gt;sidekick-heavy&lt;/b&gt; here is a&lt;br&gt;strong sign you are in the wrong loop.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="692" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="snap" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Snapshot the working tree&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;record in round-1/plan.md as  tree: &amp;lt;sha&amp;gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="838" width="420" height="60" as="geometry" /></mxCell>
        <mxCell id="p2" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 2 &#8212; Review&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;spawn &lt;b&gt;reviewer-ultralight&lt;/b&gt; ONCE &#8212; sonnet, effort high&lt;br&gt;read-only; writes round-1/ultralight.json + .log.md&lt;br&gt;returns one line: path, counts, items covered out of nine&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="958" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="p2N" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;No scratch worktree.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;No mutation testing in this loop &#8212;&lt;br&gt;a suite you must break to trust&lt;br&gt;belongs in a loop with a second round.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="968" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="chk" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;re-snapshot:&lt;br&gt;did the tree move?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="1118" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="chkL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;a reviewer wrote to the code it reviewed&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;restore the tree and rerun &#8212; the findings&lt;br&gt;describe a tree that no longer exists&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1133" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 3 &#8212; Triage &#8212; the lead is the arbiter&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;1 &#8212; evidence gate: inferred alone never blocks&lt;br&gt;2 &#8212; cause gate: introduced / worsened /&lt;br&gt;missing-required are fixed; stale is recorded&lt;br&gt;3 &#8212; defect &#8800; remedy: smallest fix, intent preserved&lt;br&gt;4 &#8212; wontfix.json &#8212; dies with the run&lt;br&gt;5 &#8212; conventions.md &#8212; survives to the next run&lt;br&gt;write round-1/triage.md, classifying every rejection&lt;br&gt;stale &#124; evidence &#124; remedy &#124; &lt;b&gt;wrong&lt;/b&gt;&lt;br&gt;&#8212; only &lt;b&gt;wrong&lt;/b&gt; counts against the reviewer&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1288" width="420" height="180" as="geometry" /></mxCell>
        <mxCell id="p3N" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Requirements findings go to &lt;b&gt;notes.md whether&lt;br&gt;accepted or rejected&lt;/b&gt;. A rejected one says the brief&lt;br&gt;was ambiguous, or was read differently than the&lt;br&gt;implementer read it &#8212; which a reviewer needs told.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1338" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="esc" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;any escalation&lt;br&gt;trigger?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="1528" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="escL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;&#8594; dev-loop (full)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;any Critical, or a Major in&lt;br&gt;security, architecture or concurrency&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1543" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="escR" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;&#8594; dev-loop-lite&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;any other Major &#8226; more than four accepted findings&lt;br&gt;&#8226; the reviewer reports a concern it could not cover&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="1543" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="escN" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Escalation is mandatory and one-way.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Do not fix and carry on: a trivial change that&lt;br&gt;produced a Major was not trivial, and these&lt;br&gt;concerns had a ninth of the usual attention.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="1715" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 4 &#8212; Fix&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;one brief to sidekick &#8212; reviewers never edit&lt;br&gt;would_have_been_bug &#8594; write the failing test FIRST,&lt;br&gt;confirm it fails, apply the fix, confirm it passes&lt;br&gt;then run the relevant tests, lint and build&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1698" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 5 &#8212; Exit&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;did the fixes clear it?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="1873" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="p5L" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;no, or the fix introduced something new&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&#8594; dev-loop-lite. There is &lt;b&gt;no second round&lt;/b&gt;:&lt;br&gt;one reviewer looking twice at its own&lt;br&gt;missed work is not independent.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1888" width="340" height="90" as="geometry" /></mxCell>
        <mxCell id="p5R" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;There is no verification phase.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Anything risky enough to warrant one&lt;br&gt;has already triggered escalation.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950" y="1898" width="360" height="70" as="geometry" /></mxCell>
        <mxCell id="p5b" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 5b &#8212; Walkthrough&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;pr-walkthrough drafted by sidekick &lt;b&gt;from notes.md, not the diff&lt;/b&gt;&lt;br&gt;&lt;b&gt;the lead checks it inline&lt;/b&gt; &#8212; this loop alone spawns no&lt;br&gt;pr-walkthrough-review; a change this small does not justify one&lt;br&gt;retake the snapshot &#8212; it is the Phase 6 baseline&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2053" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 6 &#8212; Commit, push, pull request&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;stage untracked files too &#8212; ?? is missed by a path-pattern add&lt;br&gt;verify BOTH: --stat against the sweep, and the tree digest&lt;br&gt;PR targets the Phase 0 source branch, never the repo default&lt;br&gt;description says plainly: &lt;b&gt;ultralight, one review pass&lt;/b&gt;&lt;br&gt;run.md + one line to index.jsonl with loop:&quot;ultralight&quot;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2228" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="done" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="2418" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="sweep" value="The sweep &#8212; every item, in order, every time" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="938" width="620" height="404" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-ultralight" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="One reviewer, one round, no verification phase &#8212; a nine-concern sweep in a single pass. Review cost ≈ 0.1&#215; a full run. Implementation is NOT downgraded." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sw0" value="1 &#8212; Requirements: does it do what the brief asked, and nothing more?" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="40" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw1" value="2 &#8212; Correctness: logic, inverted conditions, boundaries, second call" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="72" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw2" value="3 &#8212; Error paths: dependency throws, times out, returns partial" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="104" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw3" value="4 &#8212; &lt;b&gt;Separation of concerns &#8212; do not compress this one&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="136" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw4" value="5 &#8212; Placement: repo convention; inferred evidence can never block" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="168" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw5" value="6 &#8212; Standards: coding-standards skill + .claude/standards.md only" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="200" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw6" value="7 &#8212; Security: authz or untrusted input here = wrong loop, say so" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="232" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw7" value="8 &#8212; Tests: would they fail if the code were wrong?" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="264" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw8" value="9 &#8212; Surplus: guards, wrappers, config nothing requires" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="296" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sweepN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;The log records a verdict for &lt;b&gt;all nine&lt;/b&gt;, including the ones it found&lt;br&gt;nothing on. That per-item list is the only evidence the sweep did not&lt;br&gt;stop at item 3 &#8212; which is what you buy with a checklist reviewer.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="338" width="596" height="56" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="elig"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="elig" target="p0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p1" target="snap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="snap" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p2" target="chk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="chk" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p3" target="esc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="esc" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5b" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p6" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="elig" target="eligL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="elig" target="eligR"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="chk" target="chkL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="esc" target="escL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="esc" target="escR"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5" target="p5L"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5" target="p5b"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
