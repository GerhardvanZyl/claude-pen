        <mxCell id="e18" value="PASS: no Critical or Major survived triage and targeted&amp;#xa;validation passes &amp;#8212; or two consecutive Minor-only rounds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry" /></mxCell>
