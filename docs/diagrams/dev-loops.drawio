<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dev-loop">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="/dev-loop" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="when" value="&lt;b&gt;Use the full loop when ANY of these holds&lt;/b&gt; &#8212;&#xa;this list decides it, not diff size:&#xa;&#8226; the change touches authentication, authorization,&#xa;secrets or untrusted input&#xa;&#8226; a migration, schema or public API contract changes&#xa;&#8226; more than one project in the solution is modified&#xa;&#8226; it ships on a path that is hard to roll back" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="145" as="geometry" /></mxCell>
        <mxCell id="whenR" value="&lt;b&gt;Escalate to dev-loop-ultra&lt;/b&gt; if a Critical lands in a&#xa;lane the change was not expected to touch at all,&#xa;&lt;b&gt;or&lt;/b&gt; the same Critical survives a fix and recurs in a&#xa;later round. Escalating upward is rarer than escalating&#xa;into this loop, and is stated to the user with the cost." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="285" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="p0" value="&lt;b&gt;Phase 0 &#8212; Frame the slice&lt;/b&gt;&#xa;requirement in plain language and explicit non-goals,&#xa;hard constraints, files and entry points from recon,&#xa;definition of done incl. which validation must pass,&#xa;&lt;b&gt;the source branch&lt;/b&gt; &#8212; the PR targets it, not the default&#xa;run dir .claude/review/runs/&lt;run-id&gt;/ + brief.md&#xa;invoke implementation-notes &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="473" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p0N" value="Reviewers read brief.md. &lt;b&gt;If it is not written&#xa;down, the requirements lane cannot run.&lt;/b&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="p1" value="&lt;b&gt;Phase 1 &#8212; Implement&lt;/b&gt;&#xa;delegate to the appropriate sidekick tier &#8212; the lead&#xa;writes no implementation code at any point in this loop&#xa;the brief requires conformance to coding-standards&#xa;and solution-architecture, both preloaded into sidekicks&#xa;and it &lt;b&gt;asks the reasoning back&lt;/b&gt; &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="683" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p2" value="&lt;b&gt;Phase 2 &#8212; Tests&lt;/b&gt; &#8212; a second handoff, not part of Phase 1&#xa;unit for logic and boundaries, integration for anything&#xa;crossing a process, database, queue or service edge,&#xa;UI for user-visible behaviour change&#xa;each must fail if the behaviour regresses &#8212; say so in the brief" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="873" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;b&gt;Phase 3 &#8212; Plan the review round&lt;/b&gt; &#8212; ROUND = N&#xa;classify each lane &lt;b&gt;applicable or skipped, with a concrete&lt;/b&gt;&#xa;&lt;b&gt;diff-based reason&lt;/b&gt;, into round-N/plan.md before spawning&#xa;&quot;the code looks fine&quot; is not a skip reason &#8212; only a factual&#xa;statement about what the diff does not touch is&#xa;then: snapshot the tree &#8594; plan.md  tree: &lt;sha&gt;&#xa;and create round-N/scratch for the Tests lane" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1053" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p3N" value="Neither step is optional and neither belongs to a&#xa;reviewer. In round 2+, recompute applicability from&#xa;the &lt;b&gt;fix delta&lt;/b&gt; &#8212; rerun the lanes that owned accepted&#xa;findings, plus any the fixes newly made applicable.&#xa;&lt;b&gt;Always rerun Technical after a behaviour-changing fix.&lt;/b&gt;&#xa;A comment-only fix does not justify a full round." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1073" width="400" height="110" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;b&gt;Phase 4 &#8212; Delegate&lt;/b&gt;&#xa;spawn the applicable reviewers in parallel, &lt;b&gt;up to four at a time&lt;/b&gt;&#xa;more than four &#8594; run in waves, letting each wave drain;&#xa;five-plus Opus reviewers at once hit concurrency and rate&#xa;limits before they hit anything useful&#xa;each gets: &lt;b&gt;its card only&lt;/b&gt;, run dir + round, diff base, changed&#xa;files, brief path, validation commands &#8212; Tests also gets scratch" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1263" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="integ" value="every reviewer drained &#8212; retake the&#xa;snapshot and compare against plan.md,&#xa;&lt;b&gt;before reading a single finding&lt;/b&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="1913" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="integL" value="&lt;b&gt;a reviewer wrote to the tree under review&lt;/b&gt;&#xa;identify the lane, restore the tree, rerun that lane from&#xa;the restored tree. &lt;b&gt;Do not assess whether the mutation&lt;/b&gt;&#xa;&lt;b&gt;looked harmless&lt;/b&gt; &#8212; every finding from that round&#xa;describes a tree that no longer exists.&#xa;This should pass every time. That is the point of running&#xa;it: it is cheap, and the one run where it fails is a run&#xa;where the Phase 9 file-list check would have said fine." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1913" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;b&gt;Phase 5 &#8212; Triage &#8212; you are the arbiter&lt;/b&gt;&#xa;1 &#8212; cluster by locator and cause; &lt;b&gt;one owning lane&lt;/b&gt; per&#xa;concern, the rest become corroboration&#xa;2 &#8212; evidence gate: inferred-only can never be Critical or Major&#xa;3 &#8212; cause gate: introduced / worsened / &lt;b&gt;missing-required&lt;/b&gt;&#xa;are fixed; stale and pre-existing debt go in the PR description&#xa;4 &#8212; defect &#8800; remedy: check a narrower boundary or type fix&#xa;before accepting a wrapper, validator, cache, flag or shim&#xa;5 &#8212; wontfix.json &#8212; stops the loop oscillating within a run&#xa;6 &#8212; conventions.md &#8212; the only thing that survives the run&#xa;write round-N/triage.md &#8212; the main thing you will want&#xa;when a run goes wrong" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2123" width="420" height="200" as="geometry" /></mxCell>
        <mxCell id="p5N" value="&lt;b&gt;missing-required is in scope precisely because what&lt;/b&gt;&#xa;&lt;b&gt;it names is not in the diff&lt;/b&gt; &#8212; the migration for a schema&#xa;change, the regenerated client, the lockfile for a new&#xa;package. Absent code is never in a diff, so a gate&#xa;admitting only introduced and worsened would drop&#xa;every one of them.&#xa;&#xa;&lt;b&gt;Rejections are split by reason, and the split is the point:&lt;/b&gt;&#xa;stale &#183; evidence &#183; remedy count the gates doing their job;&#xa;&lt;b&gt;only rejected_wrong counts against the lane.&lt;/b&gt;&#xa;If you cannot classify one cleanly, use wrong &#8212; over-counting&#xa;prompts a look at the card rather than quiet confidence." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="2123" width="420" height="200" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;b&gt;Phase 6 &#8212; Fix&lt;/b&gt;&#xa;one brief to a sidekick &#8212; &lt;b&gt;reviewers never edit&lt;/b&gt;&#xa;for each accepted finding with would_have_been_bug:&#xa;1 write a test that fails against the current code&#xa;2 confirm it fails  3 apply the fix  4 confirm it passes&#xa;&lt;b&gt;state that order explicitly&lt;/b&gt; &#8212; a test written after the fix&#xa;proves nothing about whether it would have caught the bug&#xa;then the smallest relevant validation, not the whole suite" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2383" width="420" height="155" as="geometry" /></mxCell>
        <mxCell id="p7" value="&lt;b&gt;Phase 7 &#8212; loop or exit&lt;/b&gt;&#xa;remove the scratch worktree first,&#xa;then retake the snapshot" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="2598" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="p7L" value="&lt;b&gt;BLOCKED &#8212; stop and report, do not continue&lt;/b&gt;&#xa;&#8226; ROUND would exceed &lt;b&gt;3&lt;/b&gt;&#xa;&#8226; the same concern has been raised and fixed twice &#8212; the&#xa;fix is not addressing the cause and a third will not help&#xa;&#8226; a round produced no material progress&#xa;&#8226; completion needs clarification, redesign, or behaviour&#xa;outside the brief's intent&#xa;&lt;b&gt;Never loop unbounded. Yield falls off sharply after round two.&lt;/b&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2598" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p7R" value="&lt;b&gt;ROUND + 1 &#8594; back to Phase 3&lt;/b&gt;&#xa;recompute applicability from the fix delta" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="2643" width="400" height="60" as="geometry" /></mxCell>
        <mxCell id="p8" value="&lt;b&gt;Phase 8 &#8212; Independent verification&lt;/b&gt;&#xa;validation uncertain, the slice risky,&#xa;artifacts changed, or a Critical fixed?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="2808" width="400" height="160" as="geometry" /></mxCell>
        <mxCell id="v" value="&lt;b&gt;reviewer-verify&lt;/b&gt; &#8212; opus, high &#8212; spawned once&#xa;asked only four things: does the final diff preserve intent?&#xa;does validation match the touched behaviour? did required&#xa;checks run or do they have stated blockers? do the deferrals&#xa;have concrete reasons?&#xa;&lt;b&gt;Do not ask it to re-review the whole diff.&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2823" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p8b" value="&lt;b&gt;Phase 8b &#8212; Walkthrough&lt;/b&gt;&#xa;1 &#8212; author: sidekick drafts from &lt;b&gt;notes.md, not the diff&lt;/b&gt;&#xa;&#8212; a draft briefed on the diff comes back as a narrated&#xa;changelog, the one failure this phase exists to prevent&#xa;2 &#8212; review: a second sidekick applies pr-walkthrough-review;&#xa;&lt;b&gt;do not read the document into your own context to judge it&lt;/b&gt;&#xa;3 &#8212; retake the snapshot &#8212; &lt;b&gt;this is the Phase 9 baseline&lt;/b&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3028" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p8bN" value="Skipping is permitted only for a purely mechanical&#xa;change &#8212; a rename, a bump, a formatting sweep &#8212; and&#xa;the skip goes in the PR description and run.md.&#xa;&lt;b&gt;It is never silent.&lt;/b&gt;&#xa;&#xa;Step 3 runs &lt;b&gt;whether or not&lt;/b&gt; you wrote one: Phase 9 stops&#xa;the run when the digest differs from this baseline, so it&#xa;must always have a value to compare against." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="3033" width="420" height="140" as="geometry" /></mxCell>
        <mxCell id="p9" value="&lt;b&gt;Phase 9 &#8212; Commit, push, pull request&lt;/b&gt;&#xa;&lt;b&gt;Nothing is on the branch until you put it there.&lt;/b&gt;&#xa;0 &#8212; remove every scratch worktree, including from rounds that ended early&#xa;1 &#8212; full build and test suite green&#xa;2 &#8212; stage everything: ?? files are missed by a path-pattern add&#xa;exclude runs/; commit conventions.md and the walkthrough&#xa;3 &#8212; commit, referencing the work item where there is one&#xa;4 &#8212; verify the committed diff &lt;b&gt;by content, not filename&lt;/b&gt;:&#xa;--stat vs round-1/plan.md, &lt;b&gt;then the tree digest vs Phase 8b&lt;/b&gt;&#xa;5 &#8212; push   6 &#8212; PR targets the Phase 0 source branch&#xa;7 &#8212; confirm the PR's file list matches step 4&#xa;8 &#8212; description: what, why, lanes run and skipped, rounds,&#xa;every deferred finding stated honestly, walkthrough link&#xa;9 &#8212; run.md   10 &#8212; one line to index.jsonl, loop:&quot;full&quot;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3238" width="420" height="245" as="geometry" /></mxCell>
        <mxCell id="p9N" value="A file-list comparison catches a &lt;b&gt;missing&lt;/b&gt; file.&#xa;Only the digest catches &lt;b&gt;changed content in a file&lt;/b&gt;&#xa;&lt;b&gt;that is present&lt;/b&gt; &#8212; which is the failure this loop&#xa;is otherwise blind to.&#xa;&#xa;Phase 8 verified the working tree, so its findings still&#xa;hold. &lt;b&gt;But it did not verify the commit&lt;/b&gt;, so steps 2&#xa;and 4 are yours alone and cannot be skipped on the&#xa;grounds that verification passed." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="3285" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="done" value="done" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3543" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="lanes" value="Nine lanes &#8212; one owner per concern. A lane that notices something another lane owns stays silent." style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1473" width="1500" height="380" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop &#8212; the full loop" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Nine gated lanes, one owner per concern, three rounds. Four Opus lanes and five Sonnet. The honest default for most work &#8212; the 1&#215; against which the other four loops are priced." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="lh0" value="Requirements &#8212; opus &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="14" y="42" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg0" value="always" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="14" y="68" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb0" value="change vs the brief: missing requirements, unmet definition of done, unrequested scope, interpretations taken on the user's behalf" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="90" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh1" value="Technical &#8212; opus &#183; xhigh" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="508" y="42" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg1" value="always" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="508" y="68" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb1" value="demonstrable incorrect behaviour caused by this diff: logic, state and lifetime, concurrency, boundaries, error paths, real performance" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="508" y="90" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh2" value="Tests &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="1002" y="42" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg2" value="always" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="1002" y="68" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb2" value="would the tests fail if the code were wrong? mutation testing &lt;b&gt;in the scratch worktree only&lt;/b&gt; &#8212; the strongest finding this lane makes" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1002" y="90" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh3" value="Architecture &#8212; opus &#183; xhigh" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="14" y="134" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg3" value="types moved or responsibilities shifted" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="14" y="160" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb3" value="&lt;b&gt;separation of concerns first and above all&lt;/b&gt;, then dependency direction, placement, coupling, conformance to the architecture in force" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="182" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh4" value="Standards &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="508" y="134" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg4" value="any source file changed" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="508" y="160" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb4" value="rules written in the coding-standards skill or the repo's .claude/standards.md, combined per the skill's precedence section. Nothing else" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="508" y="182" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh5" value="Security &#8212; opus &#183; xhigh" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="1002" y="134" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg5" value="input, authn/authz, secrets, serialization, queries, I/O, deps" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="1002" y="160" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb5" value="injection, authz gaps (especially object-level), secret handling, unsafe deserialization, weak crypto, data exposure, dependency risk" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1002" y="182" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh6" value="Dead code &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="14" y="226" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg6" value="paths removed, replaced, narrowed or refactored" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="14" y="252" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb6" value="proven-unreachable branches, unused private members, orphaned compatibility paths, members whose owning workflow this diff removed" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="274" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh7" value="Minimalism &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="508" y="226" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg7" value="guards, wrappers, config or abstractions added" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="508" y="252" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb7" value="code this diff added that nothing requires. &lt;b&gt;Never recommends removing a permission check, idempotency guard or lock ordering&lt;/b&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="508" y="274" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh8" value="Artifacts &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="1002" y="226" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg8" value="migration, schema, generated file, lockfile, project file or CI changed &#8212; &lt;b&gt;or should have&lt;/b&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="1002" y="252" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb8" value="generated code out of sync, missing or destructive migrations, lockfile drift, new dependencies, build and CI surface" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1002" y="274" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lanesN" value="Every reviewer is read-only apart from its findings and log. Each writes round-N/&lt;lane&gt;.json and round-N/&lt;lane&gt;.log.md and returns &lt;b&gt;one line&lt;/b&gt;: path written and counts by severity.&#xa;&lt;b&gt;Do not read the finding bodies into your own context yet.&lt;/b&gt; The log's &lt;b&gt;dropped&lt;/b&gt; and &lt;b&gt;uncertain&lt;/b&gt; lines are its point &#8212; they are how you tell later whether a lane is too quiet or too noisy." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="14" y="322" width="1470" height="48" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="when"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="when" target="p0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="integ" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8b" target="p9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p9" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="lanes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lanes" target="integ"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="later" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="when" target="whenR"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="it moved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="integ" target="integL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p7" target="p7L"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="loop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p7" target="p7R"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="next round" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#b07a00;" edge="1" parent="1" source="p7R" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" value="PASS: no Critical or Major survived triage and targeted&amp;#xa;validation passes &amp;#8212; or two consecutive Minor-only rounds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8" target="v"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e20" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8" target="p8b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;dashed=1;" edge="1" parent="1" source="v" target="p8b"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="dev-loop-ultra">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="/dev-loop-ultra" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="why" value="&lt;b&gt;Why three agents per lane&lt;/b&gt;&#xa;A single reviewer has &lt;b&gt;one error profile&lt;/b&gt;: whatever it is disposed&#xa;to miss, it misses consistently, and running it again changes nothing.&#xa;Two reviewers on &lt;b&gt;opposed assumptions&lt;/b&gt; have different profiles.&#xa;&lt;b&gt;Their disagreements are where the information is&lt;/b&gt; &#8212; and extracting&#xa;it, by checking the code itself, is the adjudicator's whole job." style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="278" width="420" height="140" as="geometry" /></mxCell>
        <mxCell id="whenL" value="&lt;b&gt;Use ultra when a missed defect is expensive&lt;/b&gt;&#xa;&lt;b&gt;rather than merely annoying:&lt;/b&gt;&#xa;&#8226; payment, billing, anything moving money or goods&#xa;&#8226; auth, permissions, tenant or user data isolation&#xa;&#8226; migrations that alter or destroy existing data&#xa;&#8226; integration contracts other systems depend on&#xa;&#8226; anything where rollback is slow or costly&#xa;&#8226; code you are handing over and will not maintain&#xa;&lt;b&gt;Ultra applied everywhere is not thoroughness, it is expense.&lt;/b&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="268" width="440" height="160" as="geometry" /></mxCell>
        <mxCell id="p02" value="&lt;b&gt;Phases 0&#8211;2 &#8212; Frame, implement, test&lt;/b&gt; &#8212; identical to dev-loop&#xa;frame the slice, record the source branch, write brief.md,&#xa;invoke implementation-notes &#8594; notes.md, then implement and&#xa;test in &lt;b&gt;two handoffs at the normal sidekick tiers&lt;/b&gt;&#xa;both briefs ask the decisions and rejected alternatives back" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="488" width="420" height="125" as="geometry" /></mxCell>
        <mxCell id="p02N" value="&lt;b&gt;Implementation is not changed by this loop.&lt;/b&gt;&#xa;Ultra buys scrutiny of the code, not better code.&#xa;If you want the implementation raised too, that is&#xa;what dev-loop-ultra-opus is for." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="510" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;b&gt;Phase 3 &#8212; Plan the round&lt;/b&gt; &#8212; ROUND = N&#xa;same applicability table as dev-loop &#8594; round-N/plan.md&#xa;snapshot the tree &#8594; plan.md  tree: &lt;sha&gt;&#xa;scratch worktree at round-N/scratch for the Tests pair&#xa;&lt;b&gt;retake and compare after each PAIR of lanes drains,&lt;/b&gt;&#xa;&lt;b&gt;not only at the end of the round&lt;/b&gt; &#8212; with eighteen-plus&#xa;agent runs against one tree, finding out at the end that it&#xa;moved means rerunning far more than one lane" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="673" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;b&gt;Phase 4 &#8212; Adversarial review&lt;/b&gt;&#xa;for each applicable lane, three agents in sequence" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="893" width="420" height="70" as="geometry" /></mxCell>
        <mxCell id="conc" value="&lt;b&gt;Concurrency: two lanes at a time, four reviewers in flight&lt;/b&gt;&#xa;both reviewers for two lanes &#8594; drain &#8594; those two adjudicators&#xa;&#8594; the next pair. Nine lanes at once would put eighteen agents&#xa;in flight and hit concurrency limits long before it saved wall-clock." style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="1678" width="560" height="100" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;b&gt;Phase 5 &#8212; Triage&lt;/b&gt; &#8212; identical to dev-loop&#xa;cluster by locator, gate on evidence and cause, separate&#xa;defect from remedy, check wontfix.json, record durable&#xa;decisions in conventions.md, write round-N/triage.md&#xa;&lt;b&gt;One addition: read each lane's coverage line.&lt;/b&gt;&#xa;A lane reported &lt;b&gt;both thin&lt;/b&gt; was not really reviewed,&#xa;whatever its findings file says &#8212; rerun it before&#xa;trusting the round." style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1838" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="p5N" value="&lt;b&gt;Ultra has a source the single-pass loops do not:&lt;/b&gt;&#xa;&lt;b&gt;the adjudication logs.&lt;/b&gt; A finding prosecution raised&#xa;and the adjudicator dropped, &lt;b&gt;with its reason&lt;/b&gt;, is exactly&#xa;the near-miss worth telling a reviewer about &#8212; append it&#xa;to the Interesting finds in notes.md." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="1868" width="440" height="100" as="geometry" /></mxCell>
        <mxCell id="escR" value="&lt;b&gt;&#8594; escalate to dev-loop-ultra-opus&lt;/b&gt;&#xa;when an adjudicator reports &lt;b&gt;coverage: both thin&lt;/b&gt;&#xa;on a lane owning a Critical, &lt;b&gt;twice&lt;/b&gt;.&#xa;Rarer than escalating into this loop, and stated&#xa;to the user with the cost rather than taken silently." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="1863" width="440" height="110" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;b&gt;Phase 6 &#8212; Fix&lt;/b&gt; &#8212; identical to dev-loop&#xa;accepted findings to a sidekick; for each one with&#xa;would_have_been_bug, the regression test is written and&#xa;&lt;b&gt;confirmed failing before the fix&lt;/b&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2058" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="p7" value="&lt;b&gt;Phase 7 &#8212; loop or exit&lt;/b&gt;&#xa;identical bounds to dev-loop &#8212; &lt;b&gt;3 rounds maximum&lt;/b&gt;, stop on a&#xa;concern raised and fixed twice, on no material progress, or when&#xa;completion needs clarification or redesign&#xa;in round 2+, rerun only the lanes that owned accepted findings&#xa;plus any the fixes newly made applicable &#8212; &lt;b&gt;as full triples&lt;/b&gt;,&#xa;&lt;b&gt;not single passes&lt;/b&gt;: a lane worth rerunning is worth rerunning properly&#xa;&lt;b&gt;Technical still always reruns after a behaviour-changing fix&lt;/b&gt; &#8212; a fix&#xa;can break something no lane raised, and the pair does not make that&#xa;less likely" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2218" width="420" height="185" as="geometry" /></mxCell>
        <mxCell id="p8" value="&lt;b&gt;Phase 8 &#8212; Verification&lt;/b&gt; &#8212; reviewer-verify, opus&#xa;&lt;b&gt;Adversarial review does not replace it.&lt;/b&gt; The pair checks&#xa;the code; verification checks that the accumulated fixes&#xa;still do what was asked." style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2463" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="p8b" value="&lt;b&gt;Phase 8b &#8212; Walkthrough&lt;/b&gt; &#8212; as dev-loop, in full&#xa;author from notes.md, review with pr-walkthrough-review,&#xa;then retake the snapshot as the Phase 9 baseline&#xa;&lt;b&gt;One addition: the per-lane raised_p / raised_d / kept counts&lt;/b&gt;&#xa;go into the notes' Reviewers section" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2623" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p9" value="&lt;b&gt;Phase 9 &#8212; Commit, push, pull request&lt;/b&gt; &#8212; as dev-loop, in full&#xa;&lt;b&gt;including the staging and commit-verification steps&lt;/b&gt;&#xa;stage untracked files explicitly, confirm the committed diff&#xa;matches the reviewed file list &lt;b&gt;and the tree digest&lt;/b&gt;, push,&#xa;and confirm the PR's file list matches&#xa;&lt;b&gt;Three agents per lane approved a working tree.&lt;/b&gt;&#xa;&lt;b&gt;None of them approved a commit.&lt;/b&gt;&#xa;index line: loop:&quot;ultra&quot;, plus raised_p / raised_d / kept per lane;&#xa;the PR description states that this was an adversarial run" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2798" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="done" value="done" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3218" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="triple" value="One lane, three agents &#8212; repeated for every applicable lane" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1023" width="1500" height="330" as="geometry" /></mxCell>
        <mxCell id="tiers" value="Model per lane &#8212; passed on every invocation, never left to the agent file's default" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1413" width="1500" height="205" as="geometry" /></mxCell>
        <mxCell id="health" value="Reading the ratio &#8212; the health signal this loop exists to produce" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="3028" width="1500" height="130" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-ultra &#8212; the adversarial loop" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="The same nine lanes as dev-loop, but each is reviewed twice on opposed assumptions and reconciled by a third agent. Roughly 3&#215; the review cost. Implementation is unchanged &#8212; ultra buys scrutiny, not code." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="tp" value="&lt;b&gt;reviewer-ultra-prosecution&lt;/b&gt;&#xa;&lt;b&gt;assumes the code is broken&lt;/b&gt; and something is&#xa;there to find &#8212; optimised for &lt;b&gt;recall&lt;/b&gt;&#xa;writes &lt;lane&gt;.prosecution.json + .log.md" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="triple"><mxGeometry x="40" y="50" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="tdf" value="&lt;b&gt;reviewer-ultra-defence&lt;/b&gt;&#xa;&lt;b&gt;assumes the code is correct&lt;/b&gt;, raising only what&#xa;it can demonstrate &#8212; optimised for &lt;b&gt;precision&lt;/b&gt;&#xa;writes &lt;lane&gt;.defence.json + .log.md" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="triple"><mxGeometry x="40" y="170" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="tblind" value="&lt;b&gt;The pair runs in parallel and blind to each other.&lt;/b&gt; Neither output is ever used directly &#8212; not by the other reviewer, and not by the lead." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;" vertex="1" parent="triple"><mxGeometry x="40" y="282" width="620" height="34" as="geometry" /></mxCell>
        <mxCell id="tadj" value="&lt;b&gt;reviewer-ultra-adjudicator&lt;/b&gt;&#xa;runs once both have returned. Reads both findings files,&#xa;both logs, and &lt;b&gt;the code itself&lt;/b&gt;, and produces the lane's&#xa;single authoritative set: &lt;lane&gt;.json + &lt;lane&gt;.adjudication.log.md&#xa;&#8212; including the &lt;b&gt;coverage&lt;/b&gt; line" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="triple"><mxGeometry x="670" y="110" width="440" height="100" as="geometry" /></mxCell>
        <mxCell id="tread" value="&lt;b&gt;What the lead reads:&lt;/b&gt;&#xa;&lt;b&gt;only &lt;lane&gt;.json&lt;/b&gt;&#xa;and the coverage line.&#xa;Never prosecution or&#xa;defence &#8212; they are inputs&#xa;to adjudication, not to you.&#xa;Reading them puts back&#xa;exactly the noise the&#xa;adjudicator was paid&#xa;to remove." style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="triple"><mxGeometry x="1140" y="50" width="330" height="220" as="geometry" /></mxCell>
        <mxCell id="ti0" value="requirements&lt;br&gt;opus" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="tiers"><mxGeometry x="20" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti1" value="technical&lt;br&gt;opus" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="tiers"><mxGeometry x="312" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti2" value="architecture&lt;br&gt;opus" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="tiers"><mxGeometry x="604" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti3" value="security&lt;br&gt;opus" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="tiers"><mxGeometry x="896" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti4" value="standards&lt;br&gt;sonnet" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="1188" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti5" value="tests&lt;br&gt;sonnet" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="20" y="96" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti6" value="deadcode&lt;br&gt;sonnet" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="312" y="96" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti7" value="minimalism&lt;br&gt;sonnet" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="604" y="96" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti8" value="artifacts&lt;br&gt;sonnet" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="896" y="96" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="tiersN" value="&lt;b&gt;All three agents in a lane use the same tier, and the tier is the one dev-loop gives that lane.&lt;/b&gt; If you cannot pass model per invocation &#8212; the tool is unavailable, the parameter is rejected &#8212; &lt;b&gt;stop and say so&lt;/b&gt;: a technical lane silently reviewed at Sonnet is not the loop the user asked for.&#xa;&lt;b&gt;Effort is NOT passable.&lt;/b&gt; The Agent tool has a model parameter and no effort parameter, so effort is whatever the agent file declares &#8212; &lt;b&gt;high&lt;/b&gt; for all three ultra reviewers. The four Opus lanes therefore run at Opus &lt;b&gt;high&lt;/b&gt;, not xhigh. Say that in run.md rather than reporting a tier the run did not have. Never edit the agent files mid-run to work around it." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="tiers"><mxGeometry x="20" y="148" width="1460" height="48" as="geometry" /></mxCell>
        <mxCell id="hs0" value="Prosecution raises many, few survive" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="health"><mxGeometry x="20" y="44" width="476" height="34" as="geometry" /></mxCell>
        <mxCell id="hm0" value="it is running hot &#8212; or defence's dismissals are being accepted too readily" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;dashed=0;fillColor=#ffffff;" vertex="1" parent="health"><mxGeometry x="20" y="78" width="476" height="42" as="geometry" /></mxCell>
        <mxCell id="hs1" value="Defence raises almost nothing, across several runs" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="health"><mxGeometry x="512" y="44" width="476" height="34" as="geometry" /></mxCell>
        <mxCell id="hm1" value="&lt;b&gt;it has drifted into agreeableness.&lt;/b&gt; The pair's most common failure and the hardest to see, because it looks like clean code" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;dashed=0;fillColor=#ffffff;" vertex="1" parent="health"><mxGeometry x="512" y="78" width="476" height="42" as="geometry" /></mxCell>
        <mxCell id="hs2" value="Both agree on nearly everything" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="health"><mxGeometry x="1004" y="44" width="476" height="34" as="geometry" /></mxCell>
        <mxCell id="hm2" value="the stances are not actually opposed, and you are paying three times for one reviewer's opinion" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;dashed=0;fillColor=#ffffff;" vertex="1" parent="health"><mxGeometry x="1004" y="78" width="476" height="42" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;entryX=0;entryY=0.35;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tp" target="tadj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;entryX=0;entryY=0.65;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tdf" target="tadj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tadj" target="tread"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="why"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="why" target="p02"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p02" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="conc" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8" target="p8b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8b" target="p9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p9" target="health"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="health" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="triple"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="triple" target="tiers"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tiers" target="conc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" value="twice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5" target="escR"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="ROUND + 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#b07a00;" edge="1" parent="1" source="p7" target="p3"><mxGeometry x="-0.88" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="dev-loop-ultra-opus">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="/dev-loop-ultra-opus" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="base" value="&lt;b&gt;Follow the dev-loop-ultra skill in full.&lt;/b&gt;&#xa;Every phase, bound, format and rule is the same &#8212; Phase 0's&#xa;implementation-notes and Phase 8b's walkthrough included.&#xa;&lt;b&gt;Read dev-loop-ultra/SKILL.md and work from it.&lt;/b&gt;&#xa;&lt;b&gt;Do not reimplement its phases from this file.&lt;/b&gt;&#xa;&#xa;Frame &#8594; implement &#8594; test &#8594; plan + snapshot &#8594; nine lanes, each as&#xa;prosecution &#124; defence &#8594; adjudicator &#8594; triage &#8594; fix &#8594; loop (3 rounds)&#xa;&#8594; verify &#8594; walkthrough &#8594; commit, push, PR" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="185" as="geometry" /></mxCell>
        <mxCell id="baseN" value="&lt;b&gt;This file changes two things and nothing else.&lt;/b&gt;&#xa;Everything below is a delta on the ultra loop, not&#xa;a loop in its own right. If you find yourself&#xa;restating an ultra phase here, stop and go read it." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="315" width="440" height="90" as="geometry" /></mxCell>
        <mxCell id="effort" value="&lt;b&gt;Effort is NOT raised, because it cannot be passed.&lt;/b&gt;&#xa;The Agent tool has a &lt;b&gt;model&lt;/b&gt; parameter and no &lt;b&gt;effort&lt;/b&gt; parameter, so a lane's&#xa;effort is whatever its agent file declares &#8212; &lt;b&gt;high&lt;/b&gt; for all three ultra reviewers.&#xa;&lt;b&gt;This loop buys a uniformly higher model tier, not a higher effort tier.&lt;/b&gt;&#xa;Say that in run.md rather than reporting xhigh lanes the run did not have.&#xa;The sidekicks are the exception, and not by accident: &lt;b&gt;sidekick-heavy is a distinct&lt;/b&gt;&#xa;&lt;b&gt;agent file that declares effort: xhigh itself&lt;/b&gt;, so routing to it gets you both.&#xa;That is the pattern to follow if xhigh reviewers are ever wanted &#8212; dedicated&#xa;agent files, not a parameter that does not exist." style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="893" width="700" height="170" as="geometry" /></mxCell>
        <mxCell id="just" value="&lt;b&gt;When this loop is justified&lt;/b&gt;&#xa;dev-loop-ultra already covers changes where a missed defect is expensive.&#xa;Reach past it to this one &lt;b&gt;only when the cost of being wrong is severe and&lt;/b&gt;&#xa;&lt;b&gt;largely irreversible&lt;/b&gt;:&#xa;&#8226; a migration that alters or destroys production data&#xa;&#8226; auth or tenant-isolation logic where a defect exposes other people's data&#xa;&#8226; money movement, settlement, or anything with a regulatory consequence&#xa;&#8226; a contract other organisations build against and cannot easily be asked to change&#xa;&#8226; code being handed to someone who will not be able to fix it&#xa;&#xa;&lt;b&gt;For anything less, dev-loop-ultra is the honest choice, and dev-loop is the&lt;/b&gt;&#xa;&lt;b&gt;honest default. Escalating past the point where the loop changes the&lt;/b&gt;&#xa;&lt;b&gt;outcome is spending, not diligence.&lt;/b&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="1373" width="760" height="210" as="geometry" /></mxCell>
        <mxCell id="idx" value="&lt;b&gt;Index line: loop:&quot;ultra-opus&quot;&lt;/b&gt;&#xa;Keep the same per-lane &lt;b&gt;raised_p / raised_d / kept&lt;/b&gt; counts and the same&#xa;&lt;b&gt;walkthrough&lt;/b&gt; field as every other loop.&#xa;Comparing those against ultra runs is how you find out whether the Opus&#xa;lanes actually change the findings &lt;b&gt;or only the bill&lt;/b&gt;.&#xa;That is worth knowing, and nobody can tell you without the data." style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="1643" width="700" height="130" as="geometry" /></mxCell>
        <mxCell id="done" value="done" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="1833" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="c1" value="Change 1 &#8212; every subagent runs on Opus, review lanes and implementation alike" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="513" width="1500" height="320" as="geometry" /></mxCell>
        <mxCell id="c2" value="Change 2 &#8212; concurrency drops to one lane at a time" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1123" width="1500" height="190" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-ultra-opus &#8212; adversarial, every subagent on Opus" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Structurally identical to dev-loop-ultra. It changes exactly two things: the model on every agent, and the concurrency. Roughly 4&#215; the review cost of a full run, and 2.7&#215; the run as a whole &#8212; the most expensive loop available." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="c1h0" value="Agent" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=10;fillColor=#0f3355;fontColor=#ffffff;" vertex="1" parent="c1"><mxGeometry x="20" y="42" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1h1" value="Model" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=10;fillColor=#0f3355;fontColor=#ffffff;" vertex="1" parent="c1"><mxGeometry x="444" y="42" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1h2" value="Effort &#8212; and where it comes from" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=10;fillColor=#0f3355;fontColor=#ffffff;" vertex="1" parent="c1"><mxGeometry x="748" y="42" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a0" value="reviewer-ultra-prosecution" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="20" y="72" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m0" value="opus &#8212; &lt;b&gt;passed&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="444" y="72" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e0" value="high &#8212; declared in the agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="748" y="72" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a1" value="reviewer-ultra-defence" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="20" y="102" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m1" value="opus &#8212; &lt;b&gt;passed&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="444" y="102" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e1" value="high &#8212; declared in the agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="748" y="102" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a2" value="reviewer-ultra-adjudicator" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="20" y="132" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m2" value="opus &#8212; &lt;b&gt;passed&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="444" y="132" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e2" value="high &#8212; declared in the agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="c1"><mxGeometry x="748" y="132" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a3" value="reviewer-verify" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#dcefe3;" vertex="1" parent="c1"><mxGeometry x="20" y="162" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m3" value="opus &#8212; its own default" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#dcefe3;" vertex="1" parent="c1"><mxGeometry x="444" y="162" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e3" value="high &#8212; declared in the agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#dcefe3;" vertex="1" parent="c1"><mxGeometry x="748" y="162" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a4" value="Implementation sidekick" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="20" y="192" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m4" value="&lt;b&gt;sidekick-heavy&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="444" y="192" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e4" value="&lt;b&gt;xhigh&lt;/b&gt; &#8212; declared in that agent file" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="748" y="192" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a5" value="Test-writing sidekick" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="20" y="222" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m5" value="&lt;b&gt;sidekick-heavy&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="444" y="222" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e5" value="&lt;b&gt;xhigh&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="748" y="222" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1a6" value="Fix sidekick" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=left;spacingLeft=8;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="20" y="252" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1m6" value="&lt;b&gt;sidekick-heavy&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="444" y="252" width="300" height="26" as="geometry" /></mxCell>
        <mxCell id="c1e6" value="&lt;b&gt;xhigh&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="c1"><mxGeometry x="748" y="252" width="420" height="26" as="geometry" /></mxCell>
        <mxCell id="c1n" value="&lt;b&gt;The lane table in dev-loop-ultra is superseded&lt;/b&gt;&#xa;&lt;b&gt;in one respect only: no lane drops to Sonnet.&lt;/b&gt;&#xa;Every reviewer runs on Opus.&#xa;&#xa;&lt;b&gt;Implementation is on Opus here too&lt;/b&gt;, unlike every&#xa;other loop. If you are paying for adversarial review&#xa;at this tier, having the code written a tier below&#xa;the reviewers is a false economy.&#xa;&#xa;&lt;b&gt;If you cannot pass a model per invocation, stop&lt;/b&gt;&#xa;&lt;b&gt;and say so.&lt;/b&gt; Running silently at default tiers gives&#xa;the user the cost profile they did not ask for and&#xa;the scrutiny they did." style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="c1"><mxGeometry x="1180" y="42" width="300" height="240" as="geometry" /></mxCell>
        <mxCell id="c2u" value="&lt;b&gt;dev-loop-ultra&lt;/b&gt;&#xa;two lanes at a time&#xa;four reviewers in flight&#xa;then the two adjudicators" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;" vertex="1" parent="c2"><mxGeometry x="40" y="50" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="c2o" value="&lt;b&gt;dev-loop-ultra-opus&lt;/b&gt;&#xa;&lt;b&gt;ONE lane at a time&lt;/b&gt;&#xa;prosecution and defence in parallel,&#xa;then that lane's adjudicator,&#xa;then the next lane" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;" vertex="1" parent="c2"><mxGeometry x="520" y="50" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="c2n" value="Two Opus reviewers plus an adjudicator is&#xa;already a heavy concurrent load.&#xa;&lt;b&gt;This makes ultra-opus considerably slower in&lt;/b&gt;&#xa;&lt;b&gt;wall-clock than dev-loop-ultra. That is the trade&lt;/b&gt;&#xa;&lt;b&gt;being made; do not widen the concurrency to&lt;/b&gt;&#xa;&lt;b&gt;recover it.&lt;/b&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="c2"><mxGeometry x="1000" y="50" width="460" height="90" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="base"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="c2" target="just"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="just" target="idx"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="idx" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="base" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="effort"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="effort" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="becomes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2u" target="c2o"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="dev-loop-lite">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="/dev-loop-lite" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="wrong" value="&lt;b&gt;Is this the wrong loop?&lt;/b&gt;&#xa;Stop and use the full dev-loop if &lt;b&gt;any&lt;/b&gt; holds:&#xa;&#8226; the diff touches authn/authz, secrets or untrusted input&#xa;&#8226; a migration, schema or public API contract changes&#xa;&#8226; more than one project in the solution is modified&#xa;&#8226; it ships on a path you cannot easily roll back" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="wrongL" value="&lt;b&gt;&#8594; dev-loop (full)&lt;/b&gt;&#xa;If you are unsure, use the full loop.&#xa;The savings are not worth a missed Critical." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="293" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="p0" value="&lt;b&gt;Phase 0 &#8212; Frame the slice&lt;/b&gt;&#xa;requirement, non-goals, constraints, entry points,&#xa;definition of done, &lt;b&gt;and the source branch the PR targets&lt;/b&gt;&#xa;create the run directory + brief.md &#8212; reviewers read it&#xa;invoke implementation-notes &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="458" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1" value="&lt;b&gt;Phase 1 &#8212; Implement&lt;/b&gt;&#xa;&lt;b&gt;implementation is NOT downgraded in this loop&lt;/b&gt;&#xa;sidekick by default &#8226; sidekick-lite only if mechanical&#xa;sidekick-heavy when a constraint needs real reasoning&#xa;the brief asks the reasoning back &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="633" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1N" value="Cheaper scrutiny of carefully written code is a&#xa;reasonable trade. &lt;b&gt;Cheap code reviewed cheaply is not.&lt;/b&gt;&#xa;Reaching for sidekick-heavy is a soft signal to&#xa;re-read the loop-selection criteria." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="650" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="p2" value="&lt;b&gt;Phase 2 &#8212; Tests&lt;/b&gt; &#8212; a second handoff&#xa;unit tests for logic and boundaries, integration tests for&#xa;anything crossing a process or service edge, UI tests for&#xa;visible behaviour &#8212; each must fail if behaviour regresses&#xa;decisions and rejected alternatives &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="808" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;b&gt;Phase 3 &#8212; Plan the round&lt;/b&gt; &#8212; ROUND = N&#xa;classify every lane &lt;b&gt;applicable or skipped with a&lt;/b&gt;&#xa;&lt;b&gt;diff-based reason&lt;/b&gt;, into round-N/plan.md, before&#xa;spawning anything &#8212; &quot;the code looks fine&quot; is never a skip&#xa;then snapshot the tree &#8594; plan.md  tree: &lt;sha&gt;&#xa;and create round-N/scratch for the Tests lane" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="983" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p3N" value="The snapshot and the scratch worktree are the&#xa;&lt;b&gt;lead's&lt;/b&gt; job, not a reviewer's. A lane that made its&#xa;own scratch space would be making it from a tree&#xa;it has just been told not to touch." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1008" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;b&gt;Phase 4 &#8212; Delegate&lt;/b&gt;&#xa;spawn the applicable lanes &lt;b&gt;in parallel, in one turn&lt;/b&gt;&#xa;&#8212; four fit in a single batch, no waves needed&#xa;each gets: card name and path, run dir and round, diff base,&#xa;changed files, brief path, validation commands&#xa;the Tests lane also gets the scratch worktree path" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1173" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="integ" value="all four drained &#8212; retake the&#xa;snapshot: did the tree move?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="1673" width="340" height="130" as="geometry" /></mxCell>
        <mxCell id="integL" value="&lt;b&gt;a reviewer wrote to the tree under review&lt;/b&gt;&#xa;stop, restore, rerun that lane. Four lanes reading&#xa;one tree concurrently is exactly the situation&#xa;this check exists for &#8212; do not assess whether&#xa;the mutation looked harmless." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1688" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;b&gt;Phase 5 &#8212; Triage&lt;/b&gt;&#xa;1 &#8212; cluster by locator and cause; one owning lane each&#xa;2 &#8212; evidence gate: inferred alone never blocks&#xa;3 &#8212; cause gate: introduced / worsened /&#xa;missing-required fixed; stale recorded&#xa;4 &#8212; defect &#8800; remedy: smallest fix, intent preserved&#xa;5 &#8212; wontfix.json  6 &#8212; conventions.md&#xa;write round-N/triage.md, classify every rejection" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1863" width="420" height="155" as="geometry" /></mxCell>
        <mxCell id="p5N" value="&lt;b&gt;Consolidation makes the rejection split matter more,&lt;/b&gt;&#xa;&lt;b&gt;not less&lt;/b&gt; &#8212; a merged lane's total rejection rate blends&#xa;four concerns and tells you nothing on its own.&#xa;Correctness owns the brief here, so &lt;b&gt;its&lt;/b&gt; findings go to&#xa;notes.md whether accepted or rejected." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="1890" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="esc" value="any Critical&#xa;in round 1?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="2078" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="escL" value="&lt;b&gt;abandon this loop &#8212; restart under dev-loop (full)&lt;/b&gt;&#xa;Not a coverage argument: these four lanes &lt;b&gt;do&lt;/b&gt; cover all&#xa;nine concerns. What they lack is &lt;b&gt;depth and tiering&lt;/b&gt; &#8212;&#xa;Sonnet and Haiku not four Opus lanes, two rounds not three,&#xa;verification usually skipped. Do not fix it here and carry on." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2078" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;b&gt;Phase 6 &#8212; Fix&lt;/b&gt;&#xa;one brief to sidekick, or sidekick-heavy if it needs judgment&#xa;&lt;b&gt;fixes are not downgraded either&lt;/b&gt;&#xa;would_have_been_bug &#8594; failing test FIRST, confirm it fails,&#xa;apply the fix, confirm it passes &#8212; that order, stated in the brief&#xa;then the smallest relevant validation, not the whole suite" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2248" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p7" value="&lt;b&gt;Phase 7 &#8212; loop or exit&lt;/b&gt;&#xa;remove the scratch worktree,&#xa;retake the snapshot" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="2438" width="360" height="140" as="geometry" /></mxCell>
        <mxCell id="p7L" value="&lt;b&gt;BLOCKED &#8212; stop and report&lt;/b&gt;&#xa;ROUND would exceed &lt;b&gt;2&lt;/b&gt; &#8226; the same concern raised&#xa;and fixed twice &#8226; a round with no material progress&#xa;&#8226; completion needs clarification or redesign&#xa;&lt;b&gt;A lite change that cannot converge in two rounds&lt;/b&gt;&#xa;&lt;b&gt;is not a lite change.&lt;/b&gt; Switch loops, do not add a round." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2448" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p7R" value="&lt;b&gt;ROUND + 1 &#8594; back to Phase 3&lt;/b&gt;&#xa;rerun only the lanes that owned accepted findings,&#xa;plus Correctness after any behaviour-changing fix" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="2468" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="p8" value="&lt;b&gt;Phase 8 &#8212; Verification&lt;/b&gt;&#xa;a Critical, or a Major with&#xa;would_have_been_bug, fixed?&#xa;or did artifacts change?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="2638" width="380" height="150" as="geometry" /></mxCell>
        <mxCell id="p8R" value="&lt;b&gt;no &#8212; skip it, and say so in run.md&lt;/b&gt;&#xa;A skipped phase that is not recorded&#xa;reads as a phase that was forgotten." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="2678" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="v" value="&lt;b&gt;reviewer-verify&lt;/b&gt; &#8212; opus, high&#xa;&lt;b&gt;stays on Opus deliberately: the last gate before a human&lt;/b&gt;&#xa;does the final diff preserve intent? does validation match&#xa;the touched behaviour? did required checks run?&#xa;do the deferrals have concrete reasons?&#xa;&lt;b&gt;NOT a re-review of the diff&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2648" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p8b" value="&lt;b&gt;Phase 8b &#8212; Walkthrough&lt;/b&gt;&#xa;1 &#8212; author: sidekick drafts from &lt;b&gt;notes.md, not the diff&lt;/b&gt;&#xa;2 &#8212; review: a second sidekick applies pr-walkthrough-review,&#xa;write-capable on the walkthrough file alone&#xa;3 &#8212; retake the snapshot &#8212; &lt;b&gt;this is the Phase 9 baseline&lt;/b&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2848" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p8bN" value="Step 3 is &lt;b&gt;not&lt;/b&gt; bookkeeping. The walkthrough is a new file&#xa;under docs/, which is not gitignored, so it changes the digest&#xa;&#8212; and Phase 9 stops the run when the digest differs from the&#xa;baseline. Without it, &lt;b&gt;every run halts there.&lt;/b&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="2868" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="p9" value="&lt;b&gt;Phase 9 &#8212; Commit, push, pull request&lt;/b&gt;&#xa;0 &#8212; remove every scratch worktree from this run&#xa;1 &#8212; full build and test suite green&#xa;2 &#8212; stage everything: ?? files are missed by a path-pattern add&#xa;exclude runs/, commit conventions.md and the walkthrough&#xa;3 &#8212; commit   4 &#8212; verify &lt;b&gt;--stat AND the tree digest&lt;/b&gt;&#xa;5 &#8212; push   6 &#8212; PR targets the Phase 0 source branch&#xa;7 &#8212; confirm the PR file list matches step 4&#xa;8 &#8212; description says &lt;b&gt;this was a lite run&lt;/b&gt; + links the walkthrough&#xa;9 &#8212; run.md + index.jsonl with loop:&quot;lite&quot;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3028" width="420" height="185" as="geometry" /></mxCell>
        <mxCell id="p9N" value="Same files with different contents produce an&#xa;&lt;b&gt;identical --stat&lt;/b&gt;. Only the tree digest catches&#xa;content that moved between the last review&#xa;and the commit." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="3080" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="done" value="done" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3273" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="lanes" value="The four consolidated lanes &#8212; nine concerns compressed into four contexts" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1363" width="1500" height="250" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-lite" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Four consolidated lanes, two rounds, verification only when it is earned. Review cost ≈ 0.3&#215; a full run. The lite loop economises on review, never on the code." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="ln0" value="Correctness &#8212; sonnet, high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fillColor=#e7eef5;" vertex="1" parent="lanes"><mxGeometry x="14" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb0" value="&lt;b&gt;always applicable&lt;/b&gt;&#xa;requirements conformance to the brief,&#xa;technical defects, &lt;b&gt;and artifacts&lt;/b&gt;&#xa;(migrations, lockfiles, generated code)&#xa;&#8212; three full-loop lanes in one pass" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="ln1" value="Structure &#8212; sonnet, high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fillColor=#e7eef5;" vertex="1" parent="lanes"><mxGeometry x="386" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb1" value="&lt;b&gt;always applicable&lt;/b&gt;&#xa;&lt;b&gt;separation of concerns FIRST&lt;/b&gt;, then&#xa;architecture in force, coding-standards&#xa;+ .claude/standards.md, surplus additions&#xa;and dead code &#8212; four lanes in one pass" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="386" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="ln2" value="Tests &#8212; &lt;b&gt;haiku&lt;/b&gt;, high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fillColor=#e7eef5;" vertex="1" parent="lanes"><mxGeometry x="758" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb2" value="&lt;b&gt;always applicable&lt;/b&gt;&#xa;would the tests fail if the code were&#xa;wrong? assertion quality, error paths,&#xa;over-mocking, missing negatives&#xa;mutation testing in the scratch worktree only" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="758" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="ln3" value="Security &#8212; sonnet, high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fillColor=#fbf0d5;" vertex="1" parent="lanes"><mxGeometry x="1130" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb3" value="&lt;b&gt;gated&lt;/b&gt;: input handling, queries,&#xa;serialization, file or network I/O,&#xa;or dependencies&#xa;&lt;b&gt;if it touches authn/authz or secrets&lt;/b&gt;&#xa;&lt;b&gt;you are in the wrong loop&lt;/b&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1130" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="lanesN" value="Each lane reads &lt;b&gt;only its own card&lt;/b&gt; and stays silent on anything another lane owns. Each writes round-N/&lt;lane&gt;.json and round-N/&lt;lane&gt;.log.md,&#xa;and returns &lt;b&gt;one line&lt;/b&gt; to the lead: path written and counts by severity. Reviewers are read-only &#8212; they never call Edit and never fix." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="14" y="190" width="1470" height="48" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="wrong"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="wrong" target="p0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="integ" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5" target="esc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="esc" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8b" target="p9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p9" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4" target="lanes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lanes" target="integ"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="any holds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="wrong" target="wrongL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="integ" target="integL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="esc" target="escL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p7" target="p7L"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" value="round 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p7" target="p7R"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" value="next round" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#b07a00;" edge="1" parent="1" source="p7R" target="p3"><mxGeometry x="-0.9" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell>
        <mxCell id="e20" value="pass: no Critical or Major survived&amp;#xa;and targeted validation is green" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8" target="v"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p8" target="p8b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;dashed=1;" edge="1" parent="1" source="v" target="p8b"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="dev-loop-ultralight">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="/dev-loop-ultralight" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="elig" value="&lt;b&gt;Eligibility &#8212; checked before anything else&lt;/b&gt;&#xa;ALL of these must hold:&#xa;&#8226; one project, roughly five files or fewer&#xa;&#8226; no authn/authz, secrets, or untrusted input&#xa;&#8226; no migration, schema, generated artifact or public contract&#xa;&#8226; no concurrency, async ordering or transaction boundary&#xa;&#8226; no new dependency&#xa;&#8226; easy to roll back" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="eligL" value="&lt;b&gt;any ONE fails&lt;/b&gt;&#xa;&#8594; dev-loop-lite" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="313" width="420" height="70" as="geometry" /></mxCell>
        <mxCell id="eligR" value="&lt;b&gt;several fail, or you are unsure&lt;/b&gt;&#xa;&#8594; dev-loop (full)" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="313" width="420" height="70" as="geometry" /></mxCell>
        <mxCell id="eligN" value="The eligibility list is the &lt;b&gt;entire&lt;/b&gt; safety&#xa;mechanism of this loop. Nothing downstream will&#xa;catch a change that should not have been here." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="p0" value="&lt;b&gt;Phase 0 &#8212; Frame&lt;/b&gt;&#xa;one short paragraph: what changes, what must not,&#xa;which files, definition of done, &lt;b&gt;SOURCE BRANCH&lt;/b&gt;&#xa;create .claude/review/runs/&lt;run-id&gt;/ + brief.md&#xa;invoke implementation-notes &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="488" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1" value="&lt;b&gt;Phase 1 &#8212; Implement AND test&lt;/b&gt;&#xa;&lt;b&gt;ONE handoff, not two&lt;/b&gt; &#8212; unlike every other loop&#xa;sidekick by default; sidekick-lite only if mechanical&#xa;tests still required: each must fail if behaviour regresses&#xa;the brief asks the reasoning back &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="663" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1N" value="Reaching for &lt;b&gt;sidekick-heavy&lt;/b&gt; here is a&#xa;strong sign you are in the wrong loop." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="692" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="snap" value="&lt;b&gt;Snapshot the working tree&lt;/b&gt;&#xa;record in round-1/plan.md as  tree: &lt;sha&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="838" width="420" height="60" as="geometry" /></mxCell>
        <mxCell id="p2" value="&lt;b&gt;Phase 2 &#8212; Review&lt;/b&gt;&#xa;spawn &lt;b&gt;reviewer-ultralight&lt;/b&gt; ONCE &#8212; sonnet, effort high&#xa;read-only; writes round-1/ultralight.json + .log.md&#xa;returns one line: path, counts, items covered out of nine" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="958" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="p2N" value="&lt;b&gt;No scratch worktree.&lt;/b&gt;&#xa;No mutation testing in this loop &#8212;&#xa;a suite you must break to trust&#xa;belongs in a loop with a second round." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="968" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="chk" value="re-snapshot:&#xa;did the tree move?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="1118" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="chkL" value="&lt;b&gt;a reviewer wrote to the code it reviewed&lt;/b&gt;&#xa;restore the tree and rerun &#8212; the findings&#xa;describe a tree that no longer exists" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1133" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;b&gt;Phase 3 &#8212; Triage &#8212; the lead is the arbiter&lt;/b&gt;&#xa;1 &#8212; evidence gate: inferred alone never blocks&#xa;2 &#8212; cause gate: introduced / worsened /&#xa;missing-required are fixed; stale is recorded&#xa;3 &#8212; defect &#8800; remedy: smallest fix, intent preserved&#xa;4 &#8212; wontfix.json &#8212; dies with the run&#xa;5 &#8212; conventions.md &#8212; survives to the next run&#xa;write round-1/triage.md, classifying every rejection&#xa;stale &#124; evidence &#124; remedy &#124; &lt;b&gt;wrong&lt;/b&gt;&#xa;&#8212; only &lt;b&gt;wrong&lt;/b&gt; counts against the reviewer" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1288" width="420" height="180" as="geometry" /></mxCell>
        <mxCell id="p3N" value="Requirements findings go to &lt;b&gt;notes.md whether&#xa;accepted or rejected&lt;/b&gt;. A rejected one says the brief&#xa;was ambiguous, or was read differently than the&#xa;implementer read it &#8212; which a reviewer needs told." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1338" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="esc" value="any escalation&#xa;trigger?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="1528" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="escL" value="&lt;b&gt;&#8594; dev-loop (full)&lt;/b&gt;&#xa;any Critical, or a Major in&#xa;security, architecture or concurrency" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1543" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="escR" value="&lt;b&gt;&#8594; dev-loop-lite&lt;/b&gt;&#xa;any other Major &#8226; more than four accepted findings&#xa;&#8226; the reviewer reports a concern it could not cover" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="1543" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="escN" value="&lt;b&gt;Escalation is mandatory and one-way.&lt;/b&gt;&#xa;Do not fix and carry on: a trivial change that&#xa;produced a Major was not trivial, and these&#xa;concerns had a ninth of the usual attention." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="1715" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;b&gt;Phase 4 &#8212; Fix&lt;/b&gt;&#xa;one brief to sidekick &#8212; reviewers never edit&#xa;would_have_been_bug &#8594; write the failing test FIRST,&#xa;confirm it fails, apply the fix, confirm it passes&#xa;then run the relevant tests, lint and build" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1698" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;b&gt;Phase 5 &#8212; Exit&lt;/b&gt;&#xa;did the fixes clear it?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="1873" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="p5L" value="&lt;b&gt;no, or the fix introduced something new&lt;/b&gt;&#xa;&#8594; dev-loop-lite. There is &lt;b&gt;no second round&lt;/b&gt;:&#xa;one reviewer looking twice at its own&#xa;missed work is not independent." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1888" width="340" height="90" as="geometry" /></mxCell>
        <mxCell id="p5R" value="&lt;b&gt;There is no verification phase.&lt;/b&gt;&#xa;Anything risky enough to warrant one&#xa;has already triggered escalation." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950" y="1898" width="360" height="70" as="geometry" /></mxCell>
        <mxCell id="p5b" value="&lt;b&gt;Phase 5b &#8212; Walkthrough&lt;/b&gt;&#xa;pr-walkthrough drafted by sidekick &lt;b&gt;from notes.md, not the diff&lt;/b&gt;&#xa;&lt;b&gt;the lead checks it inline&lt;/b&gt; &#8212; this loop alone spawns no&#xa;pr-walkthrough-review; a change this small does not justify one&#xa;retake the snapshot &#8212; it is the Phase 6 baseline" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2053" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;b&gt;Phase 6 &#8212; Commit, push, pull request&lt;/b&gt;&#xa;stage untracked files too &#8212; ?? is missed by a path-pattern add&#xa;verify BOTH: --stat against the sweep, and the tree digest&#xa;PR targets the Phase 0 source branch, never the repo default&#xa;description says plainly: &lt;b&gt;ultralight, one review pass&lt;/b&gt;&#xa;run.md + one line to index.jsonl with loop:&quot;ultralight&quot;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2228" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="done" value="done" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="2418" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="sweep" value="The sweep &#8212; every item, in order, every time" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="938" width="620" height="404" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-ultralight" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="One reviewer, one round, no verification phase &#8212; a nine-concern sweep in a single pass. Review cost ≈ 0.1&#215; a full run. Implementation is NOT downgraded." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sw0" value="1 &#8212; Requirements: does it do what the brief asked, and nothing more?" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="40" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw1" value="2 &#8212; Correctness: logic, inverted conditions, boundaries, second call" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="72" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw2" value="3 &#8212; Error paths: dependency throws, times out, returns partial" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="104" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw3" value="4 &#8212; &lt;b&gt;Separation of concerns &#8212; do not compress this one&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="136" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw4" value="5 &#8212; Placement: repo convention; inferred evidence can never block" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="168" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw5" value="6 &#8212; Standards: coding-standards skill + .claude/standards.md only" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="200" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw6" value="7 &#8212; Security: authz or untrusted input here = wrong loop, say so" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="232" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw7" value="8 &#8212; Tests: would they fail if the code were wrong?" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="264" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw8" value="9 &#8212; Surplus: guards, wrappers, config nothing requires" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="296" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sweepN" value="The log records a verdict for &lt;b&gt;all nine&lt;/b&gt;, including the ones it found&#xa;nothing on. That per-item list is the only evidence the sweep did not&#xa;stop at item 3 &#8212; which is what you buy with a checklist reviewer." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="338" width="596" height="56" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="elig"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="elig" target="p0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p1" target="snap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="snap" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p2" target="chk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="chk" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p3" target="esc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="esc" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
