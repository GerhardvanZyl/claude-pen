<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dev-loop-unity">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;/dev-loop-unity&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>

        <mxCell id="wrong" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Is this the wrong loop?&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Not single-player &#8212; networking, multiplayer, online&lt;br&gt;services, accounts, purchases, analytics/personal data,&lt;br&gt;downloaded or user-generated content, mod loading, or&lt;br&gt;credentials &#8594; the general ladder&lt;br&gt;Contained &#8212; one system or one scene, no settings/&lt;br&gt;pipeline/package/asmdef change, no save-format change,&lt;br&gt;no new shared primitive, no new art direction &#8594; the lite loop&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="wrongL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;&#8594; dev-loop-unity-lite&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Use it instead when the change is contained: one system&lt;br&gt;or one scene, no settings/pipeline/package/asmdef&lt;br&gt;change, no save-format change, no new shared primitive,&lt;br&gt;no new art direction.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="288" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="wrongR" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;&#8594; the general ladder&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Escalate if this isn't single-player, now or mid-run &#8212;&lt;br&gt;briefed with unity-editor.md regardless of which loop&lt;br&gt;ends up running it.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="288" width="420" height="120" as="geometry" /></mxCell>

        <mxCell id="p0" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 0 &#8212; Frame&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;as dev-loop, plus: read unity-editor.md; record which&lt;br&gt;editor instance belongs to this worktree, verify it against&lt;br&gt;Application.dataPath before the first command touches it&lt;br&gt;DoD for visual scope lists named shots and what each&lt;br&gt;must &lt;i&gt;show&lt;/i&gt;, not just that an object exists&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="488" width="420" height="130" as="geometry" /></mxCell>

        <mxCell id="p0a" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 0a &#8212; Art direction&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;when the change has visual scope from references or a&lt;br&gt;new look &#8212; sidekick-visual reads the references, the&lt;br&gt;design doc and the inventory, writes/updates&lt;br&gt;.claude/unity/scene-bible.md. One pass, no building.&lt;/div&gt;" style="rounded=1;dashed=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="678" width="420" height="110" as="geometry" /></mxCell>

        <mxCell id="p0b" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 0b &#8212; Inventory, primitives, harness&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;sidekick, before any building &#8226; asset-inventory.md,&lt;br&gt;incremental &#8226; shared placement primitives, tested in&lt;br&gt;EditMode &#8226; a capture harness per unity-editor.md &#8212; skip&lt;br&gt;any part that already exists, record the skip&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="848" width="420" height="120" as="geometry" /></mxCell>

        <mxCell id="sysNode" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Systems&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;line-height:1.4;text-align:left&quot;&gt;sidekick,&lt;br&gt;normal ladder&lt;br&gt;C#, either kind&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1018" width="204" height="120" as="geometry" /></mxCell>
        <mxCell id="visNode" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Visual build&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;line-height:1.4;text-align:left&quot;&gt;sidekick-visual&lt;br&gt;fable, &#8804;2 QA&lt;br&gt;one scene set&lt;/div&gt;" style="rounded=1;fillColor=rgba(235,108,54,0.12);strokeColor=#eb6c36;fontColor=#5a2d10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="1018" width="200" height="120" as="geometry" /></mxCell>

        <mxCell id="testsNode" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Tests&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;line-height:1.4;text-align:left&quot;&gt;EditMode: logic&lt;br&gt;PlayMode: frames,&lt;br&gt;physics, scenes&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1198" width="204" height="120" as="geometry" /></mxCell>
        <mxCell id="capNode" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Capture harness&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;line-height:1.4;text-align:left&quot;&gt;sidekick-lite&lt;br&gt;round 2+: affected&lt;br&gt;shots only&lt;/div&gt;" style="rounded=1;fillColor=rgba(235,108,54,0.12);strokeColor=#eb6c36;fontColor=#5a2d10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="1198" width="200" height="120" as="geometry" /></mxCell>

        <mxCell id="p3" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 3 &#8212; Plan &amp;amp; snapshot&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;digest the tree before and after capturing &#8212; if it moved,&lt;br&gt;the harness has a side effect: stop, that's a defect, not&lt;br&gt;a review finding. Then dev-loop's snapshot and scratch-&lt;br&gt;worktree setup, exactly.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1378" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="snEditor" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;The Tests lane's scratch worktree needs its own editor,&lt;br&gt;opened on a copied Library/ &#8212; never more than two&lt;br&gt;editors open at once. If a second can't be opened,&lt;br&gt;mutation testing is unavailable this round &#8212; record it,&lt;br&gt;don't improvise a mutation in the primary tree.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="1378" width="420" height="130" as="geometry" /></mxCell>

        <mxCell id="p4" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 4 &#8212; Delegate&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;wave limit of four, as dev-loop &#8212; up to six lanes can&lt;br&gt;apply; when more than four do, split into two waves,&lt;br&gt;Visual in the first. Give the Visual lane the captures&lt;br&gt;directory, matching references, the bible, the shot list.&lt;br&gt;Reviewers never build, capture, or open an editor &#8212; only&lt;br&gt;the Tests lane, and only in scratch.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1548" width="420" height="160" as="geometry" /></mxCell>

        <mxCell id="lanes" value="Six lanes can apply, split into two waves when more than four do &#8212; Visual leads the first" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1768" width="1500" height="390" as="geometry" /></mxCell>

        <mxCell id="lh0" value="Visual &#8212; fable &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="lanes"><mxGeometry x="14" y="42" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg0" value="wave 1 &#8212; renders changed, or the brief names shots" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="14" y="68" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb0" value="likeness to reference and bible, framing, readability per time of day, clipping/floating/T-poses, z-fighting, missing post-processing. Reruns if it owned an accepted finding, or for the visual confirmation." style="rounded=0;fillColor=#ffffff;strokeColor=#b8b8b8;fontColor=#2d3142;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="14" y="90" width="478" height="76" as="geometry" /></mxCell>

        <mxCell id="lh1" value="Requirements &#8212; opus &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="lanes"><mxGeometry x="508" y="42" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg1" value="wave 1 &#8212; always" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="508" y="68" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb1" value="mismatch vs the brief: missing requirements, unmet definition of done, unrequested scope. For visual scope, the DoD is the named shot list and what each must show, not that a capture exists." style="rounded=0;fillColor=#ffffff;strokeColor=#b8b8b8;fontColor=#2d3142;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="508" y="90" width="478" height="76" as="geometry" /></mxCell>

        <mxCell id="lh2" value="Technical &#8212; opus &#183; xhigh" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="lanes"><mxGeometry x="1002" y="42" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg2" value="wave 1 &#8212; C# changed" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="1002" y="68" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb2" value="logic, state/lifetime, boundaries, error paths, plus Unity lifecycle: execution order, missing OnDisable/OnDestroy, coroutines on inactive objects, per-frame allocation, unsafe serialized-field renames." style="rounded=0;fillColor=#ffffff;strokeColor=#b8b8b8;fontColor=#2d3142;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="1002" y="90" width="478" height="76" as="geometry" /></mxCell>

        <mxCell id="lh3" value="Tests &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="lanes"><mxGeometry x="14" y="180" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg3" value="wave 1 &#8212; C# changed" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="14" y="206" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb3" value="EditMode vs PlayMode fit, would the tests fail if the code were wrong, missing negatives. Mutation testing only in the lead's scratch worktree, with its own editor." style="rounded=0;fillColor=#ffffff;strokeColor=#b8b8b8;fontColor=#2d3142;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="14" y="228" width="478" height="76" as="geometry" /></mxCell>

        <mxCell id="lh4" value="Artifacts &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="lanes"><mxGeometry x="508" y="180" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg4" value="wave 2 &#8212; settings/pipeline/package/asmdef/.meta/scene YAML changed, or should have" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="508" y="206" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb4" value="ProjectSettings/, render-pipeline and quality assets, Packages/manifest.json + lock, .asmdef, unexpected .meta/GUID churn, hand-edited scene or prefab YAML, vendor import-setting changes." style="rounded=0;fillColor=#ffffff;strokeColor=#b8b8b8;fontColor=#2d3142;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="508" y="228" width="478" height="76" as="geometry" /></mxCell>

        <mxCell id="lh5" value="Structure &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="lanes"><mxGeometry x="1002" y="180" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg5" value="wave 2 &#8212; round 1 only" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="1002" y="206" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb5" value="separation of concerns first, then architecture, coding-standards, dead code, god objects in editor tooling. A recurring concern is a Technical/Requirements fix by round 2, not a fresh Structure one." style="rounded=0;fillColor=#ffffff;strokeColor=#b8b8b8;fontColor=#2d3142;dashed=1;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="1002" y="228" width="478" height="76" as="geometry" /></mxCell>

        <mxCell id="lanesN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Every reviewer is read-only apart from its findings and log &#8212; each writes round-N/&amp;lt;lane&amp;gt;.json and round-N/&amp;lt;lane&amp;gt;.log.md, reading &lt;b&gt;only its own card&lt;/b&gt; in review-lanes-unity.md. There is no Security card &#8212; an eligible change has no reachable security surface.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="14" y="312" width="1470" height="48" as="geometry" /></mxCell>

        <mxCell id="integ" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;every applicable lane drained &#8212;&lt;br&gt;retake the snapshot: did the&lt;br&gt;tree move?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="2228" width="340" height="140" as="geometry" /></mxCell>
        <mxCell id="integL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;a reviewer wrote to the tree under review&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;stop, restore, rerun that lane &#8212; the same rule as every&lt;br&gt;other loop, unrelaxed by having a Visual lane in play.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2228" width="420" height="140" as="geometry" /></mxCell>

        <mxCell id="p5" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 5 &#8212; Triage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;as dev-loop, plus: Visual finding &#8212; file = capture path,&lt;br&gt;line = 0, pixel region stated in finding, evidence: direct&lt;br&gt;means seen in the capture. Recurring-concern rule: raised&lt;br&gt;in round 1 and again in round 2 is not re-patched in the&lt;br&gt;scene &#8212; its fix is building or upgrading the primitive.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2428" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="snTriage" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Upgrading a recurring concern into a shared primitive&lt;br&gt;is a Technical or Requirements finding by round 2, not&lt;br&gt;a fresh Structure one &#8212; Structure only runs round 1.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="2458" width="420" height="110" as="geometry" /></mxCell>

        <mxCell id="p6" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 6 &#8212; Fix&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;code &#8594; sidekick / sidekick-heavy, test-before-fix, as&lt;br&gt;dev-loop. Visual &#8594; sidekick-visual, must recapture and&lt;br&gt;confirm by eye before returning.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2658" width="420" height="140" as="geometry" /></mxCell>

        <mxCell id="p7" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 7 &#8212; ROUND &#8804; 2&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;after round 2's fixes, if any&lt;br&gt;accepted finding was visual,&lt;br&gt;run a visual confirmation&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="2858" width="380" height="160" as="geometry" /></mxCell>
        <mxCell id="p7L" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;BLOCKED &#8212; stop and report&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;no heavier Unity loop exists &#8212; the same Critical&lt;br&gt;surviving a fix is blocked, not escalated further.&lt;br&gt;Say so and offer the general ladder.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2858" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="p7R" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;ROUND + 1 &#8594; back to Phase 3&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;otherwise, termination follows dev-loop's Phase 7&lt;br&gt;rules exactly&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="2898" width="400" height="80" as="geometry" /></mxCell>

        <mxCell id="vc" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Visual confirmation&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;recapture the affected shots, rerun only the Visual lane,&lt;br&gt;ask only whether each fixed finding now shows as fixed&lt;br&gt;&#8212; raises nothing new; a failure there is reported, not looped&lt;/div&gt;" style="rounded=1;dashed=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3118" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="snVc" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Otherwise termination follows dev-loop's Phase 7 rules&lt;br&gt;exactly &#8212; this adds a check, not a fourth round.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="3118" width="420" height="120" as="geometry" /></mxCell>

        <mxCell id="p8" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8 &#8212; Verify&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;dev-loop's own triggers, plus&lt;br&gt;Artifacts ran, or a visual&lt;br&gt;acceptance is unconfirmed&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="3298" width="400" height="160" as="geometry" /></mxCell>
        <mxCell id="v" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;reviewer-verify&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; opus, high &#8212; same four questions as dev-loop,&lt;br&gt;spawned once: intent preserved? validation matches the&lt;br&gt;touched behaviour? required checks ran? deferrals have&lt;br&gt;concrete reasons?&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="3313" width="420" height="130" as="geometry" /></mxCell>

        <mxCell id="p8b" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8b &#8212; Walkthrough&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;as dev-loop &#8212; sidekick drafts from notes.md, a second&lt;br&gt;sidekick reviews it, retake the snapshot as the Phase 9&lt;br&gt;baseline&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3538" width="420" height="130" as="geometry" /></mxCell>

        <mxCell id="p9" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 9 &#8212; Commit, push, pull request&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;as dev-loop, plus: editor idle, scenes saved, every new&lt;br&gt;asset's .meta staged &#8226; never stage Library/, Temp/,&lt;br&gt;Logs/, UserSettings/ &#8226; commit .claude/unity/* &#8226; captures&lt;br&gt;stay in the run directory unless the project already&lt;br&gt;commits them &#8226; run.md + index.jsonl, loop:&quot;unity&quot;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3698" width="420" height="200" as="geometry" /></mxCell>

        <mxCell id="done" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3958" width="200" height="48" as="geometry" /></mxCell>

        <mxCell id="ttl" value="dev-loop-unity" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Six gated lanes across two waves, a Fable-driven Visual lane, Security dropped since an eligible change has no reachable surface. Two rounds plus a visual confirmation. No heavier Unity loop to escalate to." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="entry" target="wrong"><mxGeometry relative="1" as="geometry" /></mxCell>
