<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dev-loop">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="/dev-loop" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="when" value="&lt;b&gt;Use the full loop when ANY of these holds&lt;/b&gt; &#8212;&#xa;this list decides it, not diff size:&#xa;&#8226; the change touches authentication, authorization,&#xa;secrets or untrusted input&#xa;&#8226; a migration, schema or public API contract changes&#xa;&#8226; more than one project in the solution is modified&#xa;&#8226; it ships on a path that is hard to roll back" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="145" as="geometry" /></mxCell>
        <mxCell id="whenR" value="&lt;b&gt;Escalate to dev-loop-ultra&lt;/b&gt; if a Critical lands in a&#xa;lane the change was not expected to touch at all,&#xa;&lt;b&gt;or&lt;/b&gt; the same Critical survives a fix and recurs in a&#xa;later round. Escalating upward is rarer than escalating&#xa;into this loop, and is stated to the user with the cost." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="285" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="p0" value="&lt;b&gt;Phase 0 &#8212; Frame the slice&lt;/b&gt;&#xa;requirement in plain language and explicit non-goals,&#xa;hard constraints, files and entry points from recon,&#xa;definition of done incl. which validation must pass,&#xa;&lt;b&gt;the source branch&lt;/b&gt; &#8212; the PR targets it, not the default&#xa;run dir .claude/review/runs/&lt;run-id&gt;/ + brief.md&#xa;invoke implementation-notes &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="473" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p0N" value="Reviewers read brief.md. &lt;b&gt;If it is not written&#xa;down, the requirements lane cannot run.&lt;/b&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="p1" value="&lt;b&gt;Phase 1 &#8212; Implement&lt;/b&gt;&#xa;delegate to the appropriate sidekick tier &#8212; the lead&#xa;writes no implementation code at any point in this loop&#xa;the brief requires conformance to coding-standards&#xa;and solution-architecture, both preloaded into sidekicks&#xa;and it &lt;b&gt;asks the reasoning back&lt;/b&gt; &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="683" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p2" value="&lt;b&gt;Phase 2 &#8212; Tests&lt;/b&gt; &#8212; a second handoff, not part of Phase 1&#xa;unit for logic and boundaries, integration for anything&#xa;crossing a process, database, queue or service edge,&#xa;UI for user-visible behaviour change&#xa;each must fail if the behaviour regresses &#8212; say so in the brief" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="873" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;b&gt;Phase 3 &#8212; Plan the review round&lt;/b&gt; &#8212; ROUND = N&#xa;classify each lane &lt;b&gt;applicable or skipped, with a concrete&lt;/b&gt;&#xa;&lt;b&gt;diff-based reason&lt;/b&gt;, into round-N/plan.md before spawning&#xa;&quot;the code looks fine&quot; is not a skip reason &#8212; only a factual&#xa;statement about what the diff does not touch is&#xa;then: snapshot the tree &#8594; plan.md  tree: &lt;sha&gt;&#xa;and create round-N/scratch for the Tests lane" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1053" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p3N" value="Neither step is optional and neither belongs to a&#xa;reviewer. In round 2+, recompute applicability from&#xa;the &lt;b&gt;fix delta&lt;/b&gt; &#8212; rerun the lanes that owned accepted&#xa;findings, plus any the fixes newly made applicable.&#xa;&lt;b&gt;Always rerun Technical after a behaviour-changing fix.&lt;/b&gt;&#xa;A comment-only fix does not justify a full round." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1073" width="400" height="110" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;b&gt;Phase 4 &#8212; Delegate&lt;/b&gt;&#xa;spawn the applicable reviewers in parallel, &lt;b&gt;up to four at a time&lt;/b&gt;&#xa;more than four &#8594; run in waves, letting each wave drain;&#xa;five-plus Opus reviewers at once hit concurrency and rate&#xa;limits before they hit anything useful&#xa;each gets: &lt;b&gt;its card only&lt;/b&gt;, run dir + round, diff base, changed&#xa;files, brief path, validation commands &#8212; Tests also gets scratch" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1263" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="integ" value="every reviewer drained &#8212; retake the&#xa;snapshot and compare against plan.md,&#xa;&lt;b&gt;before reading a single finding&lt;/b&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="1913" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="integL" value="&lt;b&gt;a reviewer wrote to the tree under review&lt;/b&gt;&#xa;identify the lane, restore the tree, rerun that lane from&#xa;the restored tree. &lt;b&gt;Do not assess whether the mutation&lt;/b&gt;&#xa;&lt;b&gt;looked harmless&lt;/b&gt; &#8212; every finding from that round&#xa;describes a tree that no longer exists.&#xa;This should pass every time. That is the point of running&#xa;it: it is cheap, and the one run where it fails is a run&#xa;where the Phase 9 file-list check would have said fine." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1913" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;b&gt;Phase 5 &#8212; Triage &#8212; you are the arbiter&lt;/b&gt;&#xa;1 &#8212; cluster by locator and cause; &lt;b&gt;one owning lane&lt;/b&gt; per&#xa;concern, the rest become corroboration&#xa;2 &#8212; evidence gate: inferred-only can never be Critical or Major&#xa;3 &#8212; cause gate: introduced / worsened / &lt;b&gt;missing-required&lt;/b&gt;&#xa;are fixed; stale and pre-existing debt go in the PR description&#xa;4 &#8212; defect &#8800; remedy: check a narrower boundary or type fix&#xa;before accepting a wrapper, validator, cache, flag or shim&#xa;5 &#8212; wontfix.json &#8212; stops the loop oscillating within a run&#xa;6 &#8212; conventions.md &#8212; the only thing that survives the run&#xa;write round-N/triage.md &#8212; the main thing you will want&#xa;when a run goes wrong" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2123" width="420" height="200" as="geometry" /></mxCell>
        <mxCell id="p5N" value="&lt;b&gt;missing-required is in scope precisely because what&lt;/b&gt;&#xa;&lt;b&gt;it names is not in the diff&lt;/b&gt; &#8212; the migration for a schema&#xa;change, the regenerated client, the lockfile for a new&#xa;package. Absent code is never in a diff, so a gate&#xa;admitting only introduced and worsened would drop&#xa;every one of them.&#xa;&#xa;&lt;b&gt;Rejections are split by reason, and the split is the point:&lt;/b&gt;&#xa;stale &#183; evidence &#183; remedy count the gates doing their job;&#xa;&lt;b&gt;only rejected_wrong counts against the lane.&lt;/b&gt;&#xa;If you cannot classify one cleanly, use wrong &#8212; over-counting&#xa;prompts a look at the card rather than quiet confidence." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="2123" width="420" height="200" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;b&gt;Phase 6 &#8212; Fix&lt;/b&gt;&#xa;one brief to a sidekick &#8212; &lt;b&gt;reviewers never edit&lt;/b&gt;&#xa;for each accepted finding with would_have_been_bug:&#xa;1 write a test that fails against the current code&#xa;2 confirm it fails  3 apply the fix  4 confirm it passes&#xa;&lt;b&gt;state that order explicitly&lt;/b&gt; &#8212; a test written after the fix&#xa;proves nothing about whether it would have caught the bug&#xa;then the smallest relevant validation, not the whole suite" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2383" width="420" height="155" as="geometry" /></mxCell>
        <mxCell id="p7" value="&lt;b&gt;Phase 7 &#8212; loop or exit&lt;/b&gt;&#xa;remove the scratch worktree first,&#xa;then retake the snapshot" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="2598" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="p7L" value="&lt;b&gt;BLOCKED &#8212; stop and report, do not continue&lt;/b&gt;&#xa;&#8226; ROUND would exceed &lt;b&gt;3&lt;/b&gt;&#xa;&#8226; the same concern has been raised and fixed twice &#8212; the&#xa;fix is not addressing the cause and a third will not help&#xa;&#8226; a round produced no material progress&#xa;&#8226; completion needs clarification, redesign, or behaviour&#xa;outside the brief's intent&#xa;&lt;b&gt;Never loop unbounded. Yield falls off sharply after round two.&lt;/b&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2598" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p7R" value="&lt;b&gt;ROUND + 1 &#8594; back to Phase 3&lt;/b&gt;&#xa;recompute applicability from the fix delta" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="2643" width="400" height="60" as="geometry" /></mxCell>
        <mxCell id="p8" value="&lt;b&gt;Phase 8 &#8212; Independent verification&lt;/b&gt;&#xa;validation uncertain, the slice risky,&#xa;artifacts changed, or a Critical fixed?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="2808" width="400" height="160" as="geometry" /></mxCell>
        <mxCell id="v" value="&lt;b&gt;reviewer-verify&lt;/b&gt; &#8212; opus, high &#8212; spawned once&#xa;asked only four things: does the final diff preserve intent?&#xa;does validation match the touched behaviour? did required&#xa;checks run or do they have stated blockers? do the deferrals&#xa;have concrete reasons?&#xa;&lt;b&gt;Do not ask it to re-review the whole diff.&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2823" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p8b" value="&lt;b&gt;Phase 8b &#8212; Walkthrough&lt;/b&gt;&#xa;1 &#8212; author: sidekick drafts from &lt;b&gt;notes.md, not the diff&lt;/b&gt;&#xa;&#8212; a draft briefed on the diff comes back as a narrated&#xa;changelog, the one failure this phase exists to prevent&#xa;2 &#8212; review: a second sidekick applies pr-walkthrough-review;&#xa;&lt;b&gt;do not read the document into your own context to judge it&lt;/b&gt;&#xa;3 &#8212; retake the snapshot &#8212; &lt;b&gt;this is the Phase 9 baseline&lt;/b&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3028" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p8bN" value="Skipping is permitted only for a purely mechanical&#xa;change &#8212; a rename, a bump, a formatting sweep &#8212; and&#xa;the skip goes in the PR description and run.md.&#xa;&lt;b&gt;It is never silent.&lt;/b&gt;&#xa;&#xa;Step 3 runs &lt;b&gt;whether or not&lt;/b&gt; you wrote one: Phase 9 stops&#xa;the run when the digest differs from this baseline, so it&#xa;must always have a value to compare against." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="3033" width="420" height="140" as="geometry" /></mxCell>
        <mxCell id="p9" value="&lt;b&gt;Phase 9 &#8212; Commit, push, pull request&lt;/b&gt;&#xa;&lt;b&gt;Nothing is on the branch until you put it there.&lt;/b&gt;&#xa;0 &#8212; remove every scratch worktree, including from rounds that ended early&#xa;1 &#8212; full build and test suite green&#xa;2 &#8212; stage everything: ?? files are missed by a path-pattern add&#xa;exclude runs/; commit conventions.md and the walkthrough&#xa;3 &#8212; commit, referencing the work item where there is one&#xa;4 &#8212; verify the committed diff &lt;b&gt;by content, not filename&lt;/b&gt;:&#xa;--stat vs round-1/plan.md, &lt;b&gt;then the tree digest vs Phase 8b&lt;/b&gt;&#xa;5 &#8212; push   6 &#8212; PR targets the Phase 0 source branch&#xa;7 &#8212; confirm the PR's file list matches step 4&#xa;8 &#8212; description: what, why, lanes run and skipped, rounds,&#xa;every deferred finding stated honestly, walkthrough link&#xa;9 &#8212; run.md   10 &#8212; one line to index.jsonl, loop:&quot;full&quot;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3238" width="420" height="245" as="geometry" /></mxCell>
        <mxCell id="p9N" value="A file-list comparison catches a &lt;b&gt;missing&lt;/b&gt; file.&#xa;Only the digest catches &lt;b&gt;changed content in a file&lt;/b&gt;&#xa;&lt;b&gt;that is present&lt;/b&gt; &#8212; which is the failure this loop&#xa;is otherwise blind to.&#xa;&#xa;Phase 8 verified the working tree, so its findings still&#xa;hold. &lt;b&gt;But it did not verify the commit&lt;/b&gt;, so steps 2&#xa;and 4 are yours alone and cannot be skipped on the&#xa;grounds that verification passed." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="3285" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="done" value="done" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3543" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="lanes" value="Nine lanes &#8212; one owner per concern. A lane that notices something another lane owns stays silent." style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1473" width="1500" height="380" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop &#8212; the full loop" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Nine gated lanes, one owner per concern, three rounds. Four Opus lanes and five Sonnet. The honest default for most work &#8212; the 1&#215; against which the other four loops are priced." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="lh0" value="Requirements &#8212; opus &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="14" y="42" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg0" value="always" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="14" y="68" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb0" value="change vs the brief: missing requirements, unmet definition of done, unrequested scope, interpretations taken on the user's behalf" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="90" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh1" value="Technical &#8212; opus &#183; xhigh" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="508" y="42" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg1" value="always" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="508" y="68" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb1" value="demonstrable incorrect behaviour caused by this diff: logic, state and lifetime, concurrency, boundaries, error paths, real performance" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="508" y="90" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh2" value="Tests &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="1002" y="42" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg2" value="always" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="1002" y="68" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb2" value="would the tests fail if the code were wrong? mutation testing &lt;b&gt;in the scratch worktree only&lt;/b&gt; &#8212; the strongest finding this lane makes" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1002" y="90" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh3" value="Architecture &#8212; opus &#183; xhigh" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="14" y="134" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg3" value="types moved or responsibilities shifted" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="14" y="160" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb3" value="&lt;b&gt;separation of concerns first and above all&lt;/b&gt;, then dependency direction, placement, coupling, conformance to the architecture in force" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="182" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh4" value="Standards &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="508" y="134" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg4" value="any source file changed" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="508" y="160" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb4" value="rules written in the coding-standards skill or the repo's .claude/standards.md, combined per the skill's precedence section. Nothing else" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="508" y="182" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh5" value="Security &#8212; opus &#183; xhigh" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="1002" y="134" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg5" value="input, authn/authz, secrets, serialization, queries, I/O, deps" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="1002" y="160" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb5" value="injection, authz gaps (especially object-level), secret handling, unsafe deserialization, weak crypto, data exposure, dependency risk" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1002" y="182" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh6" value="Dead code &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="14" y="226" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg6" value="paths removed, replaced, narrowed or refactored" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="14" y="252" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb6" value="proven-unreachable branches, unused private members, orphaned compatibility paths, members whose owning workflow this diff removed" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="274" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh7" value="Minimalism &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="508" y="226" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg7" value="guards, wrappers, config or abstractions added" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="508" y="252" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb7" value="code this diff added that nothing requires. &lt;b&gt;Never recommends removing a permission check, idempotency guard or lock ordering&lt;/b&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="508" y="274" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh8" value="Artifacts &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fontSize=11;" vertex="1" parent="lanes"><mxGeometry x="1002" y="226" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg8" value="migration, schema, generated file, lockfile, project file or CI changed &#8212; &lt;b&gt;or should have&lt;/b&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="1002" y="252" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb8" value="generated code out of sync, missing or destructive migrations, lockfile drift, new dependencies, build and CI surface" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1002" y="274" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lanesN" value="Every reviewer is read-only apart from its findings and log. Each writes round-N/&lt;lane&gt;.json and round-N/&lt;lane&gt;.log.md and returns &lt;b&gt;one line&lt;/b&gt;: path written and counts by severity.&#xa;&lt;b&gt;Do not read the finding bodies into your own context yet.&lt;/b&gt; The log's &lt;b&gt;dropped&lt;/b&gt; and &lt;b&gt;uncertain&lt;/b&gt; lines are its point &#8212; they are how you tell later whether a lane is too quiet or too noisy." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="14" y="322" width="1470" height="48" as="geometry" /></mxCell>
