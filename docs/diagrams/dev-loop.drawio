<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dev-loop">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;/dev-loop&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="when" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Use the full loop when ANY of these holds&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212;&lt;br&gt;this list decides it, not diff size:&lt;br&gt;&#8226; the change touches authentication, authorization,&lt;br&gt;secrets or untrusted input&lt;br&gt;&#8226; a migration, schema or public API contract changes&lt;br&gt;&#8226; more than one project in the solution is modified&lt;br&gt;&#8226; it ships on a path that is hard to roll back&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="145" as="geometry" /></mxCell>
        <mxCell id="whenR" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Escalate to dev-loop-ultra&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; if a Critical lands in a&lt;br&gt;lane the change was not expected to touch at all,&lt;br&gt;&lt;b&gt;or&lt;/b&gt; the same Critical survives a fix and recurs in a&lt;br&gt;later round. Escalating upward is rarer than escalating&lt;br&gt;into this loop, and is stated to the user with the cost.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="285" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="p0" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 0 &#8212; Frame the slice&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;requirement in plain language and explicit non-goals,&lt;br&gt;hard constraints, files and entry points from recon,&lt;br&gt;definition of done incl. which validation must pass,&lt;br&gt;&lt;b&gt;the source branch&lt;/b&gt; &#8212; the PR targets it, not the default&lt;br&gt;run dir .claude/review/runs/&amp;lt;run-id&amp;gt;/ + brief.md&lt;br&gt;invoke implementation-notes &#8594; notes.md&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="473" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p0N" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Reviewers read brief.md. &lt;b&gt;If it is not written&lt;br&gt;down, the requirements lane cannot run.&lt;/b&gt;&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="p1" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 1 &#8212; Implement&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;delegate to the appropriate sidekick tier &#8212; the lead&lt;br&gt;writes no implementation code at any point in this loop&lt;br&gt;the brief requires conformance to coding-standards&lt;br&gt;and solution-architecture, both preloaded into sidekicks&lt;br&gt;and it &lt;b&gt;asks the reasoning back&lt;/b&gt; &#8594; notes.md&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="683" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p2" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 2 &#8212; Tests&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; a second handoff, not part of Phase 1&lt;br&gt;unit for logic and boundaries, integration for anything&lt;br&gt;crossing a process, database, queue or service edge,&lt;br&gt;UI for user-visible behaviour change&lt;br&gt;each must fail if the behaviour regresses &#8212; say so in the brief&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="873" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 3 &#8212; Plan the review round&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; ROUND = N&lt;br&gt;classify each lane &lt;b&gt;applicable or skipped, with a concrete&lt;/b&gt;&lt;br&gt;&lt;b&gt;diff-based reason&lt;/b&gt;, into round-N/plan.md before spawning&lt;br&gt;&quot;the code looks fine&quot; is not a skip reason &#8212; only a factual&lt;br&gt;statement about what the diff does not touch is&lt;br&gt;then: snapshot the tree &#8594; plan.md  tree: &amp;lt;sha&amp;gt;&lt;br&gt;and create round-N/scratch for the Tests lane&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1053" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p3N" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Neither step is optional and neither belongs to a&lt;br&gt;reviewer. In round 2+, recompute applicability from&lt;br&gt;the &lt;b&gt;fix delta&lt;/b&gt; &#8212; rerun the lanes that owned accepted&lt;br&gt;findings, plus any the fixes newly made applicable.&lt;br&gt;&lt;b&gt;Always rerun Technical after a behaviour-changing fix.&lt;/b&gt;&lt;br&gt;A comment-only fix does not justify a full round.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1073" width="400" height="110" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 4 &#8212; Delegate&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;spawn the applicable reviewers in parallel, &lt;b&gt;up to four at a time&lt;/b&gt;&lt;br&gt;more than four &#8594; run in waves, letting each wave drain;&lt;br&gt;five-plus Opus reviewers at once hit concurrency and rate&lt;br&gt;limits before they hit anything useful&lt;br&gt;each gets: &lt;b&gt;its card only&lt;/b&gt;, run dir + round, diff base, changed&lt;br&gt;files, brief path, validation commands &#8212; Tests also gets scratch&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1263" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="integ" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;every reviewer drained &#8212; retake the&lt;br&gt;snapshot and compare against plan.md,&lt;br&gt;&lt;b&gt;before reading a single finding&lt;/b&gt;&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="1913" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="integL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;a reviewer wrote to the tree under review&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;identify the lane, restore the tree, rerun that lane from&lt;br&gt;the restored tree. &lt;b&gt;Do not assess whether the mutation&lt;/b&gt;&lt;br&gt;&lt;b&gt;looked harmless&lt;/b&gt; &#8212; every finding from that round&lt;br&gt;describes a tree that no longer exists.&lt;br&gt;This should pass every time. That is the point of running&lt;br&gt;it: it is cheap, and the one run where it fails is a run&lt;br&gt;where the Phase 9 file-list check would have said fine.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1913" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 5 &#8212; Triage &#8212; you are the arbiter&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;1 &#8212; cluster by locator and cause; &lt;b&gt;one owning lane&lt;/b&gt; per&lt;br&gt;concern, the rest become corroboration&lt;br&gt;2 &#8212; evidence gate: inferred-only can never be Critical or Major&lt;br&gt;3 &#8212; cause gate: introduced / worsened / &lt;b&gt;missing-required&lt;/b&gt;&lt;br&gt;are fixed; stale and pre-existing debt go in the PR description&lt;br&gt;4 &#8212; defect &#8800; remedy: check a narrower boundary or type fix&lt;br&gt;before accepting a wrapper, validator, cache, flag or shim&lt;br&gt;5 &#8212; wontfix.json &#8212; stops the loop oscillating within a run&lt;br&gt;6 &#8212; conventions.md &#8212; the only thing that survives the run&lt;br&gt;write round-N/triage.md &#8212; the main thing you will want&lt;br&gt;when a run goes wrong&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2123" width="420" height="200" as="geometry" /></mxCell>
        <mxCell id="p5N" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;missing-required is in scope precisely because what&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;it names is not in the diff&lt;/b&gt; &#8212; the migration for a schema&lt;br&gt;change, the regenerated client, the lockfile for a new&lt;br&gt;package. Absent code is never in a diff, so a gate&lt;br&gt;admitting only introduced and worsened would drop&lt;br&gt;every one of them.&lt;br&gt;&lt;b&gt;Rejections are split by reason, and the split is the point:&lt;/b&gt;&lt;br&gt;stale &#183; evidence &#183; remedy count the gates doing their job;&lt;br&gt;&lt;b&gt;only rejected_wrong counts against the lane.&lt;/b&gt;&lt;br&gt;If you cannot classify one cleanly, use wrong &#8212; over-counting&lt;br&gt;prompts a look at the card rather than quiet confidence.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="2123" width="420" height="200" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 6 &#8212; Fix&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;one brief to a sidekick &#8212; &lt;b&gt;reviewers never edit&lt;/b&gt;&lt;br&gt;for each accepted finding with would_have_been_bug:&lt;br&gt;1 write a test that fails against the current code&lt;br&gt;2 confirm it fails  3 apply the fix  4 confirm it passes&lt;br&gt;&lt;b&gt;state that order explicitly&lt;/b&gt; &#8212; a test written after the fix&lt;br&gt;proves nothing about whether it would have caught the bug&lt;br&gt;then the smallest relevant validation, not the whole suite&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2383" width="420" height="155" as="geometry" /></mxCell>
        <mxCell id="p7" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 7 &#8212; loop or exit&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;remove the scratch worktree first,&lt;br&gt;then retake the snapshot&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="2598" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="p7L" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;BLOCKED &#8212; stop and report, do not continue&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&#8226; ROUND would exceed &lt;b&gt;3&lt;/b&gt;&lt;br&gt;&#8226; the same concern has been raised and fixed twice &#8212; the&lt;br&gt;fix is not addressing the cause and a third will not help&lt;br&gt;&#8226; a round produced no material progress&lt;br&gt;&#8226; completion needs clarification, redesign, or behaviour&lt;br&gt;outside the brief's intent&lt;br&gt;&lt;b&gt;Never loop unbounded. Yield falls off sharply after round two.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2598" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p7R" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;ROUND + 1 &#8594; back to Phase 3&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;recompute applicability from the fix delta&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="2643" width="400" height="60" as="geometry" /></mxCell>
        <mxCell id="p8" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8 &#8212; Independent verification&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;validation uncertain, the slice risky,&lt;br&gt;artifacts changed, or a Critical fixed?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="2808" width="400" height="160" as="geometry" /></mxCell>
        <mxCell id="v" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;reviewer-verify&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; opus, high &#8212; spawned once&lt;br&gt;asked only four things: does the final diff preserve intent?&lt;br&gt;does validation match the touched behaviour? did required&lt;br&gt;checks run or do they have stated blockers? do the deferrals&lt;br&gt;have concrete reasons?&lt;br&gt;&lt;b&gt;Do not ask it to re-review the whole diff.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2823" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p8b" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8b &#8212; Walkthrough&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;1 &#8212; author: sidekick drafts from &lt;b&gt;notes.md, not the diff&lt;/b&gt;&lt;br&gt;&#8212; a draft briefed on the diff comes back as a narrated&lt;br&gt;changelog, the one failure this phase exists to prevent&lt;br&gt;2 &#8212; review: a second sidekick applies pr-walkthrough-review;&lt;br&gt;&lt;b&gt;do not read the document into your own context to judge it&lt;/b&gt;&lt;br&gt;3 &#8212; retake the snapshot &#8212; &lt;b&gt;this is the Phase 9 baseline&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3028" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p8bN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Skipping is permitted only for a purely mechanical&lt;br&gt;change &#8212; a rename, a bump, a formatting sweep &#8212; and&lt;br&gt;the skip goes in the PR description and run.md.&lt;br&gt;&lt;b&gt;It is never silent.&lt;/b&gt;&lt;br&gt;Step 3 runs &lt;b&gt;whether or not&lt;/b&gt; you wrote one: Phase 9 stops&lt;br&gt;the run when the digest differs from this baseline, so it&lt;br&gt;must always have a value to compare against.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="3033" width="420" height="140" as="geometry" /></mxCell>
        <mxCell id="p9" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 9 &#8212; Commit, push, pull request&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;Nothing is on the branch until you put it there.&lt;/b&gt;&lt;br&gt;0 &#8212; remove every scratch worktree, including from rounds that ended early&lt;br&gt;1 &#8212; full build and test suite green&lt;br&gt;2 &#8212; stage everything: ?? files are missed by a path-pattern add&lt;br&gt;exclude runs/; commit conventions.md and the walkthrough&lt;br&gt;3 &#8212; commit, referencing the work item where there is one&lt;br&gt;4 &#8212; verify the committed diff &lt;b&gt;by content, not filename&lt;/b&gt;:&lt;br&gt;--stat vs round-1/plan.md, &lt;b&gt;then the tree digest vs Phase 8b&lt;/b&gt;&lt;br&gt;5 &#8212; push   6 &#8212; PR targets the Phase 0 source branch&lt;br&gt;7 &#8212; confirm the PR's file list matches step 4&lt;br&gt;8 &#8212; description: what, why, lanes run and skipped, rounds,&lt;br&gt;every deferred finding stated honestly, walkthrough link&lt;br&gt;9 &#8212; run.md   10 &#8212; one line to index.jsonl, loop:&quot;full&quot;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3238" width="420" height="245" as="geometry" /></mxCell>
        <mxCell id="p9N" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;A file-list comparison catches a &lt;b&gt;missing&lt;/b&gt; file.&lt;br&gt;Only the digest catches &lt;b&gt;changed content in a file&lt;/b&gt;&lt;br&gt;&lt;b&gt;that is present&lt;/b&gt; &#8212; which is the failure this loop&lt;br&gt;is otherwise blind to.&lt;br&gt;Phase 8 verified the working tree, so its findings still&lt;br&gt;hold. &lt;b&gt;But it did not verify the commit&lt;/b&gt;, so steps 2&lt;br&gt;and 4 are yours alone and cannot be skipped on the&lt;br&gt;grounds that verification passed.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="3285" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="done" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3543" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="lanes" value="Nine lanes &#8212; one owner per concern. A lane that notices something another lane owns stays silent." style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1473" width="1500" height="380" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop &#8212; the full loop" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Nine gated lanes, one owner per concern, three rounds. Four Opus lanes and five Sonnet. The honest default for most work &#8212; the 1&#215; against which the other four loops are priced." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="lh0" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Requirements &#8212; opus &#183; high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="14" y="42" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg0" value="always" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="14" y="68" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb0" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;change vs the brief: missing requirements, unmet definition of done, unrequested scope, interpretations taken on the user's behalf&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="90" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh1" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Technical &#8212; opus &#183; xhigh&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="508" y="42" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg1" value="always" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="508" y="68" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb1" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;demonstrable incorrect behaviour caused by this diff: logic, state and lifetime, concurrency, boundaries, error paths, real performance&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="508" y="90" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh2" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Tests &#8212; sonnet &#183; high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="1002" y="42" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg2" value="always" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="1002" y="68" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb2" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;would the tests fail if the code were wrong? mutation testing &lt;b&gt;in the scratch worktree only&lt;/b&gt; &#8212; the strongest finding this lane makes&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1002" y="90" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh3" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Architecture &#8212; opus &#183; xhigh&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="14" y="134" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg3" value="types moved or responsibilities shifted" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="14" y="160" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb3" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;separation of concerns first and above all&lt;/b&gt;, then dependency direction, placement, coupling, conformance to the architecture in force&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="182" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh4" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Standards &#8212; sonnet &#183; high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="508" y="134" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg4" value="any source file changed" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="508" y="160" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb4" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;rules written in the coding-standards skill or the repo's .claude/standards.md, combined per the skill's precedence section. Nothing else&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="508" y="182" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh5" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Security &#8212; opus &#183; xhigh&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="1002" y="134" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg5" value="input, authn/authz, secrets, serialization, queries, I/O, deps" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="1002" y="160" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb5" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;injection, authz gaps (especially object-level), secret handling, unsafe deserialization, weak crypto, data exposure, dependency risk&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1002" y="182" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh6" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Dead code &#8212; sonnet &#183; high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="14" y="226" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg6" value="paths removed, replaced, narrowed or refactored" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="14" y="252" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb6" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;proven-unreachable branches, unused private members, orphaned compatibility paths, members whose owning workflow this diff removed&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="274" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh7" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Minimalism &#8212; sonnet &#183; high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="508" y="226" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg7" value="guards, wrappers, config or abstractions added" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="508" y="252" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb7" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;code this diff added that nothing requires. &lt;b&gt;Never recommends removing a permission check, idempotency guard or lock ordering&lt;/b&gt;&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="508" y="274" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lh8" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Artifacts &#8212; sonnet &#183; high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="1002" y="226" width="478" height="26" as="geometry" /></mxCell>
        <mxCell id="lg8" value="migration, schema, generated file, lockfile, project file or CI changed &#8212; &lt;b&gt;or should have&lt;/b&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=9;" vertex="1" parent="lanes"><mxGeometry x="1002" y="252" width="478" height="22" as="geometry" /></mxCell>
        <mxCell id="lb8" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;generated code out of sync, missing or destructive migrations, lockfile drift, new dependencies, build and CI surface&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=9;align=left;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1002" y="274" width="478" height="38" as="geometry" /></mxCell>
        <mxCell id="lanesN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Every reviewer is read-only apart from its findings and log. Each writes round-N/&amp;lt;lane&amp;gt;.json and round-N/&amp;lt;lane&amp;gt;.log.md and returns &lt;b&gt;one line&lt;/b&gt;: path written and counts by severity.&lt;br&gt;&lt;b&gt;Do not read the finding bodies into your own context yet.&lt;/b&gt; The log's &lt;b&gt;dropped&lt;/b&gt; and &lt;b&gt;uncertain&lt;/b&gt; lines are its point &#8212; they are how you tell later whether a lane is too quiet or too noisy.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="14" y="322" width="1470" height="48" as="geometry" /></mxCell>
