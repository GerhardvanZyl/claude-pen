<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dev-loop-lite">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;/dev-loop-lite&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="wrong" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Is this the wrong loop?&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Stop and use the full dev-loop if &lt;b&gt;any&lt;/b&gt; holds:&lt;br&gt;&#8226; the diff touches authn/authz, secrets or untrusted input&lt;br&gt;&#8226; a migration, schema or public API contract changes&lt;br&gt;&#8226; more than one project in the solution is modified&lt;br&gt;&#8226; it ships on a path you cannot easily roll back&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="wrongL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;&#8594; dev-loop (full)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;If you are unsure, use the full loop.&lt;br&gt;The savings are not worth a missed Critical.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="293" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="p0" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 0 &#8212; Frame the slice&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;requirement, non-goals, constraints, entry points,&lt;br&gt;definition of done, &lt;b&gt;and the source branch the PR targets&lt;/b&gt;&lt;br&gt;create the run directory + brief.md &#8212; reviewers read it&lt;br&gt;invoke implementation-notes &#8594; notes.md&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="458" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 1 &#8212; Implement&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;implementation is NOT downgraded in this loop&lt;/b&gt;&lt;br&gt;sidekick by default &#8226; sidekick-lite only if mechanical&lt;br&gt;sidekick-heavy when a constraint needs real reasoning&lt;br&gt;the brief asks the reasoning back &#8594; notes.md&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="633" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1N" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Cheaper scrutiny of carefully written code is a&lt;br&gt;reasonable trade. &lt;b&gt;Cheap code reviewed cheaply is not.&lt;/b&gt;&lt;br&gt;Reaching for sidekick-heavy is a soft signal to&lt;br&gt;re-read the loop-selection criteria.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="650" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="p2" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 2 &#8212; Tests&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; a second handoff&lt;br&gt;unit tests for logic and boundaries, integration tests for&lt;br&gt;anything crossing a process or service edge, UI tests for&lt;br&gt;visible behaviour &#8212; each must fail if behaviour regresses&lt;br&gt;decisions and rejected alternatives &#8594; notes.md&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="808" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 3 &#8212; Plan the round&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; ROUND = N&lt;br&gt;classify every lane &lt;b&gt;applicable or skipped with a&lt;/b&gt;&lt;br&gt;&lt;b&gt;diff-based reason&lt;/b&gt;, into round-N/plan.md, before&lt;br&gt;spawning anything &#8212; &quot;the code looks fine&quot; is never a skip&lt;br&gt;snapshot the tree &#8594; plan.md  tree: &amp;lt;sha&amp;gt;&lt;br&gt;then commit it, every round &#8594; plan.md  snapshot: &amp;lt;sha&amp;gt;&lt;br&gt;&#8212; that commit is next round's round base, and where&lt;br&gt;round-N/scratch comes from for the Tests lane&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="983" width="420" height="156" as="geometry" /></mxCell>
        <mxCell id="p3N" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;The snapshot, the round snapshot commit, and the&lt;br&gt;&lt;b&gt;scratch worktree are the lead's&lt;/b&gt; job, not a reviewer's.&lt;br&gt;A lane that made its own scratch space would be&lt;br&gt;making it from a tree it has just been told not to touch.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1008" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 4 &#8212; Delegate&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;spawn the applicable lanes &lt;b&gt;in parallel, in one turn&lt;/b&gt;&lt;br&gt;&#8212; four fit in a single batch, no waves needed&lt;br&gt;each gets: card name and path, run dir and round,&lt;br&gt;&lt;b&gt;both diff bases&lt;/b&gt; &#8212; change base always, round base from&lt;br&gt;round 2 (prior round's snapshot) &#8212; changed files, brief&lt;br&gt;path, validation commands; Tests also gets the scratch path&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1173" width="420" height="156" as="geometry" /></mxCell>
        <mxCell id="integ" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;all four drained &#8212; retake the&lt;br&gt;snapshot: did the tree move?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="1673" width="340" height="130" as="geometry" /></mxCell>
        <mxCell id="integL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;a reviewer wrote to the tree under review&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;stop, restore, rerun that lane. Four lanes reading&lt;br&gt;one tree concurrently is exactly the situation&lt;br&gt;this check exists for &#8212; do not assess whether&lt;br&gt;the mutation looked harmless.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1688" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 5 &#8212; Triage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;1 &#8212; cluster by locator and cause; one owning lane each&lt;br&gt;2 &#8212; evidence gate: inferred alone never blocks&lt;br&gt;3 &#8212; cause gate: introduced / worsened /&lt;br&gt;missing-required fixed; stale recorded&lt;br&gt;4 &#8212; defect &#8800; remedy: smallest fix, intent preserved&lt;br&gt;5 &#8212; wontfix.json  6 &#8212; conventions.md&lt;br&gt;write round-N/triage.md, classify every rejection&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1863" width="420" height="155" as="geometry" /></mxCell>
        <mxCell id="p5N" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Consolidation makes the rejection split matter more,&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;not less&lt;/b&gt; &#8212; a merged lane's total rejection rate blends&lt;br&gt;four concerns and tells you nothing on its own.&lt;br&gt;Correctness owns the brief here, so &lt;b&gt;its&lt;/b&gt; findings go to&lt;br&gt;notes.md whether accepted or rejected.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="1890" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="esc" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;any Critical&lt;br&gt;in round 1?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="2078" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="escL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;abandon this loop &#8212; restart under dev-loop (full)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Not a coverage argument: these four lanes &lt;b&gt;do&lt;/b&gt; cover all&lt;br&gt;nine concerns. What they lack is &lt;b&gt;depth and tiering&lt;/b&gt; &#8212;&lt;br&gt;Sonnet and Haiku not four Opus lanes, two rounds not three,&lt;br&gt;verification usually skipped. Do not fix it here and carry on.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2078" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 6 &#8212; Fix&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;one brief to sidekick, or sidekick-heavy if it needs judgment&lt;br&gt;&lt;b&gt;fixes are not downgraded either&lt;/b&gt;&lt;br&gt;would_have_been_bug &#8594; failing test FIRST, confirm it fails,&lt;br&gt;apply the fix, confirm it passes &#8212; that order, stated in the brief&lt;br&gt;then the smallest relevant validation, not the whole suite&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2248" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p7" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 7 &#8212; loop or exit&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;remove the scratch worktree,&lt;br&gt;retake the snapshot&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="2438" width="360" height="140" as="geometry" /></mxCell>
        <mxCell id="p7L" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;BLOCKED &#8212; stop and report&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;ROUND would exceed &lt;b&gt;2&lt;/b&gt; &#8226; the same concern raised&lt;br&gt;and fixed twice &#8226; a round with no material progress&lt;br&gt;&#8226; completion needs clarification or redesign&lt;br&gt;&lt;b&gt;A lite change that cannot converge in two rounds&lt;/b&gt;&lt;br&gt;&lt;b&gt;is not a lite change.&lt;/b&gt; Switch loops, do not add a round.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2448" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p7R" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;ROUND + 1 &#8594; back to Phase 3&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;rerun only the lanes that owned accepted findings,&lt;br&gt;plus Correctness after any behaviour-changing fix&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="2468" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="p8" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8 &#8212; Verification&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;a Critical, or a Major with&lt;br&gt;would_have_been_bug, fixed?&lt;br&gt;or did artifacts change?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="2638" width="380" height="150" as="geometry" /></mxCell>
        <mxCell id="p8R" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;no &#8212; skip it, and say so in run.md&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;A skipped phase that is not recorded&lt;br&gt;reads as a phase that was forgotten.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="2678" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="v" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;reviewer-verify&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; opus, high&lt;br&gt;&lt;b&gt;stays on Opus deliberately: the last gate before a human&lt;/b&gt;&lt;br&gt;does the final diff preserve intent? does validation match&lt;br&gt;the touched behaviour? did required checks run?&lt;br&gt;do the deferrals have concrete reasons?&lt;br&gt;&lt;b&gt;NOT a re-review of the diff&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2648" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p8b" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8b &#8212; Walkthrough&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;1 &#8212; author: sidekick drafts from &lt;b&gt;notes.md, not the diff&lt;/b&gt;&lt;br&gt;2 &#8212; review: a second sidekick applies pr-walkthrough-review,&lt;br&gt;write-capable on the walkthrough file alone&lt;br&gt;3 &#8212; retake the snapshot &#8212; &lt;b&gt;this is the Phase 9 baseline&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2848" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p8bN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Step 3 is &lt;b&gt;not&lt;/b&gt; bookkeeping. The walkthrough is a new file&lt;br&gt;under docs/, which is not gitignored, so it changes the digest&lt;br&gt;&#8212; and Phase 9 stops the run when the digest differs from the&lt;br&gt;baseline. Without it, &lt;b&gt;every run halts there.&lt;/b&gt;&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="2868" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="p9" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 9 &#8212; Commit, push, pull request&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;0 &#8212; remove every scratch worktree from this run&lt;br&gt;1 &#8212; full build and test suite green&lt;br&gt;2 &#8212; stage everything: ?? files are missed by a path-pattern add&lt;br&gt;exclude runs/, commit conventions.md and the walkthrough&lt;br&gt;3 &#8212; commit   4 &#8212; verify &lt;b&gt;--stat AND the tree digest&lt;/b&gt;&lt;br&gt;5 &#8212; push   6 &#8212; PR targets the Phase 0 source branch&lt;br&gt;7 &#8212; confirm the PR file list matches step 4&lt;br&gt;8 &#8212; description says &lt;b&gt;this was a lite run&lt;/b&gt; + links the walkthrough&lt;br&gt;9 &#8212; run.md + index.jsonl with loop:&quot;lite&quot;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3028" width="420" height="185" as="geometry" /></mxCell>
        <mxCell id="p9N" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Same files with different contents produce an&lt;br&gt;&lt;b&gt;identical --stat&lt;/b&gt;. Only the tree digest catches&lt;br&gt;content that moved between the last review&lt;br&gt;and the commit.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="3080" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="done" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3273" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="lanes" value="The four consolidated lanes &#8212; nine concerns compressed into four contexts" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1363" width="1500" height="250" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-lite" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Four consolidated lanes, two rounds, verification only when it is earned. Review cost ≈ 0.3&#215; a full run. The lite loop economises on review, never on the code." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="ln0" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Correctness &#8212; sonnet, high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fillColor=#e7eef5;" vertex="1" parent="lanes"><mxGeometry x="14" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb0" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;always applicable&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;requirements conformance to the brief,&lt;br&gt;technical defects, &lt;b&gt;and artifacts&lt;/b&gt;&lt;br&gt;(migrations, lockfiles, generated code)&lt;br&gt;&#8212; three full-loop lanes in one pass&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="ln1" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Structure &#8212; sonnet, high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fillColor=#e7eef5;" vertex="1" parent="lanes"><mxGeometry x="386" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb1" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;always applicable&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;separation of concerns FIRST&lt;/b&gt;, then&lt;br&gt;architecture in force, coding-standards&lt;br&gt;+ .claude/standards.md, surplus additions&lt;br&gt;and dead code &#8212; four lanes in one pass&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="386" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="ln2" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Tests &#8212; &lt;b&gt;haiku&lt;/b&gt;, high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fillColor=#e7eef5;" vertex="1" parent="lanes"><mxGeometry x="758" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb2" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;always applicable&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;would the tests fail if the code were&lt;br&gt;wrong? assertion quality, error paths,&lt;br&gt;over-mocking, missing negatives&lt;br&gt;mutation testing in the scratch worktree only&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="758" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="ln3" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Security &#8212; sonnet, high&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;fillColor=#fbf0d5;" vertex="1" parent="lanes"><mxGeometry x="1130" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb3" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;gated&lt;/b&gt;: input handling, queries,&lt;br&gt;serialization, file or network I/O,&lt;br&gt;or dependencies&lt;br&gt;&lt;b&gt;if it touches authn/authz or secrets&lt;/b&gt;&lt;br&gt;&lt;b&gt;you are in the wrong loop&lt;/b&gt;&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1130" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="lanesN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Each lane reads &lt;b&gt;only its own card&lt;/b&gt; and stays silent on anything another lane owns. Each writes round-N/&amp;lt;lane&amp;gt;.json and round-N/&amp;lt;lane&amp;gt;.log.md,&lt;br&gt;and returns &lt;b&gt;one line&lt;/b&gt; to the lead: path written and counts by severity. Reviewers are read-only &#8212; they never call Edit and never fix.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="14" y="190" width="1470" height="48" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="wrong"><mxGeometry relative="1" as="geometry" /></mxCell>
