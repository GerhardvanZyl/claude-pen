<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dev-loop-lite">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="/dev-loop-lite" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="wrong" value="&lt;b&gt;Is this the wrong loop?&lt;/b&gt;&#xa;Stop and use the full dev-loop if &lt;b&gt;any&lt;/b&gt; holds:&#xa;&#8226; the diff touches authn/authz, secrets or untrusted input&#xa;&#8226; a migration, schema or public API contract changes&#xa;&#8226; more than one project in the solution is modified&#xa;&#8226; it ships on a path you cannot easily roll back" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="wrongL" value="&lt;b&gt;&#8594; dev-loop (full)&lt;/b&gt;&#xa;If you are unsure, use the full loop.&#xa;The savings are not worth a missed Critical." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="293" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="p0" value="&lt;b&gt;Phase 0 &#8212; Frame the slice&lt;/b&gt;&#xa;requirement, non-goals, constraints, entry points,&#xa;definition of done, &lt;b&gt;and the source branch the PR targets&lt;/b&gt;&#xa;create the run directory + brief.md &#8212; reviewers read it&#xa;invoke implementation-notes &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="458" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1" value="&lt;b&gt;Phase 1 &#8212; Implement&lt;/b&gt;&#xa;&lt;b&gt;implementation is NOT downgraded in this loop&lt;/b&gt;&#xa;sidekick by default &#8226; sidekick-lite only if mechanical&#xa;sidekick-heavy when a constraint needs real reasoning&#xa;the brief asks the reasoning back &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="633" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1N" value="Cheaper scrutiny of carefully written code is a&#xa;reasonable trade. &lt;b&gt;Cheap code reviewed cheaply is not.&lt;/b&gt;&#xa;Reaching for sidekick-heavy is a soft signal to&#xa;re-read the loop-selection criteria." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="650" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="p2" value="&lt;b&gt;Phase 2 &#8212; Tests&lt;/b&gt; &#8212; a second handoff&#xa;unit tests for logic and boundaries, integration tests for&#xa;anything crossing a process or service edge, UI tests for&#xa;visible behaviour &#8212; each must fail if behaviour regresses&#xa;decisions and rejected alternatives &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="808" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;b&gt;Phase 3 &#8212; Plan the round&lt;/b&gt; &#8212; ROUND = N&#xa;classify every lane &lt;b&gt;applicable or skipped with a&lt;/b&gt;&#xa;&lt;b&gt;diff-based reason&lt;/b&gt;, into round-N/plan.md, before&#xa;spawning anything &#8212; &quot;the code looks fine&quot; is never a skip&#xa;then snapshot the tree &#8594; plan.md  tree: &lt;sha&gt;&#xa;and create round-N/scratch for the Tests lane" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="983" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p3N" value="The snapshot and the scratch worktree are the&#xa;&lt;b&gt;lead's&lt;/b&gt; job, not a reviewer's. A lane that made its&#xa;own scratch space would be making it from a tree&#xa;it has just been told not to touch." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1008" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;b&gt;Phase 4 &#8212; Delegate&lt;/b&gt;&#xa;spawn the applicable lanes &lt;b&gt;in parallel, in one turn&lt;/b&gt;&#xa;&#8212; four fit in a single batch, no waves needed&#xa;each gets: card name and path, run dir and round, diff base,&#xa;changed files, brief path, validation commands&#xa;the Tests lane also gets the scratch worktree path" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1173" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="integ" value="all four drained &#8212; retake the&#xa;snapshot: did the tree move?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="1673" width="340" height="130" as="geometry" /></mxCell>
        <mxCell id="integL" value="&lt;b&gt;a reviewer wrote to the tree under review&lt;/b&gt;&#xa;stop, restore, rerun that lane. Four lanes reading&#xa;one tree concurrently is exactly the situation&#xa;this check exists for &#8212; do not assess whether&#xa;the mutation looked harmless." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1688" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;b&gt;Phase 5 &#8212; Triage&lt;/b&gt;&#xa;1 &#8212; cluster by locator and cause; one owning lane each&#xa;2 &#8212; evidence gate: inferred alone never blocks&#xa;3 &#8212; cause gate: introduced / worsened /&#xa;missing-required fixed; stale recorded&#xa;4 &#8212; defect &#8800; remedy: smallest fix, intent preserved&#xa;5 &#8212; wontfix.json  6 &#8212; conventions.md&#xa;write round-N/triage.md, classify every rejection" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1863" width="420" height="155" as="geometry" /></mxCell>
        <mxCell id="p5N" value="&lt;b&gt;Consolidation makes the rejection split matter more,&lt;/b&gt;&#xa;&lt;b&gt;not less&lt;/b&gt; &#8212; a merged lane's total rejection rate blends&#xa;four concerns and tells you nothing on its own.&#xa;Correctness owns the brief here, so &lt;b&gt;its&lt;/b&gt; findings go to&#xa;notes.md whether accepted or rejected." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="1890" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="esc" value="any Critical&#xa;in round 1?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="2078" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="escL" value="&lt;b&gt;abandon this loop &#8212; restart under dev-loop (full)&lt;/b&gt;&#xa;Not a coverage argument: these four lanes &lt;b&gt;do&lt;/b&gt; cover all&#xa;nine concerns. What they lack is &lt;b&gt;depth and tiering&lt;/b&gt; &#8212;&#xa;Sonnet and Haiku not four Opus lanes, two rounds not three,&#xa;verification usually skipped. Do not fix it here and carry on." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2078" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;b&gt;Phase 6 &#8212; Fix&lt;/b&gt;&#xa;one brief to sidekick, or sidekick-heavy if it needs judgment&#xa;&lt;b&gt;fixes are not downgraded either&lt;/b&gt;&#xa;would_have_been_bug &#8594; failing test FIRST, confirm it fails,&#xa;apply the fix, confirm it passes &#8212; that order, stated in the brief&#xa;then the smallest relevant validation, not the whole suite" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2248" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p7" value="&lt;b&gt;Phase 7 &#8212; loop or exit&lt;/b&gt;&#xa;remove the scratch worktree,&#xa;retake the snapshot" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="2438" width="360" height="140" as="geometry" /></mxCell>
        <mxCell id="p7L" value="&lt;b&gt;BLOCKED &#8212; stop and report&lt;/b&gt;&#xa;ROUND would exceed &lt;b&gt;2&lt;/b&gt; &#8226; the same concern raised&#xa;and fixed twice &#8226; a round with no material progress&#xa;&#8226; completion needs clarification or redesign&#xa;&lt;b&gt;A lite change that cannot converge in two rounds&lt;/b&gt;&#xa;&lt;b&gt;is not a lite change.&lt;/b&gt; Switch loops, do not add a round." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2448" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p7R" value="&lt;b&gt;ROUND + 1 &#8594; back to Phase 3&lt;/b&gt;&#xa;rerun only the lanes that owned accepted findings,&#xa;plus Correctness after any behaviour-changing fix" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="2468" width="400" height="80" as="geometry" /></mxCell>
        <mxCell id="p8" value="&lt;b&gt;Phase 8 &#8212; Verification&lt;/b&gt;&#xa;a Critical, or a Major with&#xa;would_have_been_bug, fixed?&#xa;or did artifacts change?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="2638" width="380" height="150" as="geometry" /></mxCell>
        <mxCell id="p8R" value="&lt;b&gt;no &#8212; skip it, and say so in run.md&lt;/b&gt;&#xa;A skipped phase that is not recorded&#xa;reads as a phase that was forgotten." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="2678" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="v" value="&lt;b&gt;reviewer-verify&lt;/b&gt; &#8212; opus, high&#xa;&lt;b&gt;stays on Opus deliberately: the last gate before a human&lt;/b&gt;&#xa;does the final diff preserve intent? does validation match&#xa;the touched behaviour? did required checks run?&#xa;do the deferrals have concrete reasons?&#xa;&lt;b&gt;NOT a re-review of the diff&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2648" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p8b" value="&lt;b&gt;Phase 8b &#8212; Walkthrough&lt;/b&gt;&#xa;1 &#8212; author: sidekick drafts from &lt;b&gt;notes.md, not the diff&lt;/b&gt;&#xa;2 &#8212; review: a second sidekick applies pr-walkthrough-review,&#xa;write-capable on the walkthrough file alone&#xa;3 &#8212; retake the snapshot &#8212; &lt;b&gt;this is the Phase 9 baseline&lt;/b&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2848" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p8bN" value="Step 3 is &lt;b&gt;not&lt;/b&gt; bookkeeping. The walkthrough is a new file&#xa;under docs/, which is not gitignored, so it changes the digest&#xa;&#8212; and Phase 9 stops the run when the digest differs from the&#xa;baseline. Without it, &lt;b&gt;every run halts there.&lt;/b&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="2868" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="p9" value="&lt;b&gt;Phase 9 &#8212; Commit, push, pull request&lt;/b&gt;&#xa;0 &#8212; remove every scratch worktree from this run&#xa;1 &#8212; full build and test suite green&#xa;2 &#8212; stage everything: ?? files are missed by a path-pattern add&#xa;exclude runs/, commit conventions.md and the walkthrough&#xa;3 &#8212; commit   4 &#8212; verify &lt;b&gt;--stat AND the tree digest&lt;/b&gt;&#xa;5 &#8212; push   6 &#8212; PR targets the Phase 0 source branch&#xa;7 &#8212; confirm the PR file list matches step 4&#xa;8 &#8212; description says &lt;b&gt;this was a lite run&lt;/b&gt; + links the walkthrough&#xa;9 &#8212; run.md + index.jsonl with loop:&quot;lite&quot;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3028" width="420" height="185" as="geometry" /></mxCell>
        <mxCell id="p9N" value="Same files with different contents produce an&#xa;&lt;b&gt;identical --stat&lt;/b&gt;. Only the tree digest catches&#xa;content that moved between the last review&#xa;and the commit." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="3080" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="done" value="done" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3273" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="lanes" value="The four consolidated lanes &#8212; nine concerns compressed into four contexts" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1363" width="1500" height="250" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-lite" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Four consolidated lanes, two rounds, verification only when it is earned. Review cost ≈ 0.3&#215; a full run. The lite loop economises on review, never on the code." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="ln0" value="Correctness &#8212; sonnet, high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fillColor=#e7eef5;" vertex="1" parent="lanes"><mxGeometry x="14" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb0" value="&lt;b&gt;always applicable&lt;/b&gt;&#xa;requirements conformance to the brief,&#xa;technical defects, &lt;b&gt;and artifacts&lt;/b&gt;&#xa;(migrations, lockfiles, generated code)&#xa;&#8212; three full-loop lanes in one pass" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="14" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="ln1" value="Structure &#8212; sonnet, high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fillColor=#e7eef5;" vertex="1" parent="lanes"><mxGeometry x="386" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb1" value="&lt;b&gt;always applicable&lt;/b&gt;&#xa;&lt;b&gt;separation of concerns FIRST&lt;/b&gt;, then&#xa;architecture in force, coding-standards&#xa;+ .claude/standards.md, surplus additions&#xa;and dead code &#8212; four lanes in one pass" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="386" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="ln2" value="Tests &#8212; &lt;b&gt;haiku&lt;/b&gt;, high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fillColor=#e7eef5;" vertex="1" parent="lanes"><mxGeometry x="758" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb2" value="&lt;b&gt;always applicable&lt;/b&gt;&#xa;would the tests fail if the code were&#xa;wrong? assertion quality, error paths,&#xa;over-mocking, missing negatives&#xa;mutation testing in the scratch worktree only" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="758" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="ln3" value="Security &#8212; sonnet, high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontStyle=1;fillColor=#fbf0d5;" vertex="1" parent="lanes"><mxGeometry x="1130" y="42" width="356" height="30" as="geometry" /></mxCell>
        <mxCell id="lb3" value="&lt;b&gt;gated&lt;/b&gt;: input handling, queries,&#xa;serialization, file or network I/O,&#xa;or dependencies&#xa;&lt;b&gt;if it touches authn/authz or secrets&lt;/b&gt;&#xa;&lt;b&gt;you are in the wrong loop&lt;/b&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;dashed=0;fillColor=#ffffff;" vertex="1" parent="lanes"><mxGeometry x="1130" y="76" width="356" height="100" as="geometry" /></mxCell>
        <mxCell id="lanesN" value="Each lane reads &lt;b&gt;only its own card&lt;/b&gt; and stays silent on anything another lane owns. Each writes round-N/&lt;lane&gt;.json and round-N/&lt;lane&gt;.log.md,&#xa;and returns &lt;b&gt;one line&lt;/b&gt; to the lead: path written and counts by severity. Reviewers are read-only &#8212; they never call Edit and never fix." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="lanes"><mxGeometry x="14" y="190" width="1470" height="48" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="wrong"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="wrong" target="p0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="integ" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5" target="esc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="esc" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
