<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dev-loop-greybox">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" value="dev-loop-greybox — Unity blockouts &amp; visual prototypes" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Six changes to /dev-loop-lite: an art brief with named shots, ShotCapture after Tests and every Fix, two extra lanes spawned in a second wave, escalation to dev-loop-unity, and shots that ship with the walkthrough. Phases without a note below are byte-identical to dev-loop-lite." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="entry" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;/dev-loop-greybox&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="wrong" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Is this the wrong loop? (unchanged)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.4;text-align:left&quot;&gt;Same four dev-loop-lite triggers: auth/secrets/&lt;br&gt;untrusted input · migration/schema/contract ·&lt;br&gt;more than one project · hard to roll back.&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="248" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="wrongL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;→ dev-loop-unity — OVERRIDDEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.4;text-align:left&quot;&gt;Retargeted by Change 5, same as the round-1&lt;br&gt;Critical escalation below. If unsure, use the full&lt;br&gt;Unity loop — the savings are not worth a missed&lt;br&gt;Critical.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="248" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="p0" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 0 — Frame the slice — OVERRIDDEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;brief.md&lt;/b&gt; additionally records: mood &amp; reference in&lt;br&gt;words; scale (player height, key dimensions);&lt;br&gt;palette &amp; lighting intent; and &lt;b&gt;named shots&lt;/b&gt; — one&lt;br&gt;row per shot: Name, Camera position, Look target,&lt;br&gt;Must show. &lt;b&gt;Definition of done:&lt;/b&gt; compile check&lt;br&gt;passes &lt;b&gt;and&lt;/b&gt; every named shot renders.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="398" width="420" height="210" as="geometry" /></mxCell>
        <mxCell id="p1" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 1 — Implement — OVERRIDDEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Build with ProBuilder or primitives, placeholder&lt;br&gt;materials, and lighting. For each named shot, place&lt;br&gt;a camera &lt;b&gt;Shot_&amp;lt;name&amp;gt;&lt;/b&gt; — Camera component&lt;br&gt;&lt;b&gt;disabled&lt;/b&gt;, GameObject &lt;b&gt;active&lt;/b&gt;. If&lt;br&gt;Assets/Editor/ShotCapture.cs is absent, copy it in&lt;br&gt;from this skill's references/ShotCapture.cs.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="638" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="p2" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 2 — Tests — OVERRIDDEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;After this phase, and again after &lt;b&gt;every Phase 6&lt;/b&gt;&lt;br&gt;&lt;b&gt;fix round&lt;/b&gt;, run Shot capture (unity-batchmode.md)&lt;br&gt;into round-N/shots/. A missing PNG is a &lt;b&gt;failed&lt;/b&gt;&lt;br&gt;&lt;b&gt;definition-of-done item&lt;/b&gt; — it stops the round, not&lt;br&gt;a review finding. &lt;b&gt;No-GPU rule:&lt;/b&gt; capture failing for&lt;br&gt;lack of a graphics device still stops the run; never a&lt;br&gt;reason to skip the Visual lane.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="838" width="420" height="190" as="geometry" /></mxCell>
        <mxCell id="p3p4" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 3/4 — Plan &amp; Delegate — OVERRIDDEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Add two &lt;b&gt;always-applicable&lt;/b&gt; lanes below: Unity&lt;br&gt;(sonnet) and Visual (opus, its own model).&lt;br&gt;reviewer-unity reads the Unity section,&lt;br&gt;reviewer-visual the Visual section, of&lt;br&gt;review-lanes-unity.md. Correctness cedes&lt;br&gt;.meta/.unity/.prefab/.asset/.asmdef to the Unity lane.&lt;br&gt;&lt;b&gt;Spawn lite's 4 lanes as wave 1&lt;/b&gt;, let it drain, &lt;b&gt;then&lt;/b&gt;&lt;br&gt;&lt;b&gt;Unity + Visual as wave 2&lt;/b&gt; — snapshot comparison&lt;br&gt;happens after wave 2, not wave 1.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1058" width="420" height="210" as="geometry" /></mxCell>
        <mxCell id="lanes" value="Six lanes in two waves — four unchanged from dev-loop-lite, plus Unity and Visual added by this override" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1308" width="1500" height="300" as="geometry" /></mxCell>
        <mxCell id="base4" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;wave 1 — Correctness · Structure · Tests · Security&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.4;text-align:center&quot;&gt;unchanged — see dev-loop-lite.drawio for each lane's model and gating. Correctness cedes .meta/.unity/.prefab/.asset/.asmdef per Phase 3/4, above.&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="14" y="42" width="1470" height="50" as="geometry" /></mxCell>
        <mxCell id="uh" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;wave 2 — Unity — sonnet — NEW&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="lanes"><mxGeometry x="14" y="104" width="720" height="26" as="geometry" /></mxCell>
        <mxCell id="ug" value="always applicable in this loop" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="14" y="132" width="720" height="22" as="geometry" /></mxCell>
        <mxCell id="ub" value="&lt;div style=&quot;font-size:10px;line-height:1.4;text-align:left&quot;&gt;Reads the Unity section of review-lanes-unity.md — serialized-field data loss, asset/.meta integrity, fileID/GUID references, .asmdef, lifecycle-order dependence, main-thread violations, per-frame allocations, UnityEditor APIs in runtime, == null misuse. Quality brake: a per-frame allocation is not a finding in a greybox placeholder script.&lt;/div&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#b8b8b8;fontColor=#4a4a4a;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="14" y="156" width="720" height="110" as="geometry" /></mxCell>
        <mxCell id="vh" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;wave 2 — Visual — opus — NEW&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="lanes"><mxGeometry x="744" y="104" width="740" height="26" as="geometry" /></mxCell>
        <mxCell id="vg" value="always applicable in this loop" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="744" y="132" width="740" height="22" as="geometry" /></mxCell>
        <mxCell id="vb" value="&lt;div style=&quot;font-size:10px;line-height:1.4;text-align:left&quot;&gt;Judges round-N/shots/ PNGs against brief.md's named-shot table: a brief element missing or wrong; scale contradicting the brief; framing that doesn't show what the brief says it must; lighting/palette contradicting stated intent. &lt;b&gt;Quality brake:&lt;/b&gt; every finding quotes the brief line it violates — taste and polish beyond greybox fidelity are not findings.&lt;/div&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#b8b8b8;fontColor=#4a4a4a;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="744" y="156" width="740" height="110" as="geometry" /></mxCell>
        <mxCell id="integ" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;all six lanes drained, wave 2 last —&lt;br&gt;retake the snapshot: did the tree move?&lt;br&gt;(unchanged mechanism, later trigger point)&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="1648" width="400" height="130" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 5 — Triage (unchanged)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Same six-step triage as dev-loop-lite: cluster,&lt;br&gt;evidence gate, cause gate, defect ≠ remedy,&lt;br&gt;wontfix.json, conventions.md. &lt;b&gt;The round-1-Critical&lt;/b&gt;&lt;br&gt;&lt;b&gt;escalation target changes&lt;/b&gt; — see below.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1818" width="420" height="140" as="geometry" /></mxCell>
        <mxCell id="esc" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;any Critical&lt;br&gt;in round 1?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="1998" width="280" height="110" as="geometry" /></mxCell>
        <mxCell id="escL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Escalate to dev-loop-unity — Change 5&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.4;text-align:left&quot;&gt;Not dev-loop (full) — this loop escalates to&lt;br&gt;&lt;b&gt;dev-loop-unity&lt;/b&gt; instead: full-loop depth plus the&lt;br&gt;Unity lane, for the same reason dev-loop-lite&lt;br&gt;escalates at all: a Critical in a change this small&lt;br&gt;means the change was misjudged.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1998" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 6 — Fix — OVERRIDDEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;After the fix, &lt;b&gt;Shot capture runs again&lt;/b&gt; into the&lt;br&gt;same round-N/shots/ (Change 3) — before the&lt;br&gt;tree-snapshot retake below.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2148" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="p7" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Phase 7 — loop or exit&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.4;text-align:center&quot;&gt;(unchanged)&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="500" y="2318" width="360" height="130" as="geometry" /></mxCell>
        <mxCell id="p7L" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;BLOCKED (unchanged)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.4;text-align:left&quot;&gt;ROUND would exceed 2, a concern raised and&lt;br&gt;fixed twice, or no material progress.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2318" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="p7R" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;ROUND + 1 → back to Phase 3/4 (unchanged)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="2348" width="400" height="70" as="geometry" /></mxCell>
        <mxCell id="p8" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Phase 8 — Verification&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.4;text-align:center&quot;&gt;(unchanged)&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="2488" width="380" height="140" as="geometry" /></mxCell>
        <mxCell id="v" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;reviewer-verify (unchanged)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.4;text-align:left&quot;&gt; — opus, high. Same as dev-loop-lite's Phase 8.&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2488" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p8b" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8b — Walkthrough — OVERRIDDEN&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;The final round's shots are copied to&lt;br&gt;docs/walkthroughs/&amp;lt;slug&amp;gt;/shots/ and embedded in&lt;br&gt;the walkthrough. &lt;b&gt;Retake the snapshot AFTER&lt;/b&gt;&lt;br&gt;&lt;b&gt;copying them, not before&lt;/b&gt; — new files under docs/&lt;br&gt;change the digest exactly like the walkthrough itself.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2668" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="p9" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 9 — Commit, push, pull request&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Otherwise identical to dev-loop-lite's Phase 9.&lt;br&gt;&lt;b&gt;Run identity:&lt;/b&gt; notes.md records &lt;b&gt;loop:&lt;/b&gt;&lt;br&gt;&lt;b&gt;dev-loop-greybox&lt;/b&gt;; findings and index.jsonl use&lt;br&gt;&amp;quot;loop&amp;quot;:&amp;quot;greybox&amp;quot;, not &amp;quot;lite&amp;quot;.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2878" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="done" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3088" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="wrong"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e0b" value="any holds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="wrong" target="wrongL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="wrong" target="p0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p2" target="p3p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.44;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3p4" target="lanes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.44;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lanes" target="integ"><mxGeometry relative="1" as="geometry" /></mxCell>
