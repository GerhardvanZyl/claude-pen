<mxfile host="drawio" version="26.0.0">
  <diagram name="skills-overview">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="2080" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" value="Skills overview" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry" /></mxCell><mxCell id="sub" value="How every skill in the repo hands off to the next: backlog work becomes tracker items, the sprint lead triages each item to a dev loop, every loop keeps notes and ships a walkthrough, and standards/architecture are preloaded throughout." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1600" height="44" as="geometry" /></mxCell><mxCell id="backlog" value="&lt;div style=&quot;font-size:14px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;backlog-refinement&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.35;text-align:center&quot;&gt;grills each item one at a time, agrees an estimate as planning poker, writes bullet-only&lt;br/&gt;context / decisions / acceptance criteria back to the tracker &amp;#8212; the only skill with write access&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="840" y="130" width="420" height="74" as="geometry" /></mxCell><mxCell id="implsprint" value="&lt;div style=&quot;font-size:14px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;implement-sprint&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.35;text-align:center&quot;&gt;reads what backlog-refinement wrote &amp;#8212; pulls the sprint, triages every item to a dev loop,&lt;br/&gt;hands each to sprint-item-runner one at a time, raises a PR per item, never merges&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="840" y="264" width="420" height="74" as="geometry" /></mxCell><mxCell id="e_backlog_implsprint" value="writes refined items (context, decisions, acceptance criteria)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;endArrow=block;endFill=1;" edge="1" parent="1" source="backlog" target="implsprint"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="loops" value="dev loops &amp;#8212; implement-sprint assigns one per item at triage; work down the ladder and stop at the first that fits; escalation is one-way" style="rounded=0;fillColor=none;strokeColor=#4a7095;dashed=1;fontColor=#4a7095;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=10;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="430" y="398" width="1240" height="400" as="geometry" /></mxCell><mxCell id="e_implsprint_loops" value="triage each item to a loop; run it via sprint-item-runner" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;endArrow=block;endFill=1;" edge="1" parent="1" source="implsprint" target="loops"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ultralight" value="&lt;div style=&quot;font-size:14px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;dev-loop-ultralight&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.35;text-align:center&quot;&gt;1 reviewer, 9-item sweep &amp;#183; 1 round &amp;#183; no verification &amp;#183; ~0.1&amp;#215;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="loops"><mxGeometry x="48" y="60" width="200" height="90" as="geometry" /></mxCell><mxCell id="lite" value="&lt;div style=&quot;font-size:14px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;dev-loop-lite&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.35;text-align:center&quot;&gt;4 consolidated lanes &amp;#183; 2 rounds &amp;#183; verify after a Critical &amp;#183; ~0.3&amp;#215;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="loops"><mxGeometry x="284" y="60" width="200" height="90" as="geometry" /></mxCell><mxCell id="full" value="&lt;div style=&quot;font-size:14px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;dev-loop&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.35;text-align:center&quot;&gt;9 gated lanes (4 Opus, 5 Sonnet) &amp;#183; 3 rounds &amp;#183; verify when risky &amp;#183; 1&amp;#215;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="loops"><mxGeometry x="520" y="60" width="200" height="90" as="geometry" /></mxCell><mxCell id="ultra" value="&lt;div style=&quot;font-size:14px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;dev-loop-ultra&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.35;text-align:center&quot;&gt;9 lanes &amp;#215; 3 (opposed pair + adjudicator) &amp;#183; 3 rounds &amp;#183; always verify &amp;#183; ~3&amp;#215;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="loops"><mxGeometry x="756" y="60" width="200" height="90" as="geometry" /></mxCell><mxCell id="opus" value="&lt;div style=&quot;font-size:14px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;dev-loop-ultra-opus&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.35;text-align:center&quot;&gt;every reviewer on Opus, xhigh &amp;#183; implementation on Opus too &amp;#183; ~8&amp;#215;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="loops"><mxGeometry x="992" y="60" width="200" height="90" as="geometry" /></mxCell><mxCell id="e_ultralight_lite" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#5c6b85;labelBackgroundColor=#ffffff;strokeColor=#7a8399;dashed=1;dashPattern=1 3;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ultralight" target="lite"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_lite_full" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#5c6b85;labelBackgroundColor=#ffffff;strokeColor=#7a8399;dashed=1;dashPattern=1 3;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lite" target="full"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_full_ultra" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#5c6b85;labelBackgroundColor=#ffffff;strokeColor=#7a8399;dashed=1;dashPattern=1 3;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="full" target="ultra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_ultra_opus" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#5c6b85;labelBackgroundColor=#ffffff;strokeColor=#7a8399;dashed=1;dashPattern=1 3;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ultra" target="opus"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ulNote" value="also escalates straight to &lt;b&gt;dev-loop&lt;/b&gt; on any Critical, or a Major in&lt;br/&gt;security, architecture, or concurrency &amp;#8212; see CLAUDE.md escalation table" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="loops"><mxGeometry x="48" y="160" width="200" height="60" as="geometry" /></mxCell><mxCell id="ulite2" value="&lt;div style=&quot;font-size:14px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;dev-loop-unity-lite&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.35;text-align:center&quot;&gt;4 consolidated lanes incl. a Fable-driven Visual lane &amp;#183; 2 rounds + visual confirmation&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="loops"><mxGeometry x="48" y="260" width="230" height="90" as="geometry" /></mxCell><mxCell id="unity" value="&lt;div style=&quot;font-size:14px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;dev-loop-unity&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.35;text-align:center&quot;&gt;adds the Fable Visual lane, drops the Security lane &amp;#183; single-player only&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="loops"><mxGeometry x="618" y="260" width="230" height="90" as="geometry" /></mxCell><mxCell id="e_ulite2_unity" value="round-1 Critical, or needs art direction / settings / new primitive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#5c6b85;labelBackgroundColor=#ffffff;strokeColor=#7a8399;dashed=1;dashPattern=1 3;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ulite2" target="unity"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_unity_full" value="single-player eligibility breaks mid-run &amp;#8594; general ladder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#5c6b85;labelBackgroundColor=#ffffff;strokeColor=#7a8399;dashed=1;dashPattern=1 3;endArrow=block;endFill=1;exitX=0.5217391304347826;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="unity" target="full"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1168" y="548" /></Array></mxGeometry></mxCell><mxCell id="inB" value="&lt;div style=&quot;font-size:13px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;implementation-notes&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.4;text-align:left&quot;&gt;Invoked at the &lt;b&gt;start&lt;/b&gt; of every dev loop &amp;#8212; records the decisions, the rejected alternatives and why, and the requirements findings.&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1710" y="400" width="300" height="100" as="geometry" /></mxCell><mxCell id="pwB" value="&lt;div style=&quot;font-size:13px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;pr-walkthrough&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.4;text-align:left&quot;&gt;Authored at the &lt;b&gt;end&lt;/b&gt; of every loop, before the PR &amp;#8212; briefed on notes.md, not the diff, so it explains why rather than narrating a changelog.&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1710" y="550" width="300" height="100" as="geometry" /></mxCell><mxCell id="prB" value="&lt;div style=&quot;font-size:13px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;pr-walkthrough-review&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.4;text-align:left&quot;&gt;Checks the walkthrough and corrects it in place &amp;#8212; calibrated for a senior engineer, reads well aloud, before the PR is raised.&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1710" y="700" width="300" height="100" as="geometry" /></mxCell><mxCell id="e_loops_inB" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;endArrow=block;endFill=1;exitX=1;exitY=0.13;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="loops" target="inB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_inB_pwB" value="notes.md is the brief, not the diff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;endArrow=block;endFill=1;" edge="1" parent="1" source="inB" target="pwB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_pwB_prB" value="reviews &amp;amp; corrects in place" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;endArrow=block;endFill=1;" edge="1" parent="1" source="pwB" target="prB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="csB" value="&lt;div style=&quot;font-size:13px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;coding-standards&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.4;text-align:left&quot;&gt;Cross-project style baseline &amp;#8212; a repo's own .claude/standards.md wins on any subject it covers, this fills the rest.&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="300" height="90" as="geometry" /></mxCell><mxCell id="saB" value="&lt;div style=&quot;font-size:13px;line-height:1.25;text-align:center;margin-bottom:4px&quot;&gt;&lt;b&gt;solution-architecture&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9.5px;line-height:1.4;text-align:left&quot;&gt;Repo-agnostic reasoning for placement and dependency direction &amp;#8212; establish the architecture in force before judging against it.&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="300" height="90" as="geometry" /></mxCell><mxCell id="e_csB_loops" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#5c6b85;labelBackgroundColor=#ffffff;strokeColor=#7a8399;dashed=1;dashPattern=8 4;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2675;entryDx=0;entryDy=0;" edge="1" parent="1" source="csB" target="loops"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_saB_loops" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontColor=#5c6b85;labelBackgroundColor=#ffffff;strokeColor=#7a8399;dashed=1;dashPattern=8 4;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5925;entryDx=0;entryDy=0;" edge="1" parent="1" source="saB" target="loops"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="preloadNote" value="coding-standards + solution-architecture preloaded into sidekicks + review lanes" style="text;html=1;fillColor=none;strokeColor=none;fontSize=8;fontColor=#5c6b85;align=center;fontStyle=2;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="345" y="402" width="80" height="46" as="geometry" /></mxCell><mxCell id="pr" value="PR raised &amp;#8212; every item ends here; the loop never merges" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950.0" y="858" width="200" height="50" as="geometry" /></mxCell><mxCell id="e_loops_pr" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="loops" target="pr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_prB_pr" value="walkthrough ships with the PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prB" target="pr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1860.0" y="883.0" /></Array></mxGeometry></mxCell><mxCell id="legend" value="Legend" style="rounded=0;fillColor=none;strokeColor=#b8b8b8;dashed=1;fontColor=#4a4a4a;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;whiteSpace=wrap;html=1;fontSize=10;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="340" height="130" as="geometry" /></mxCell><mxCell id="lg1" value="" style="line;strokeWidth=2;html=1;strokeColor=#4a7095;" vertex="1" parent="legend"><mxGeometry x="20" y="34" width="50" height="10" as="geometry" /></mxCell><mxCell id="lg1t" value="invokes / hands off" style="text;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#12263f;align=left;" vertex="1" parent="legend"><mxGeometry x="80" y="24" width="240" height="20" as="geometry" /></mxCell><mxCell id="lg2" value="" style="line;strokeWidth=2;html=1;strokeColor=#7a8399;dashed=1;dashPattern=8 4;" vertex="1" parent="legend"><mxGeometry x="20" y="66" width="50" height="10" as="geometry" /></mxCell><mxCell id="lg2t" value="preloaded / reference" style="text;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#12263f;align=left;" vertex="1" parent="legend"><mxGeometry x="80" y="56" width="240" height="20" as="geometry" /></mxCell><mxCell id="lg3" value="" style="line;strokeWidth=2;html=1;strokeColor=#7a8399;dashed=1;dashPattern=1 3;" vertex="1" parent="legend"><mxGeometry x="20" y="98" width="50" height="10" as="geometry" /></mxCell><mxCell id="lg3t" value="escalates" style="text;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#12263f;align=left;" vertex="1" parent="legend"><mxGeometry x="80" y="88" width="240" height="20" as="geometry" /></mxCell>
      </root>
