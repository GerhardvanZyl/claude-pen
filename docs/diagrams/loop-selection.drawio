<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="loop-selection">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1500" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" value="Choosing a loop" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="By risk surface, not diff size. A one-line change touching authorization goes to the full loop." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1200" height="22" as="geometry" /></mxCell>
        <mxCell id="entry" value="a change to implement" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="128" width="420" height="44" as="geometry" /></mxCell>
        <mxCell id="q1" value="&lt;b&gt;any of these?&lt;/b&gt;&#xa;auth, secrets or untrusted input  ·&#xa;migration, schema or public contract  ·&#xa;more than one project  ·  hard to roll back" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="208" width="360" height="104" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="q1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="full" value="&lt;b&gt;/dev-loop&lt;/b&gt;  —  the default&#xa;9 gated lanes  ·  3 rounds  ·  1.00×" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="232" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="e1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="q1" target="full"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q2" value="&lt;b&gt;contained?&lt;/b&gt;&#xa;≤ 5 files, one project, no concurrency,&#xa;no new dependency, easy to roll back" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="356" width="360" height="104" as="geometry" /></mxCell>
        <mxCell id="e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ul" value="&lt;b&gt;/dev-loop-ultralight&lt;/b&gt;&#xa;1 reviewer, 9-item sweep  ·  1 round  ·  0.19×" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="q2" target="ul"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lite" value="&lt;b&gt;/dev-loop-lite&lt;/b&gt;&#xa;4 consolidated lanes  ·  2 rounds  ·  0.57×" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="380" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="q2" target="lite"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q3" value="&lt;b&gt;expensive to miss?&lt;/b&gt;&#xa;money or goods  ·  tenant isolation  ·&#xa;destructive migration  ·  a contract others&#xa;build on  ·  code you will not maintain" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="520" width="360" height="110" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="full" target="q3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ultra" value="&lt;b&gt;/dev-loop-ultra&lt;/b&gt;&#xa;9 adversarial triples  ·  3 rounds  ·  1.89×" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="546" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="q3" target="ultra"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q4" value="&lt;b&gt;severe AND largely&#xa;irreversible?&lt;/b&gt;&#xa;production data, other tenants’ data,&#xa;regulatory consequence" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="682" width="360" height="104" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="ultra" target="q4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="opus" value="&lt;b&gt;/dev-loop-ultra-opus&lt;/b&gt;&#xa;every reviewer on Opus  ·  1 lane at a time  ·  2.71×" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="708" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="q4" target="opus"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rule" value="&lt;b&gt;When unsure, go heavier.&lt;/b&gt;&#xa;The savings never justify a missed Critical.&#xa;&#xa;But reaching past the point where the extra&#xa;scrutiny changes the outcome is spending,&#xa;not diligence. The honest default is /dev-loop." style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="esc" value="&lt;b&gt;Escalation is one-way, mandatory, and never de-escalates&lt;/b&gt;&#xa;ultralight → &lt;b&gt;dev-loop&lt;/b&gt; on any Critical, or a Major in security, architecture or concurrency&#xa;ultralight → &lt;b&gt;dev-loop-lite&lt;/b&gt; on any other Major, more than four accepted findings, or a sweep the reviewer could not complete&#xa;lite → &lt;b&gt;dev-loop&lt;/b&gt; on any Critical in round 1&#xa;full → &lt;b&gt;dev-loop-ultra&lt;/b&gt; on a Critical in a lane the change was not expected to touch, or the same Critical surviving a fix&#xa;ultra → &lt;b&gt;dev-loop-ultra-opus&lt;/b&gt; when an adjudicator reports  coverage: both thin  on a lane owning a Critical, twice" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="856" width="1330" height="130" as="geometry" /></mxCell>
        <mxCell id="escN" value="Never fix and carry on. A change that produced a Critical was misjudged, and the lanes the lighter loop compressed or skipped are precisely the ones&#xa;that have not properly looked at it yet. Implementation is never downgraded by any of this — all five loops write and fix code at the same sidekick&#xa;tiers, and only review depth and bounds differ. dev-loop-ultra-opus is the one exception, raising implementation to Opus to match its reviewers." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="1330" height="62" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
