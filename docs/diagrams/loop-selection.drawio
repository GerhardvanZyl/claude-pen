<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="loop-selection">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1560" pageHeight="1380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" value="Choosing a loop" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="By risk surface, not diff size. A one-line change touching authorization goes to the full loop." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1200" height="22" as="geometry" /></mxCell>
        <mxCell id="entry" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;a change to implement&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="128" width="420" height="44" as="geometry" /></mxCell>
        <mxCell id="q1" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;any of these?&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;auth, secrets or untrusted input  ·&lt;br&gt;migration, schema or public contract  ·&lt;br&gt;more than one project  ·  hard to roll back&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="222" width="540" height="180" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="q1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="full" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;/dev-loop&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;  —  the default&lt;br&gt;9 gated lanes  ·  3 rounds  ·  1.00×&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="284" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="e1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q1" target="full"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q2" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;contained?&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;≤ 5 files, one project, no concurrency,&lt;br&gt;no new dependency, easy to roll back&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="570" y="452" width="360" height="104" as="geometry" /></mxCell>
        <mxCell id="e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ul" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;/dev-loop-ultralight&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;1 reviewer, 9-item sweep  ·  1 round  ·  0.19×&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="476" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="q2" target="ul"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="lite" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;/dev-loop-lite&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;4 consolidated lanes  ·  2 rounds  ·  0.57×&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="476" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="q2" target="lite"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q3" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;expensive to miss?&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;money or goods  ·  tenant isolation  ·&lt;br&gt;destructive migration  ·  a contract others&lt;br&gt;build on  ·  code you will not maintain&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="606" width="540" height="185" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="full" target="q3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="312" /><mxPoint x="1030" y="580" /><mxPoint x="750" y="580" /></Array></mxGeometry></mxCell>
        <mxCell id="ultra" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;/dev-loop-ultra&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;9 adversarial triples  ·  3 rounds  ·  1.89×&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="671" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q3" target="ultra"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="q4" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;severe AND largely&lt;br&gt;irreversible?&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;production data, other tenants’ data,&lt;br&gt;regulatory consequence&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="841" width="480" height="155" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="ultra" target="q4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="699" /><mxPoint x="1030" y="816" /><mxPoint x="750" y="816" /></Array></mxGeometry></mxCell>
        <mxCell id="opus" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;/dev-loop-ultra-opus&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;every reviewer on Opus  ·  1 lane at a time  ·  2.71×&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1080" y="891" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q4" target="opus"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rule" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;When unsure, go heavier.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;The savings never justify a missed Critical.&lt;br&gt;But reaching past the point where the extra&lt;br&gt;scrutiny changes the outcome is spending,&lt;br&gt;not diligence. The honest default is /dev-loop.&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="758" width="380" height="100" as="geometry" /></mxCell>
        <mxCell id="esc" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Escalation is one-way, mandatory, and never de-escalates&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;ultralight → &lt;b&gt;dev-loop&lt;/b&gt; on any Critical, or a Major in security, architecture or concurrency&lt;br&gt;ultralight → &lt;b&gt;dev-loop-lite&lt;/b&gt; on any other Major, more than four accepted findings, or a sweep the reviewer could not complete&lt;br&gt;lite → &lt;b&gt;dev-loop&lt;/b&gt; on any Critical in round 1&lt;br&gt;full → &lt;b&gt;dev-loop-ultra&lt;/b&gt; on a Critical in a lane the change was not expected to touch, or the same Critical surviving a fix&lt;br&gt;ultra → &lt;b&gt;dev-loop-ultra-opus&lt;/b&gt; when an adjudicator reports  coverage: both thin  on a lane owning a Critical, twice&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1066" width="1400" height="130" as="geometry" /></mxCell>
        <mxCell id="escN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Never fix and carry on. A change that produced a Critical was misjudged, and the lanes the lighter loop compressed or skipped are precisely the ones&lt;br&gt;that have not properly looked at it yet. Implementation is never downgraded by any of this — all five loops write and fix code at the same sidekick&lt;br&gt;tiers, and only review depth and bounds differ. dev-loop-ultra-opus is the one exception, raising implementation to Opus to match its reviewers.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1220" width="1400" height="62" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
