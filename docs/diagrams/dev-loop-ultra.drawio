<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dev-loop-ultra">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;/dev-loop-ultra&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="why" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Why three agents per lane&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;A single reviewer has &lt;b&gt;one error profile&lt;/b&gt;: whatever it is disposed&lt;br&gt;to miss, it misses consistently, and running it again changes nothing.&lt;br&gt;Two reviewers on &lt;b&gt;opposed assumptions&lt;/b&gt; have different profiles.&lt;br&gt;&lt;b&gt;Their disagreements are where the information is&lt;/b&gt; &#8212; and extracting&lt;br&gt;it, by checking the code itself, is the adjudicator's whole job.&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="278" width="420" height="140" as="geometry" /></mxCell>
        <mxCell id="whenL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Use ultra when a missed defect is expensive&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;rather than merely annoying:&lt;/b&gt;&lt;br&gt;&#8226; payment, billing, anything moving money or goods&lt;br&gt;&#8226; auth, permissions, tenant or user data isolation&lt;br&gt;&#8226; migrations that alter or destroy existing data&lt;br&gt;&#8226; integration contracts other systems depend on&lt;br&gt;&#8226; anything where rollback is slow or costly&lt;br&gt;&#8226; code you are handing over and will not maintain&lt;br&gt;&lt;b&gt;Ultra applied everywhere is not thoroughness, it is expense.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="268" width="440" height="160" as="geometry" /></mxCell>
        <mxCell id="p02" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phases 0&#8211;2 &#8212; Frame, implement, test&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; identical to dev-loop&lt;br&gt;frame the slice, record the source branch, write brief.md,&lt;br&gt;invoke implementation-notes &#8594; notes.md, then implement and&lt;br&gt;test in &lt;b&gt;two handoffs at the normal sidekick tiers&lt;/b&gt;&lt;br&gt;both briefs ask the decisions and rejected alternatives back&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="488" width="420" height="125" as="geometry" /></mxCell>
        <mxCell id="p02N" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Implementation is not changed by this loop.&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Ultra buys scrutiny of the code, not better code.&lt;br&gt;If you want the implementation raised too, that is&lt;br&gt;what dev-loop-ultra-opus is for.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="510" width="420" height="80" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 3 &#8212; Plan the round&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; ROUND = N&lt;br&gt;same applicability table as dev-loop &#8594; round-N/plan.md&lt;br&gt;snapshot the tree &#8594; plan.md  tree: &amp;lt;sha&amp;gt;&lt;br&gt;scratch worktree at round-N/scratch for the Tests pair&lt;br&gt;&lt;b&gt;retake and compare after each PAIR of lanes drains,&lt;/b&gt;&lt;br&gt;&lt;b&gt;not only at the end of the round&lt;/b&gt; &#8212; with eighteen-plus&lt;br&gt;agent runs against one tree, finding out at the end that it&lt;br&gt;moved means rerunning far more than one lane&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="673" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 4 &#8212; Adversarial review&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;for each applicable lane, three agents in sequence&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="893" width="420" height="70" as="geometry" /></mxCell>
        <mxCell id="conc" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Concurrency: two lanes at a time, four reviewers in flight&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;both reviewers for two lanes &#8594; drain &#8594; those two adjudicators&lt;br&gt;&#8594; the next pair. Nine lanes at once would put eighteen agents&lt;br&gt;in flight and hit concurrency limits long before it saved wall-clock.&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="1678" width="560" height="100" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 5 &#8212; Triage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; identical to dev-loop&lt;br&gt;cluster by locator, gate on evidence and cause, separate&lt;br&gt;defect from remedy, check wontfix.json, record durable&lt;br&gt;decisions in conventions.md, write round-N/triage.md&lt;br&gt;&lt;b&gt;One addition: read each lane's coverage line.&lt;/b&gt;&lt;br&gt;A lane reported &lt;b&gt;both thin&lt;/b&gt; was not really reviewed,&lt;br&gt;whatever its findings file says &#8212; rerun it before&lt;br&gt;trusting the round.&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1838" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="p5N" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Ultra has a source the single-pass loops do not:&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;the adjudication logs.&lt;/b&gt; A finding prosecution raised&lt;br&gt;and the adjudicator dropped, &lt;b&gt;with its reason&lt;/b&gt;, is exactly&lt;br&gt;the near-miss worth telling a reviewer about &#8212; append it&lt;br&gt;to the Interesting finds in notes.md.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="1868" width="440" height="100" as="geometry" /></mxCell>
        <mxCell id="escR" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;&#8594; escalate to dev-loop-ultra-opus&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;when an adjudicator reports &lt;b&gt;coverage: both thin&lt;/b&gt;&lt;br&gt;on a lane owning a Critical, &lt;b&gt;twice&lt;/b&gt;.&lt;br&gt;Rarer than escalating into this loop, and stated&lt;br&gt;to the user with the cost rather than taken silently.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="10" y="1863" width="440" height="110" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 6 &#8212; Fix&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; identical to dev-loop&lt;br&gt;accepted findings to a sidekick; for each one with&lt;br&gt;would_have_been_bug, the regression test is written and&lt;br&gt;&lt;b&gt;confirmed failing before the fix&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2058" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="p7" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 7 &#8212; loop or exit&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;identical bounds to dev-loop &#8212; &lt;b&gt;3 rounds maximum&lt;/b&gt;, stop on a&lt;br&gt;concern raised and fixed twice, on no material progress, or when&lt;br&gt;completion needs clarification or redesign&lt;br&gt;in round 2+, rerun only the lanes that owned accepted findings&lt;br&gt;plus any the fixes newly made applicable &#8212; &lt;b&gt;as full triples&lt;/b&gt;,&lt;br&gt;&lt;b&gt;not single passes&lt;/b&gt;: a lane worth rerunning is worth rerunning properly&lt;br&gt;&lt;b&gt;Technical still always reruns after a behaviour-changing fix&lt;/b&gt; &#8212; a fix&lt;br&gt;can break something no lane raised, and the pair does not make that&lt;br&gt;less likely&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2218" width="420" height="185" as="geometry" /></mxCell>
        <mxCell id="p8" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8 &#8212; Verification&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; reviewer-verify, opus&lt;br&gt;&lt;b&gt;Adversarial review does not replace it.&lt;/b&gt; The pair checks&lt;br&gt;the code; verification checks that the accumulated fixes&lt;br&gt;still do what was asked.&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2463" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="p8b" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8b &#8212; Walkthrough&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; as dev-loop, in full&lt;br&gt;author from notes.md, review with pr-walkthrough-review,&lt;br&gt;then retake the snapshot as the Phase 9 baseline&lt;br&gt;&lt;b&gt;One addition: the per-lane raised_p / raised_d / kept counts&lt;/b&gt;&lt;br&gt;go into the notes' Reviewers section&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2623" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p9" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 9 &#8212; Commit, push, pull request&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; as dev-loop, in full&lt;br&gt;&lt;b&gt;including the staging and commit-verification steps&lt;/b&gt;&lt;br&gt;stage untracked files explicitly, confirm the committed diff&lt;br&gt;matches the reviewed file list &lt;b&gt;and the tree digest&lt;/b&gt;, push,&lt;br&gt;and confirm the PR's file list matches&lt;br&gt;&lt;b&gt;Three agents per lane approved a working tree.&lt;/b&gt;&lt;br&gt;&lt;b&gt;None of them approved a commit.&lt;/b&gt;&lt;br&gt;index line: loop:&quot;ultra&quot;, plus raised_p / raised_d / kept per lane;&lt;br&gt;the PR description states that this was an adversarial run&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2798" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="done" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3218" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="triple" value="One lane, three agents &#8212; repeated for every applicable lane" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1023" width="1500" height="330" as="geometry" /></mxCell>
        <mxCell id="tiers" value="Model per lane &#8212; passed on every invocation, never left to the agent file's default" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1413" width="1500" height="205" as="geometry" /></mxCell>
        <mxCell id="health" value="Reading the ratio &#8212; the health signal this loop exists to produce" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="3028" width="1500" height="130" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-ultra &#8212; the adversarial loop" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="The same nine lanes as dev-loop, but each is reviewed twice on opposed assumptions and reconciled by a third agent. Roughly 3&#215; the review cost. Implementation is unchanged &#8212; ultra buys scrutiny, not code." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="tp" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;reviewer-ultra-prosecution&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;assumes the code is broken&lt;/b&gt; and something is&lt;br&gt;there to find &#8212; optimised for &lt;b&gt;recall&lt;/b&gt;&lt;br&gt;writes &amp;lt;lane&amp;gt;.prosecution.json + .log.md&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="triple"><mxGeometry x="40" y="50" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="tdf" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;reviewer-ultra-defence&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;assumes the code is correct&lt;/b&gt;, raising only what&lt;br&gt;it can demonstrate &#8212; optimised for &lt;b&gt;precision&lt;/b&gt;&lt;br&gt;writes &amp;lt;lane&amp;gt;.defence.json + .log.md&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="triple"><mxGeometry x="40" y="170" width="400" height="100" as="geometry" /></mxCell>
        <mxCell id="tblind" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;The pair runs in parallel and blind to each other.&lt;/b&gt; Neither output is ever used directly &#8212; not by the other reviewer, and not by the lead.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;align=center;spacingLeft=0;" vertex="1" parent="triple"><mxGeometry x="40" y="282" width="620" height="34" as="geometry" /></mxCell>
        <mxCell id="tadj" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;reviewer-ultra-adjudicator&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;runs once both have returned. Reads both findings files,&lt;br&gt;both logs, and &lt;b&gt;the code itself&lt;/b&gt;, and produces the lane's&lt;br&gt;single authoritative set: &amp;lt;lane&amp;gt;.json + &amp;lt;lane&amp;gt;.adjudication.log.md&lt;br&gt;&#8212; including the &lt;b&gt;coverage&lt;/b&gt; line&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="triple"><mxGeometry x="670" y="110" width="440" height="100" as="geometry" /></mxCell>
        <mxCell id="tread" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;What the lead reads:&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;only &amp;lt;lane&amp;gt;.json&lt;/b&gt;&lt;br&gt;and the coverage line.&lt;br&gt;Never prosecution or&lt;br&gt;defence &#8212; they are inputs&lt;br&gt;to adjudication, not to you.&lt;br&gt;Reading them puts back&lt;br&gt;exactly the noise the&lt;br&gt;adjudicator was paid&lt;br&gt;to remove.&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="triple"><mxGeometry x="1140" y="50" width="330" height="220" as="geometry" /></mxCell>
        <mxCell id="ti0" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;requirements&lt;br&gt;opus&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="tiers"><mxGeometry x="20" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti1" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;technical&lt;br&gt;opus&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="tiers"><mxGeometry x="312" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti2" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;architecture&lt;br&gt;opus&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="tiers"><mxGeometry x="604" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti3" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;security&lt;br&gt;opus&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#f7dadd;" vertex="1" parent="tiers"><mxGeometry x="896" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti4" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;standards&lt;br&gt;sonnet&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="1188" y="44" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti5" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;tests&lt;br&gt;sonnet&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="20" y="96" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti6" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;deadcode&lt;br&gt;sonnet&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="312" y="96" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti7" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;minimalism&lt;br&gt;sonnet&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="604" y="96" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="ti8" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;artifacts&lt;br&gt;sonnet&lt;/div&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fillColor=#e7eef5;" vertex="1" parent="tiers"><mxGeometry x="896" y="96" width="276" height="44" as="geometry" /></mxCell>
        <mxCell id="tiersN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;All three agents in a lane use the same tier, and the tier is the one dev-loop gives that lane.&lt;/b&gt; If you cannot pass model per invocation &#8212; the tool is unavailable, the parameter is rejected &#8212; &lt;b&gt;stop and say so&lt;/b&gt;: a technical lane silently reviewed at Sonnet is not the loop the user asked for.&lt;br&gt;&lt;b&gt;Effort is NOT passable.&lt;/b&gt; The Agent tool has a model parameter and no effort parameter, so effort is whatever the agent file declares &#8212; &lt;b&gt;high&lt;/b&gt; for all three ultra reviewers. The four Opus lanes therefore run at Opus &lt;b&gt;high&lt;/b&gt;, not xhigh. Say that in run.md rather than reporting a tier the run did not have. Never edit the agent files mid-run to work around it.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;" vertex="1" parent="tiers"><mxGeometry x="20" y="148" width="1460" height="48" as="geometry" /></mxCell>
        <mxCell id="hs0" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Prosecution raises many, few survive&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="health"><mxGeometry x="20" y="44" width="476" height="34" as="geometry" /></mxCell>
        <mxCell id="hm0" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;it is running hot &#8212; or defence's dismissals are being accepted too readily&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;dashed=0;fillColor=#ffffff;" vertex="1" parent="health"><mxGeometry x="20" y="78" width="476" height="42" as="geometry" /></mxCell>
        <mxCell id="hs1" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Defence raises almost nothing, across several runs&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="health"><mxGeometry x="512" y="44" width="476" height="34" as="geometry" /></mxCell>
        <mxCell id="hm1" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;&lt;b&gt;it has drifted into agreeableness.&lt;/b&gt; The pair's most common failure and the hardest to see, because it looks like clean code&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;dashed=0;fillColor=#ffffff;" vertex="1" parent="health"><mxGeometry x="512" y="78" width="476" height="42" as="geometry" /></mxCell>
        <mxCell id="hs2" value="&lt;div style=&quot;font-size:12px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;Both agree on nearly everything&lt;/b&gt;&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="health"><mxGeometry x="1004" y="44" width="476" height="34" as="geometry" /></mxCell>
        <mxCell id="hm2" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;the stances are not actually opposed, and you are paying three times for one reviewer's opinion&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontSize=10;dashed=0;fillColor=#ffffff;" vertex="1" parent="health"><mxGeometry x="1004" y="78" width="476" height="42" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;exitX=1;exitY=0.5;entryX=0;entryY=0.35;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tp" target="tadj"><mxGeometry relative="1" as="geometry" /></mxCell>
