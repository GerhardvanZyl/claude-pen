<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dev-loop-ultralight">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="/dev-loop-ultralight" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="elig" value="&lt;b&gt;Eligibility &#8212; checked before anything else&lt;/b&gt;&#xa;ALL of these must hold:&#xa;&#8226; one project, roughly five files or fewer&#xa;&#8226; no authn/authz, secrets, or untrusted input&#xa;&#8226; no migration, schema, generated artifact or public contract&#xa;&#8226; no concurrency, async ordering or transaction boundary&#xa;&#8226; no new dependency&#xa;&#8226; easy to roll back" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="eligL" value="&lt;b&gt;any ONE fails&lt;/b&gt;&#xa;&#8594; dev-loop-lite" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="313" width="420" height="70" as="geometry" /></mxCell>
        <mxCell id="eligR" value="&lt;b&gt;several fail, or you are unsure&lt;/b&gt;&#xa;&#8594; dev-loop (full)" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="313" width="420" height="70" as="geometry" /></mxCell>
        <mxCell id="eligN" value="The eligibility list is the &lt;b&gt;entire&lt;/b&gt; safety&#xa;mechanism of this loop. Nothing downstream will&#xa;catch a change that should not have been here." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="p0" value="&lt;b&gt;Phase 0 &#8212; Frame&lt;/b&gt;&#xa;one short paragraph: what changes, what must not,&#xa;which files, definition of done, &lt;b&gt;SOURCE BRANCH&lt;/b&gt;&#xa;create .claude/review/runs/&lt;run-id&gt;/ + brief.md&#xa;invoke implementation-notes &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="488" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1" value="&lt;b&gt;Phase 1 &#8212; Implement AND test&lt;/b&gt;&#xa;&lt;b&gt;ONE handoff, not two&lt;/b&gt; &#8212; unlike every other loop&#xa;sidekick by default; sidekick-lite only if mechanical&#xa;tests still required: each must fail if behaviour regresses&#xa;the brief asks the reasoning back &#8594; notes.md" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="663" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p1N" value="Reaching for &lt;b&gt;sidekick-heavy&lt;/b&gt; here is a&#xa;strong sign you are in the wrong loop." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="692" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="snap" value="&lt;b&gt;Snapshot the working tree&lt;/b&gt;&#xa;record in round-1/plan.md as  tree: &lt;sha&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="838" width="420" height="60" as="geometry" /></mxCell>
        <mxCell id="p2" value="&lt;b&gt;Phase 2 &#8212; Review&lt;/b&gt;&#xa;spawn &lt;b&gt;reviewer-ultralight&lt;/b&gt; ONCE &#8212; sonnet, effort high&#xa;read-only; writes round-1/ultralight.json + .log.md&#xa;returns one line: path, counts, items covered out of nine" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="958" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="p2N" value="&lt;b&gt;No scratch worktree.&lt;/b&gt;&#xa;No mutation testing in this loop &#8212;&#xa;a suite you must break to trust&#xa;belongs in a loop with a second round." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="968" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="chk" value="re-snapshot:&#xa;did the tree move?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="1118" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="chkL" value="&lt;b&gt;a reviewer wrote to the code it reviewed&lt;/b&gt;&#xa;restore the tree and rerun &#8212; the findings&#xa;describe a tree that no longer exists" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1133" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="p3" value="&lt;b&gt;Phase 3 &#8212; Triage &#8212; the lead is the arbiter&lt;/b&gt;&#xa;1 &#8212; evidence gate: inferred alone never blocks&#xa;2 &#8212; cause gate: introduced / worsened /&#xa;missing-required are fixed; stale is recorded&#xa;3 &#8212; defect &#8800; remedy: smallest fix, intent preserved&#xa;4 &#8212; wontfix.json &#8212; dies with the run&#xa;5 &#8212; conventions.md &#8212; survives to the next run&#xa;write round-1/triage.md, classifying every rejection&#xa;stale &#124; evidence &#124; remedy &#124; &lt;b&gt;wrong&lt;/b&gt;&#xa;&#8212; only &lt;b&gt;wrong&lt;/b&gt; counts against the reviewer" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1288" width="420" height="180" as="geometry" /></mxCell>
        <mxCell id="p3N" value="Requirements findings go to &lt;b&gt;notes.md whether&#xa;accepted or rejected&lt;/b&gt;. A rejected one says the brief&#xa;was ambiguous, or was read differently than the&#xa;implementer read it &#8212; which a reviewer needs told." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1338" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="esc" value="any escalation&#xa;trigger?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="550" y="1528" width="260" height="110" as="geometry" /></mxCell>
        <mxCell id="escL" value="&lt;b&gt;&#8594; dev-loop (full)&lt;/b&gt;&#xa;any Critical, or a Major in&#xa;security, architecture or concurrency" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1543" width="340" height="80" as="geometry" /></mxCell>
        <mxCell id="escR" value="&lt;b&gt;&#8594; dev-loop-lite&lt;/b&gt;&#xa;any other Major &#8226; more than four accepted findings&#xa;&#8226; the reviewer reports a concern it could not cover" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="1543" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="escN" value="&lt;b&gt;Escalation is mandatory and one-way.&lt;/b&gt;&#xa;Do not fix and carry on: a trivial change that&#xa;produced a Major was not trivial, and these&#xa;concerns had a ninth of the usual attention." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="1715" width="380" height="80" as="geometry" /></mxCell>
        <mxCell id="p4" value="&lt;b&gt;Phase 4 &#8212; Fix&lt;/b&gt;&#xa;one brief to sidekick &#8212; reviewers never edit&#xa;would_have_been_bug &#8594; write the failing test FIRST,&#xa;confirm it fails, apply the fix, confirm it passes&#xa;then run the relevant tests, lint and build" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1698" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p5" value="&lt;b&gt;Phase 5 &#8212; Exit&lt;/b&gt;&#xa;did the fixes clear it?" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="1873" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="p5L" value="&lt;b&gt;no, or the fix introduced something new&lt;/b&gt;&#xa;&#8594; dev-loop-lite. There is &lt;b&gt;no second round&lt;/b&gt;:&#xa;one reviewer looking twice at its own&#xa;missed work is not independent." style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="1888" width="340" height="90" as="geometry" /></mxCell>
        <mxCell id="p5R" value="&lt;b&gt;There is no verification phase.&lt;/b&gt;&#xa;Anything risky enough to warrant one&#xa;has already triggered escalation." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950" y="1898" width="360" height="70" as="geometry" /></mxCell>
        <mxCell id="p5b" value="&lt;b&gt;Phase 5b &#8212; Walkthrough&lt;/b&gt;&#xa;pr-walkthrough drafted by sidekick &lt;b&gt;from notes.md, not the diff&lt;/b&gt;&#xa;&lt;b&gt;the lead checks it inline&lt;/b&gt; &#8212; this loop alone spawns no&#xa;pr-walkthrough-review; a change this small does not justify one&#xa;retake the snapshot &#8212; it is the Phase 6 baseline" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2053" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p6" value="&lt;b&gt;Phase 6 &#8212; Commit, push, pull request&lt;/b&gt;&#xa;stage untracked files too &#8212; ?? is missed by a path-pattern add&#xa;verify BOTH: --stat against the sweep, and the tree digest&#xa;PR targets the Phase 0 source branch, never the repo default&#xa;description says plainly: &lt;b&gt;ultralight, one review pass&lt;/b&gt;&#xa;run.md + one line to index.jsonl with loop:&quot;ultralight&quot;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2228" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="done" value="done" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="2418" width="200" height="48" as="geometry" /></mxCell>
        <mxCell id="sweep" value="The sweep &#8212; every item, in order, every time" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="938" width="620" height="404" as="geometry" /></mxCell>
        <mxCell id="ttl" value="dev-loop-ultralight" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="One reviewer, one round, no verification phase &#8212; a nine-concern sweep in a single pass. Review cost ≈ 0.1&#215; a full run. Implementation is NOT downgraded." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sw0" value="1 &#8212; Requirements: does it do what the brief asked, and nothing more?" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="40" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw1" value="2 &#8212; Correctness: logic, inverted conditions, boundaries, second call" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="72" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw2" value="3 &#8212; Error paths: dependency throws, times out, returns partial" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="104" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw3" value="4 &#8212; &lt;b&gt;Separation of concerns &#8212; do not compress this one&lt;/b&gt;" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="136" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw4" value="5 &#8212; Placement: repo convention; inferred evidence can never block" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="168" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw5" value="6 &#8212; Standards: coding-standards skill + .claude/standards.md only" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="200" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw6" value="7 &#8212; Security: authz or untrusted input here = wrong loop, say so" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="232" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw7" value="8 &#8212; Tests: would they fail if the code were wrong?" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="264" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sw8" value="9 &#8212; Surplus: guards, wrappers, config nothing requires" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="296" width="596" height="28" as="geometry" /></mxCell>
        <mxCell id="sweepN" value="The log records a verdict for &lt;b&gt;all nine&lt;/b&gt;, including the ones it found&#xa;nothing on. That per-item list is the only evidence the sweep did not&#xa;stop at item 3 &#8212; which is what you buy with a checklist reviewer." style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;fontSize=10;" vertex="1" parent="sweep"><mxGeometry x="12" y="338" width="596" height="56" as="geometry" /></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="entry" target="elig"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="elig" target="p0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p1" target="snap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="snap" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p2" target="chk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="chk" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p3" target="esc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="esc" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5b" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p6" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="elig" target="eligL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="elig" target="eligR"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="chk" target="chkL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="esc" target="escL"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="esc" target="escR"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5" target="p5L"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#4a3600;labelBackgroundColor=#ffffff;strokeColor=#4a7095;" edge="1" parent="1" source="p5" target="p5b"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
