<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="dev-loop-unity-lite">
    <mxGraphModel dx="1400" dy="900" grid="0" page="1" pageWidth="1700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="entry" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;/dev-loop-unity-lite&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#0f3355;strokeColor=#0f3355;fontColor=#ffffff;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="420" height="48" as="geometry" /></mxCell>

        <mxCell id="wrong" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Is this the wrong loop?&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Not single-player &#8212; networking, multiplayer, online&lt;br&gt;services, accounts, purchases, analytics/personal data,&lt;br&gt;downloaded or user-generated content, mod loading, or&lt;br&gt;credentials &#8594; the general ladder&lt;br&gt;Not contained &#8212; new scenes or a look from references, a&lt;br&gt;settings/pipeline/package/asmdef change, a save-format&lt;br&gt;change, or a new shared primitive &#8594; dev-loop-unity&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="268" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="wrongL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;&#8594; dev-loop-unity&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Escalate before starting if it isn't contained after all&lt;br&gt;&#8212; needs art direction, a settings/pipeline/package/asmdef&lt;br&gt;change, a save-format change, or a new shared primitive.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="288" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="wrongR" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;&#8594; the general ladder&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Escalate if this isn't single-player, now or mid-run &#8212;&lt;br&gt;briefed with unity-editor.md regardless of which loop&lt;br&gt;ends up running it.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="288" width="420" height="110" as="geometry" /></mxCell>

        <mxCell id="p0" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 0 &#8212; Frame&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;read unity-editor.md &#8226; verify the editor instance against&lt;br&gt;Application.dataPath &#8226; DoD for visual scope lists named&lt;br&gt;shots &#8212; scene, camera, time of day &#8212; and what each must&lt;br&gt;show &#8226; invoke implementation-notes &#8594; notes.md&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="478" width="420" height="120" as="geometry" /></mxCell>

        <mxCell id="sysNode" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Systems&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;line-height:1.4;text-align:left&quot;&gt;sidekick, normal ladder&lt;br&gt;C# runtime/editor/&lt;br&gt;test code&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="653" width="204" height="120" as="geometry" /></mxCell>
        <mxCell id="visNode" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Visual build&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:9px;line-height:1.4;text-align:left&quot;&gt;sidekick-visual, fable&lt;br&gt;&#8804;2 self-QA rounds&lt;br&gt;no Phase 0a/0b here&lt;/div&gt;" style="rounded=1;fillColor=rgba(235,108,54,0.12);strokeColor=#eb6c36;fontColor=#5a2d10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="653" width="200" height="120" as="geometry" /></mxCell>

        <mxCell id="p2" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 2 &#8212; Tests&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Unity Test Framework &#8212; EditMode for logic and&lt;br&gt;primitives, PlayMode for frames, physics, loaded scenes&lt;br&gt;visual outcomes accepted by capture, not unit-tested&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="828" width="420" height="100" as="geometry" /></mxCell>

        <mxCell id="p3" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 3 &#8212; Plan &amp;amp; snapshot&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;sidekick-lite runs the capture harness for the brief's&lt;br&gt;shots into round-N/captures/ &#8212; before the snapshot,&lt;br&gt;same before/after tree digest check as every harness run&lt;br&gt;then dev-loop's tree snapshot + scratch worktree, exactly&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="988" width="420" height="160" as="geometry" /></mxCell>
        <mxCell id="sn1" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;The working-tree snapshot, the integrity check, and the&lt;br&gt;scratch worktree the Tests lane needs are shared with&lt;br&gt;the general loop &#8212; follow dev-loop's tree-snapshot.md&lt;br&gt;exactly, not a lite-specific shortcut.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="1008" width="420" height="110" as="geometry" /></mxCell>

        <mxCell id="p4" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 4 &#8212; Delegate&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;one batch, as dev-loop-lite &#8212; four lanes fit one wave,&lt;br&gt;no waves needed&lt;br&gt;Visual lane gets: captures directory, matching references,&lt;br&gt;the bible if one exists, and the brief's shot list&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1208" width="420" height="140" as="geometry" /></mxCell>

        <mxCell id="lanes" value="Four consolidated lanes, one wave &#8212; the Visual lane is a Fable exception, same as the full loop" style="swimlane;startSize=34;fillColor=#ffffff;strokeColor=#4a7095;fontColor=#12263f;fontStyle=1;html=1;whiteSpace=wrap;container=1;pointerEvents=0;collapsible=0;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1408" width="1500" height="270" as="geometry" /></mxCell>

        <mxCell id="lh0" value="Visual &#8212; fable &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="lanes"><mxGeometry x="14" y="42" width="356" height="26" as="geometry" /></mxCell>
        <mxCell id="lg0" value="renders changed, or the brief names shots" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="14" y="70" width="356" height="22" as="geometry" /></mxCell>
        <mxCell id="lb0" value="&lt;div style=&quot;font-size:9px;line-height:1.4;text-align:left&quot;&gt;scenes, prefabs, materials, shaders, lighting,&lt;br&gt;post-processing, cameras, animation, UI, VFX.&lt;br&gt;Later rounds: rerun if it owned an accepted&lt;br&gt;finding, or for the visual confirmation.&lt;/div&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#b8b8b8;fontColor=#2d3142;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="14" y="94" width="356" height="90" as="geometry" /></mxCell>

        <mxCell id="lh1" value="Correctness &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="lanes"><mxGeometry x="386" y="42" width="356" height="26" as="geometry" /></mxCell>
        <mxCell id="lg1" value="always" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="386" y="70" width="356" height="22" as="geometry" /></mxCell>
        <mxCell id="lb1" value="&lt;div style=&quot;font-size:9px;line-height:1.4;text-align:left&quot;&gt;merges Requirements, Technical and Artifacts &#8212;&lt;br&gt;brief conformance (named-shot DoD), logic/&lt;br&gt;state/lifecycle defects, and settings/packages/&lt;br&gt;.meta/scene YAML, one pass&lt;/div&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#b8b8b8;fontColor=#2d3142;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="386" y="94" width="356" height="90" as="geometry" /></mxCell>

        <mxCell id="lh2" value="Tests &#8212; haiku &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="lanes"><mxGeometry x="758" y="42" width="356" height="26" as="geometry" /></mxCell>
        <mxCell id="lg2" value="C# changed &#8212; runtime, editor, or test code" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="758" y="70" width="356" height="22" as="geometry" /></mxCell>
        <mxCell id="lb2" value="&lt;div style=&quot;font-size:9px;line-height:1.4;text-align:left&quot;&gt;would the tests fail if the code were wrong?&lt;br&gt;EditMode/PlayMode fit, assertion quality,&lt;br&gt;missing negatives &#8212; never write to tracked&lt;br&gt;scenes, prefabs or other tracked assets&lt;/div&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#b8b8b8;fontColor=#2d3142;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="758" y="94" width="356" height="90" as="geometry" /></mxCell>

        <mxCell id="lh3" value="Structure &#8212; sonnet &#183; high" style="rounded=1;fillColor=#e7eef5;strokeColor=#4a7095;fontColor=#12263f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;fontStyle=1;" vertex="1" parent="lanes"><mxGeometry x="1130" y="42" width="356" height="26" as="geometry" /></mxCell>
        <mxCell id="lg3" value="round 1 only" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="1130" y="70" width="356" height="22" as="geometry" /></mxCell>
        <mxCell id="lb3" value="&lt;div style=&quot;font-size:9px;line-height:1.4;text-align:left&quot;&gt;separation of concerns first, then architecture,&lt;br&gt;coding-standards, dead code, god objects in&lt;br&gt;editor tooling. Skipped for a recorded&lt;br&gt;throwaway tooling path (capture, concept art).&lt;/div&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#b8b8b8;fontColor=#2d3142;dashed=1;align=left;spacingLeft=6;whiteSpace=wrap;html=1;fontSize=9;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="1130" y="94" width="356" height="90" as="geometry" /></mxCell>

        <mxCell id="lanesN" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Each lane reads &lt;b&gt;only its own card&lt;/b&gt; in review-lanes-unity.md and stays silent on anything another lane owns. Reviewers are read-only &#8212; they never call Edit and never fix.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="lanes"><mxGeometry x="14" y="196" width="1470" height="48" as="geometry" /></mxCell>

        <mxCell id="integ" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;all four drained &#8212; retake the&lt;br&gt;snapshot: did the tree move?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="1738" width="340" height="130" as="geometry" /></mxCell>
        <mxCell id="integL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;a reviewer wrote to the tree under review&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;stop, restore, rerun that lane &#8212; the same rule as every&lt;br&gt;other loop, not relaxed for four lanes instead of nine.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1738" width="420" height="130" as="geometry" /></mxCell>

        <mxCell id="p5" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 5 &#8212; Triage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Visual finding: file = capture path, line = 0, pixel&lt;br&gt;region stated in finding &#8226; recurring-concern rule applies&lt;br&gt;no separate Requirements lane &#8212; reviewer-lite-correctness&lt;br&gt;owns brief conformance; its findings &#8594; notes.md either way&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1928" width="420" height="170" as="geometry" /></mxCell>
        <mxCell id="sn2" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;Correctness owns conformance to the brief here &#8212; its&lt;br&gt;brief-related findings go to notes.md whether accepted&lt;br&gt;or rejected, exactly as dev-loop-lite.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="1948" width="420" height="150" as="geometry" /></mxCell>

        <mxCell id="esc" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;any Critical in round 1, or&lt;br&gt;needs art direction / settings /&lt;br&gt;a new shared primitive?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="2158" width="340" height="110" as="geometry" /></mxCell>
        <mxCell id="escL" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;&#8594; dev-loop-unity, one-way&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;These four lanes cover the same concerns as the full&lt;br&gt;loop's six, at less depth and a lower tier. Do not fix it&lt;br&gt;here and carry on &#8212; restart under dev-loop-unity.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2158" width="420" height="110" as="geometry" /></mxCell>

        <mxCell id="p6" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 6 &#8212; Fix&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;code &#8594; sidekick / sidekick-heavy, test-before-fix&lt;br&gt;visual &#8594; sidekick-visual, recaptures and confirms by&lt;br&gt;eye before returning&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2328" width="420" height="140" as="geometry" /></mxCell>

        <mxCell id="p7" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 7 &#8212; loop or exit&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;ROUND &#8804; 2 &#8212; remove the scratch&lt;br&gt;worktree, retake the snapshot&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="490" y="2528" width="380" height="150" as="geometry" /></mxCell>
        <mxCell id="p7L" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;BLOCKED &#8212; stop and report&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;the same concern raised and fixed twice, or a round&lt;br&gt;with no material progress &#8212; per dev-loop-lite's&lt;br&gt;termination rules. A lite change that cannot converge&lt;br&gt;in two rounds is not a lite change.&lt;/div&gt;" style="rounded=1;fillColor=#f7dadd;strokeColor=#9e2b34;fontColor=#5a1a1f;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2528" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="p7R" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;ROUND + 1 &#8594; back to Phase 3&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;rerun only the lanes that owned accepted findings&lt;/div&gt;" style="rounded=1;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="2563" width="400" height="80" as="geometry" /></mxCell>

        <mxCell id="vc" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Visual confirmation&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;after round 2's fixes, only if an accepted finding was&lt;br&gt;visual &#8212; recapture affected shots, rerun only the Visual&lt;br&gt;lane, ask only whether each fix now shows as fixed&lt;/div&gt;" style="rounded=1;dashed=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="2748" width="420" height="110" as="geometry" /></mxCell>
        <mxCell id="sn3" value="&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;It raises nothing new; a failure there is reported, not&lt;br&gt;looped back into another round.&lt;/div&gt;" style="rounded=0;fillColor=#fafafa;strokeColor=#b8b8b8;fontColor=#4a4a4a;dashed=1;align=left;spacingLeft=10;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="2748" width="420" height="110" as="geometry" /></mxCell>

        <mxCell id="p8" value="&lt;div style=&quot;font-size:13px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8 &#8212; Verify&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:center&quot;&gt;a Critical fixed, or a Major&lt;br&gt;with would_have_been_bug?&lt;/div&gt;" style="rhombus;fillColor=#fbf0d5;strokeColor=#b07a00;fontColor=#4a3600;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="2918" width="400" height="150" as="geometry" /></mxCell>
        <mxCell id="v" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;reviewer-verify&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt; &#8212; opus, high &#8212; narrower trigger than the full loop:&lt;br&gt;no Artifacts lane here, and a visual acceptance either&lt;br&gt;confirms clean or escalates on its own&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="2928" width="420" height="130" as="geometry" /></mxCell>

        <mxCell id="p8b" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 8b &#8212; Walkthrough&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;sidekick drafts from notes.md, a second sidekick applies&lt;br&gt;pr-walkthrough-review, then retake the snapshot &#8212; this&lt;br&gt;is the Phase 9 baseline&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3128" width="420" height="130" as="geometry" /></mxCell>

        <mxCell id="p9" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center;margin-bottom:5px&quot;&gt;&lt;b&gt;Phase 9 &#8212; Commit, push, pull request&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:10px;line-height:1.45;text-align:left&quot;&gt;editor idle, scenes saved, .meta staged for every new&lt;br&gt;asset &#8226; never stage Library/, Temp/, Logs/, UserSettings/&lt;br&gt;commit .claude/unity/* if present &#8226; captures stay in the&lt;br&gt;run directory unless the project already commits them&lt;br&gt;run.md + index.jsonl, loop:&quot;unity-lite&quot;&lt;/div&gt;" style="rounded=1;fillColor=#1f4e79;strokeColor=#0f3355;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="3318" width="420" height="200" as="geometry" /></mxCell>

        <mxCell id="done" value="&lt;div style=&quot;font-size:15px;line-height:1.3;text-align:center&quot;&gt;&lt;b&gt;done&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=50;fillColor=#dcefe3;strokeColor=#2e6f4e;fontColor=#123328;fontStyle=1;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="3578" width="200" height="48" as="geometry" /></mxCell>

        <mxCell id="ttl" value="dev-loop-unity-lite" style="text;html=1;fillColor=none;strokeColor=none;fontSize=26;fontStyle=1;fontColor=#0f3355;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="sub" value="Four consolidated lanes plus a Fable Visual lane, two rounds, verification narrower than the full loop. Escalates to dev-loop-unity on a round-1 Critical or a scope break, to the general ladder if eligibility breaks." style="text;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#4a7095;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="1500" height="40" as="geometry" /></mxCell>

